config SPL_PINCTRL_STARFIVE_JH7110
	bool "Support Pinctrl and GPIO driver for StarFive JH7110 SoC in SPL"
	depends on  SPL_PINCTRL_FULL && STARFIVE_JH7110
	help
	  Enable support pinctrl and gpio driver for StarFive JH7110 in SPL.
	  Say yes here to support pin control on the StarFive RISC-V SoC.
	  This also provides an interface to the GPIO pins not used by other
	  peripherals supporting inputs, outputs, configuring pull-up/pull-down
	  and interrupts on input changes.

config PINCTRL_STARFIVE_JH7110
	bool "Pinctrl and GPIO driver for StarFive JH7110 SoC"
	depends on PINCTRL_FULL && STARFIVE_JH7110
	help
	  This selects the pinctrl driver for JH7110 starfive. Say yes here to
	  support pin control on the StarFive RISC-V SoC. This also provides an
	  interface to the GPIO pins not used by other peripherals supporting
	  inputs, outputs, configuring pull-up/pull-down and interrupts on
	  input changes.

config PINCTRL_STARFIVE_JHB100
	bool "Pinctrl and GPIO driver for StarFive JHB100 SoC"
	depends on PINCTRL_FULL && STARFIVE_JHB100
	help
	  This selects the pinctrl driver for JHB100 starfive.
