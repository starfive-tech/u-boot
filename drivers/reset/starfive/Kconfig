config RESET_STARFIVE
	bool "Reset driver for StarFive SoC"
	depends on DM_RESET
	help
	  Enable this if require support for reset driver for
	  StarFive SOC.

config RESET_STARFIVE_JHB100
	bool "Reset driver for StarFive JHB100 SoC"
	depends on  RESET_STARFIVE
	help
	  This selects the reset driver for StarFive JHB100 SOC.

config RESET_STARFIVE_JHB100_AUTO_DEASSERT
	bool "Auto-deassert all StarFive JHB100 reset lines at probe"
	depends on RESET_STARFIVE_JHB100
	default n
	help
	  Say yes here to have every reset line in a CRG domain
	  automatically deasserted as soon as that domain's reset
	  device probes, instead of waiting for a consumer driver to
	  request and deassert it explicitly.

	  This deasserts from dm_probe_devices(), which runs inside
	  dm_init_and_scan() while gd->timer is NULL and before
	  EVT_DM_POST_INIT_R binds riscv_timer. Deassert confirms via
	  readl_poll_timeout(), so TIMER_EARLY is required to keep
	  get_ticks() from panicking there.
