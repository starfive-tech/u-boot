&sfc0 {
	status = "okay";
	clocks = <&fpga_12mhz_clk>;
	pinctrl-names = "default";
	pinctrl-0 = <&sfc0_pins>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <200000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "Boot Info";
				reg = <0x0 0x10000>;
			};

			partition@1 {
				label = "L0 firmware (Primary)";
				reg = <0x10000 0x80000>;
			};

			partition@2 {
				label = "L1 firmware (Primary)";
				reg = <0x90000 0x80000>;
			};

			partition@3 {
				label = "U-Boot SPL (Primary)";
				reg = <0x110000 0x80000>;
			};

			partition@4 {
				label = "U-Boot environment";
				reg = <0x190000 0x80000>;
			};

			partition@5 {
				label = "U-Boot (Primary)";
				reg = <0x210000 0x200000>;
			};

			partition@6 {
				label = "L0 firmware (Secondary)";
				reg = <0x410000 0x80000>;
			};

			partition@7 {
				label = "L1 firmware (Secondary)";
				reg = <0x490000 0x80000>;
			};

			partition@8 {
				label = "U-Boot SPL (Secondary)";
				reg = <0x510000 0x80000>;
			};

			partition@9 {
				label = "U-Boot (Secondary)";
				reg = <0x590000 0x200000>;
			};

			partition@10 {
				label = "Data";
				reg = <0x790000 0x870000>;
			};
		};
	};

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <200000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "Kernel (Primary)";
				reg = <0x0 0xd00000>;
			};

			partition@1 {
				label = "Kernel (Secondary)";
				reg = <0xd00000 0xd00000>;
			};

			partition@2 {
				label = "Data";
				reg = <0x1a00000 0x6600000>;
			};
		};
	};
};
