&sfc0 {
	status = "okay";
	clocks = <&fpga_12mhz_clk>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <200000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		pinctrl-names = "default";
		pinctrl-0 = <&sfc0_pins>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "Boot Info";
				reg = <0x0 0x10000>;
			};

			partition@1 {
				label = "L0 firmware (Primary)";
				reg = <0x10000 0x80000>;
			};

			partition@2 {
				label = "L1 firmware (Primary)";
				reg = <0x90000 0x80000>;
			};

			partition@3 {
				label = "U-Boot SPL (Primary)";
				reg = <0x110000 0x80000>;
			};

			partition@4 {
				label = "U-Boot environment";
				reg = <0x190000 0x80000>;
			};

			partition@5 {
				label = "U-Boot (Primary)";
				reg = <0x210000 0x200000>;
			};

			partition@6 {
				label = "L0 firmware (Secondary)";
				reg = <0x410000 0x80000>;
			};

			partition@7 {
				label = "L1 firmware (Secondary)";
				reg = <0x490000 0x80000>;
			};

			partition@8 {
				label = "U-Boot SPL (Secondary)";
				reg = <0x510000 0x80000>;
			};

			partition@9 {
				label = "U-Boot (Secondary)";
				reg = <0x590000 0x200000>;
			};

			partition@10 {
				label = "Data";
				reg = <0x790000 0x870000>;
			};
		};
	};

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <200000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "Kernel (Primary)";
				reg = <0x0 0xd00000>;
			};

			partition@1 {
				label = "Kernel (Secondary)";
				reg = <0xd00000 0xd00000>;
			};

			partition@2 {
				label = "Data";
				reg = <0x1a00000 0x6600000>;
			};
		};
	};
};

&pinctrl_bmcperiph1 {
	gpio-line-names =
		"", "", "", "",
		"", "SFC0_CS0", "SFC0_CS1", "SFC0_SCLK",
		"SFC0_IO0", "SFC0_IO1", "SFC0_IO2", "SFC0_IO3";

	sfc0_pins: sfc0-grp {
		sfc0_sclk-pins {
			pinmux = <PINMUX(7, 0)>;
		};

		sfc0_cs0-pins {
			pinmux = <PINMUX(5, 0)>;
			bias-pull-up;
		};

		sfc0_cs1-pins {
			pinmux = <PINMUX(6, 0)>;
			bias-pull-up;
		};

		sfc0_io0-pins {
			pinmux = <PINMUX(8, 0)>;
			input-enable;
		};

		sfc0_io1-pins {
			pinmux = <PINMUX(9, 0)>;
			input-enable;
		};

		sfc0_io2-pins {
			pinmux = <PINMUX(10, 0)>;
			input-enable;
		};

		sfc0_io3-pins {
			pinmux = <PINMUX(11, 0)>;
			input-enable;
		};
	};
};
