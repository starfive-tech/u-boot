#include "jhb100.dtsi"
#include "jhb100-fpga-sfc0-flash.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "StarFive JHB100 FPGA";
	compatible = "starfive,jhb100-fpga", "starfive,jhb100";

	aliases {
		serial0 = &uart5;
		ethernet0 = &gmac2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	cpus {
		timebase-frequency = <4000000>;
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x40000000 0x2 0x0>;	/* 8GB */
	};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		/* DMA global pool cached address */
		dma-reserved@44000000 {
			reg = <0x0 0x44000000 0x0 0x20000000>;
			no-map;
		};

		/* DMA global pool uncached address (alias) */
		linux,dma@404000000 {
			compatible = "shared-dma-pool";
			reg = <0x4 0x04000000 0x0 0x20000000>;
			no-map;
			linux,dma-default;
		};

		/*
		 * eSPI & MMBI dma accesses uncached address.
		 * Also need to reserve corresponding cache addresses,
		 * so that kernel will not manage them.
		 */
		pcie0_mmbi_buffer_cache: mmbi_buffer@64000000 {
			reg = <0x0 0x64000000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		pcie0_mmbi_buffer_uncache: mmbi_buffer@424000000 {
			reg = <0x4 0x24000000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		espi0_mmbi_buffer_cache: mmbi_buffer@64800000 {
			reg = <0x0 0x64800000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		espi0_mmbi_buffer_uncache: mmbi_buffer@424800000 {
			reg = <0x4 0x24800000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		espi0_mem_cache: espi0-slave@65000000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x65000000 0x0 0x200000>;
			no-map;
		};

		espi0_mem_uncache: espi0-slave@425000000 {
			compatible = "shared-dma-pool";
			reg = <0x4 0x25000000 0x0 0x200000>;
			no-map;
		};

		ramoops@65200000 {
			compatible = "ramoops";
			reg = <0x0 0x65200000 0x0 0xc0000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			pmsg-size = <0x20000>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x10000000>;
			alignment = <0x0 0x1000>;
			alloc-ranges = <0x0 0x66000000 0x1 0xda000000>;
			linux,cma-default;
		};
	};

	soc {
		fpga_12mhz_clk: fpga_12mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12000000>;
		};

		fpga_3mhz_clk: fpga_3mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <3000000>;
		};

		fpga_4mhz_clk: fpga_4mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <4000000>;
		};

		fpga_2p5mhz_clk: fpga_2p5mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <2500000>;
		};
	};
};

&pinctrl_sys0h {

	gpio-line-names =
		"", "", "", "",
		"ESPI_IO0", "ESPI_IO1", "ESPI_IO2", "ESPI_IO3",
		"ESPI_CLK", "ESPI_CS", "ESPI_ALERT", "ESPI_RESET";

	espi0_pins: espi0-grp {
		espi0-rst-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A11,
					 FUNC_SYSTOP_SYS0H_ESPI0_RESET)>;
			input-enable;
		};

		espi0-alt-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A10,
					 FUNC_SYSTOP_SYS0H_ESPI0_ALERT)>;
		};

		espi0-cs-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A9,
					 FUNC_SYSTOP_SYS0H_ESPI0_CS)>;
			bias-pull-up;
			input-enable;
		};

		espi0-clk-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A8,
					 FUNC_SYSTOP_SYS0H_ESPI0_CLK)>;
			bias-pull-down;
			input-enable;
		};

		espi0-io0-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A4,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA0)>;
			bias-pull-up;
			input-enable;
		};

		espi0-io1-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A5,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA1)>;
			bias-pull-up;
			input-enable;

		};

		espi0-io2-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A6,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA2)>;
			bias-pull-up;
			input-enable;
		};

		espi0-io3-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A7,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA3)>;
			bias-pull-up;
			input-enable;
		};
	};
};

&pinctrl_sys2 {
	gpio-line-names =
		"", "", "", "",
		"", "", "", "",
		"", "", "", "",
		"UART5_TX", "UART5_RX", "", "";

	uart5_pins: uart5-grp {
		uart5_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A36,
					 FUNC_SYSTOP_SYS2_UART5_TX)>;
		};

		uart5_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A37,
					 FUNC_SYSTOP_SYS2_UART5_RX)>;
			bias-pull-up;
			input-enable;
		};
	};
};

&pinctrl_bmcperiph0 {
	gpio-line-names =
		"", "", "", "",
		"", "", "", "",
		"I3C4_SCL", "I3C4_SDA", "I3C5_SCL", "I3C5_SDA",
		"I2C6_SCL", "I2C6_SDA", "I2C7_SCL", "I2C7_SDA",
		"", "", "", "",
		"", "", "", "",
		"MDIO0_MDC", "MDIO0_MDIO", "", "";

	i3c4_pins: i3c4-grp {
		i3c4_scl-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B8,
					 FUNC_BMCPERIPH0_MIPI_I3C4_SCL1)>;
		};

		i3c4_sda-pins{
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B9,
					 FUNC_BMCPERIPH0_MIPI_I3C4_SDA1)>;
			bias-pull-up;
			input-enable;
		};
	};

	i3c5_pins: i3c5-grp {
		i3c5_scl-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B10,
					 FUNC_BMCPERIPH0_MIPI_I3C5_SCL1)>;
		};

		i3c5_sda-pins{
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B11,
					 FUNC_BMCPERIPH0_MIPI_I3C5_SDA1)>;
			bias-pull-up;
			input-enable;
		};
	};

	i2c6_pins: i2c6-grp {
		i2c6_scl-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B12,
					 FUNC_BMCPERIPH0_I2C6_CLK)>;
		};

		i2c6_sda-pins{
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B13,
					 FUNC_BMCPERIPH0_I2C6_DATA)>;
			bias-pull-up;
			input-enable;
		};
	};

	i2c7_pins: i2c7-grp {
		i2c7_scl-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B14,
					 FUNC_BMCPERIPH0_I2C7_CLK)>;
		};

		i2c7_sda-pins{
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B15,
					 FUNC_BMCPERIPH0_I2C7_DATA)>;
			bias-pull-up;
			input-enable;
		};
	};

	mdio0_pins: mdio0-grp {
		mdio0_mdc-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B24,
					 FUNC_BMCPERIPH0_ETH2_MDC)>;
		};

		mdio0_mdio-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B25,
					 FUNC_BMCPERIPH0_ETH2_MDIO)>;
			bias-pull-up;
			input-enable;
		};
	};
};

&pinctrl_bmcperiph1 {
	gpio-line-names =
		"SPI0_CS0", "SPI0_CS1", "SPI0_SCLK", "SPI0_TX",
		"SPI0_RX", "SFC0_CS0", "SFC0_CS1", "SFC0_SCLK",
		"SFC0_IO0", "SFC0_IO1", "SFC0_IO2", "SFC0_IO3";

	spi0_pins: spi0-grp {
		spi0_sclk-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C2,
					 FUNC_BMCPERIPH1_SPI0_SCLK_OUT)>;
		};

		spi0_cs0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C0,
					 FUNC_BMCPERIPH1_SPI0_N_SS_OUT_0)>;
			bias-pull-up;
		};

		spi0_cs1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C1,
					 FUNC_BMCPERIPH1_SPI0_N_SS_OUT_1)>;
			bias-pull-up;
		};

		spi0_tx-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C3,
					 FUNC_BMCPERIPH1_SPI0_TX)>;
			input-enable;
		};

		spi0_rx-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C4,
					 FUNC_BMCPERIPH1_SPI0_RX)>;
			input-enable;
		};
	};

	sfc0_pins: sfc0-grp {
		sfc0_sclk-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C7,
					 FUNC_BMCPERIPH1_SFC0_SCLK_OUT)>;
		};

		sfc0_cs0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C5,
					 FUNC_BMCPERIPH1_SFC0_N_SS_OUT_0)>;
			bias-pull-up;
		};

		sfc0_cs1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C6,
					 FUNC_BMCPERIPH1_SFC0_N_SS_OUT_1)>;
			bias-pull-up;
		};

		sfc0_io0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C8,
					 FUNC_BMCPERIPH1_SFC0_IO0)>;
			input-enable;
		};

		sfc0_io1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C9,
					 FUNC_BMCPERIPH1_SFC0_IO1)>;
			input-enable;
		};

		sfc0_io2-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C10,
					 FUNC_BMCPERIPH1_SFC0_IO2)>;
			input-enable;
		};

		sfc0_io3-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C11,
					 FUNC_BMCPERIPH1_SFC0_IO3)>;
			input-enable;
		};
	};
};

&pinctrl_bmcperiph2 {
	gpio-line-names =
		"", "", "", "",
		"", "", "", "",
		"", "", "", "",
		"", "", "", "",
		"", "", "GMAC2_PHY_RESET", "GMAC2_RXCLK",
		"GMAC2_RXDV", "GMAC2_RXD0", "GMAC2_RXD1", "GMAC2_RXD2",
		"GMAC2_RXD3", "GMAC2_TXCLK", "GMAC2_TXEN", "GMAC2_TXD0",
		"GMAC2_TXD1", "GMAC2_TXD2", "GMAC2_TXD3", "";

	gmac2_pins: gmac2-grp {
		gmac2_txen-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D26,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_TXEN)>;
			starfive,gmac_vsel = <0>;
		};

		gmac2_txclk-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D25,
					 FUNC_BMCPERIPH2_GMAC2_RGMII_TX_CLK)>;
			starfive,gmac_vsel = <0>;
		};

		gmac2_txd0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D27,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_TX0)>;
			starfive,gmac_vsel = <0>;
		};

		gmac2_txd1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D28,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_TX1)>;
			starfive,gmac_vsel = <0>;
		};

		gmac2_txd2-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D29,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_TX2)>;
			starfive,gmac_vsel = <0>;
		};

		gmac2_txd3-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D30,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_TX3)>;
			starfive,gmac_vsel = <0>;
		};

		gmac2_rxclk-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D19,
					 FUNC_BMCPERIPH2_GMAC2_RGMII_RX_CLK)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac2_rxdv-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D20,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_RXDV)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac2_rxd0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D21,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_RXD0)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac2_rxd1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D22,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_RXD1)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac2_rxd2-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D23,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_RXD2)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac2_rxd3-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_GPIO_D24,
					 FUNC_BMCPERIPH2_RMII_RGMII_PHY_RXD3)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};
	};

};

&uart5 {
	status = "okay";
	clocks = <&fpga_4mhz_clk>, <&fpga_4mhz_clk>;
	clock-frequency = <4000000>;
	current-speed = <115200>;
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_pins>;
};

&husb0 {
	snps,no-connect-phy;
};

&pcie0_mctp {
	status = "disabled";
};

&pcie1_mctp {
	status = "disabled";
};

&pcierp_mctp {
	status = "disabled";
};

&pcie0_mmbi {
	mmbi-instance-num = <8>;
	mmbi-osuse = /bits/ 8 <1 1 1 1 1 1 1 1>;
	memory-region = <&pcie0_mmbi_buffer_uncache>;
	mmbi-src-addr = /bits/ 64 <0x1f0000000>;
	status = "disabled";
};

&peci0 {
	status = "okay";
};

&peci1 {
	status = "okay";
};

&espi0_mmbi {
	mmbi-instance-num = <8>;
	mmbi-osuse = /bits/ 8 <0 0 0 0 0 0 0 0>;
	memory-region = <&espi0_mmbi_buffer_uncache>;
	mmbi-src-addr = /bits/ 64 <0x1f4000000>;
	status = "disabled";
};

&sio0 {
	status = "disabled";

	sio0_bt0: bt@0 {
		status = "okay";
	};

	sio0_kcs0: kcs@200 {
		status = "okay";
	};

	sio0_pcc: pcc@800 {
		starfive,pcc-threshold = <2>;
		status = "okay";
	};

	sio0_mbox: mbox@600 {
		status = "okay";
	};

	sio0_wdi: wdi@900 {
		status = "okay";
	};
};

&espi0 {
	flash-safs-mode = <0>;
	perif-memcyc-src-addr = /bits/ 64 <0x425000000>;
	perif-memcyc-size = <0x200000>;
	memory-region = <&espi0_mem_uncache>;

	starfive,misc-remap-num = <4>;
	starfive,bt-remap-num = <1>;

	starfive,mmbi-io-addr = /bits/ 32 <0x1000>;
	starfive,bt-io-addr = /bits/ 32 <0x200>;
	starfive,wdi-io-addr = /bits/ 32 <0xa00>;
	starfive,mbox-io-addr = /bits/ 32 <0x300>;
	starfive,misc-io-addr = /bits/ 32 <0x20 0x40
					   0x3f8 0xca0>;
	starfive,misc-sys-addr = /bits/ 32 <0x651ff020 0x651ff040
					    0x651ff3f8 0x651ffca0>;
	pinctrl-0 = <&espi0_pins>;
	/* GPIOB_4 for espi reset detection. */
	espi_rst_det-gpio = <&pinctrl_bmcperiph0 4 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&gmac2 {
	clocks = <&fpga_12mhz_clk>,
		 <&fpga_12mhz_clk>,
		 <&fpga_12mhz_clk>,
		 <&fpga_2p5mhz_clk>;
	snps,clk-csr = <5>;
	starfive,tx-use-rgmii-clk;
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy0>;
	status = "okay";
	pinctrl-names = "default", "default";
	pinctrl-0 = <&gmac2_pins>;
	pinctrl-1 = <&mdio0_pins>;

	mdio0 {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet_phy0: ethernet-phy@0 {
			reg = <0>;
			max-speed = <10>;
			device_type = "ethernet-phy";
			reset-gpios = <&pinctrl_bmcperiph2 18 GPIO_ACTIVE_LOW>;
			reset-assert-us = <15000>;
			reset-deassert-us = <15000>;
			marvell,reg-init =
				<0x0 0x4 0 0x0441>, /*Page 0, Reg 4 <- 0x0441*/
				<0x12 0x14 0 0x0>, /*Page 18, Reg 20 <- 0x0*/
				<0x0 0x0 0 0x1100>; /*Page 0, Reg 0 <- 0x1100*/
		};
	};
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&i2c6_master {
	status = "okay";
	clocks = <&fpga_12mhz_clk>, <&fpga_12mhz_clk>;
	clock-frequency = <100000>;
	clock-names = "ic_clk", "pclk";
};

&i3c4 {
	status = "disabled";
	clocks = <&fpga_12mhz_clk>;
	i3c-scl-hz = <1000000>;
	mode = "master";
	hotjoin;
	pinctrl-names = "default";
	pinctrl-0 = <&i3c4_pins>;
};

&i3c5 {
	status = "okay";
	clocks = <&fpga_12mhz_clk>;
	i3c-scl-hz = <1000000>;
	mode = "target";
	pid = <0x123 0x45543210>;
	/* static-address = /bits/ 8 <0x48>; */
	dcr = /bits/ 8 <0x0>;
	hotjoin-request;
	/* pec-private-transfer; */
	pinctrl-names = "default";
	pinctrl-0 = <&i3c5_pins>;
};

&reri0 {
	status = "okay";
};

&reri2 {
	status = "okay";
};

&reri3 {
	status = "okay";
};
