#include "jhb100.dtsi"
#include "jhb100-fpga-sfc0-flash.dtsi"
#include "jhb100-pinfunc.h"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "StarFive JHB100 FPGA";
	compatible = "starfive,jhb100-fpga", "starfive,jhb100";

	aliases {
		serial0 = &uart5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	cpus {
		timebase-frequency = <4000000>;
	};

	memory {
		device_type = "memory";
		reg = <0x4 0x0 0x2 0x0>;	/* 8GB */
	};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		/* DMA global pool cached address */
		dma-reserved@404000000 {
			reg = <0x4 0x04000000 0x0 0x20000000>;
			no-map;
		};

		/* DMA global pool uncached address (alias) */
		linux,dma@44000000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x44000000 0x0 0x20000000>;
			no-map;
			linux,dma-default;
		};

		/*
		 * eSPI & MMBI dma accesses uncached address.
		 * Also need to reserve corresponding cache addresses,
		 * so that kernel will not manage them.
		 */
		pcie0_mmbi_buffer_cache: mmbi_buffer@424000000 {
			reg = <0x4 0x24000000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		pcie0_mmbi_buffer_uncache: mmbi_buffer@64000000 {
			reg = <0x0 0x64000000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		espi0_mmbi_buffer_cache: mmbi_buffer@424800000 {
			reg = <0x4 0x24800000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		espi0_mmbi_buffer_uncache: mmbi_buffer@64800000 {
			reg = <0x0 0x64800000 0 0x800000>;
			alignment = <0x0 0x800000>;
			no-map;
		};

		espi0_mem_cache: espi0-slave@425000000 {
			compatible = "shared-dma-pool";
			reg = <0x4 0x25000000 0x0 0x200000>;
			no-map;
		};

		espi0_mem_uncache: espi0-slave@65000000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x65000000 0x0 0x200000>;
			no-map;
		};

		ramoops@425200000 {
			compatible = "ramoops";
			reg = <0x4 0x25200000 0x0 0xc0000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			pmsg-size = <0x20000>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x10000000>;
			alignment = <0x0 0x1000>;
			alloc-ranges = <0x4 0x26000000 0x2 0x00000000>;
			linux,cma-default;
		};
	};

	soc {
		fpga_12mhz_clk: fpga_12mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12000000>;
		};

		fpga_3mhz_clk: fpga_3mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <3000000>;
		};

		fpga_2p5mhz_clk: fpga_2p5mhz_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <2500000>;
		};
	};
};

&pinctrl_sys0 {

	gpio-line-names =
		"", "", "", "",
		"ESPI_CLK",	"ESPI_CS", "ESPI_IO0", "ESPI_IO1",
		"ESPI_IO2", "ESPI_IO3", "ESPI_RST", "ESPI_ALT";

	espi0_pins: espi0-grp {
		espi0-rst-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_RESET,
					 FUNC_SYSTOP_SYS0_ESPI0_RESET)>;
			input-enable;
		};

		espi0-alt-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_ALERT,
					 FUNC_SYSTOP_SYS0_ESPI0_ALERT)>;
		};

		espi0-cs-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_CS,
					 FUNC_SYSTOP_SYS0_ESPI0_CS)>;
			bias-pull-up;
			input-enable;
		};

		espi0-clk-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_CLK,
					 FUNC_SYSTOP_SYS0_ESPI0_CLK)>;
			bias-pull-down;
			input-enable;
		};

		espi0-io0-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_DATA0,
					 FUNC_SYSTOP_SYS0_ESPI0_DATA0)>;
			bias-pull-up;
		};

		espi0-io1-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_DATA1,
					 FUNC_SYSTOP_SYS0_ESPI0_DATA1)>;
			bias-pull-up;

		};

		espi0-io2-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_DATA2,
					 FUNC_SYSTOP_SYS0_ESPI0_DATA2)>;
			bias-pull-up;
		};

		espi0-io3-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_ESPI0_DATA3,
					 FUNC_SYSTOP_SYS0_ESPI0_DATA3)>;
			bias-pull-up;
		};
	};
};

&uart5 {
	status = "okay";
	clocks = <&fpga_3mhz_clk>, <&fpga_3mhz_clk>;
	clock-frequency = <3000000>;
	dlf-size = <6>;
	current-speed = <115200>;
};

&husb0 {
	snps,no-connect-phy;
};

&pcie0_mctp {
	status = "disabled";
};

&pcie1_mctp {
	status = "disabled";
};

&pcierp_mctp {
	status = "disabled";
};

&pcie0_mmbi {
	mmbi-instance-num = <8>;
	mmbi-osuse = /bits/ 8 <1 1 1 1 1 1 1 1>;
	memory-region = <&pcie0_mmbi_buffer_uncache>;
	mmbi-src-addr = /bits/ 64 <0x1f0000000>;
	status = "disabled";
};

&peci {
	status = "okay";
};

&espi0_mmbi {
	mmbi-instance-num = <8>;
	mmbi-osuse = /bits/ 8 <0 0 0 0 0 0 0 0>;
	memory-region = <&espi0_mmbi_buffer_uncache>;
	mmbi-src-addr = /bits/ 64 <0x1f4000000>;
	status = "okay";
};

&sio0 {
	status = "okay";

	sio0_bt0: bt@0 {
		status = "okay";
	};

	sio0_kcs0: kcs@200 {
		status = "okay";
	};

	sio0_pcc: pcc@800 {
		starfive,pcc-threshold = <2>;
		status = "okay";
	};

	sio0_mbox: mbox@600 {
		status = "okay";
	};

	sio0_wdi: wdi@900 {
		status = "okay";
	};
};

&espi0 {
	flash-safs-mode = <0>;
	perif-memcyc-src-addr = <0x65000000>;
	perif-memcyc-size = <0x200000>;
	memory-region = <&espi0_mem_uncache>;

	starfive,misc-remap-num = <4>;
	starfive,bt-remap-num = <1>;

	starfive,mmbi-io-addr = /bits/ 32 <0x1000>;
	starfive,bt-io-addr = /bits/ 32 <0x200>;
	starfive,wdi-io-addr = /bits/ 32 <0xa00>;
	starfive,mbox-io-addr = /bits/ 32 <0x300>;
	starfive,misc-io-addr = /bits/ 32 <0x20 0x40
					   0x3f8 0xca0>;
	starfive,misc-sys-addr = /bits/ 32 <0x651ff020 0x651ff040
					    0x651ff3f8 0x651ffca0>;
	pinctrl-0 = <&espi0_pins>;
	/* GPIOB_4 for espi reset detection. */
	espi_rst_det-gpio = <&pinctrl_bmcperiph0 4 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&gmac2 {
	clocks = <&fpga_12mhz_clk>,
		 <&fpga_12mhz_clk>,
		 <&fpga_12mhz_clk>,
		 <&fpga_2p5mhz_clk>;
	snps,clk-csr = <5>;
	starfive,tx-use-rgmii-clk;
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy0>;
	status = "okay";

	mdio0 {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet_phy0: ethernet-phy@0 {
			reg = <0>;
			max-speed = <10>;
			device_type = "ethernet-phy";
			marvell,reg-init =
				<0x0 0x4 0 0x0441>, /*Page 0, Reg 4 <- 0x0441*/
				<0x12 0x14 0 0x0>, /*Page 18, Reg 20 <- 0x0*/
				<0x0 0x0 0 0x1100>; /*Page 0, Reg 0 <- 0x1100*/
		};
	};
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&timer_test {
	status = "okay";
};

&i3c0 {
	status = "okay";
	clocks = <&fpga_12mhz_clk>;
	i3c-scl-hz = <1000000>;
	mode = "master";
	hotjoin;
};

&i3c1 {
	status = "okay";
	clocks = <&fpga_12mhz_clk>;
	i3c-scl-hz = <1000000>;
	mode = "target";
	pid = <0x123 0x45543210>;
	/* static-address = /bits/ 8 <0x48>; */
	dcr = /bits/ 8 <0x0>;
	hotjoin-request;
	/* pec-private-transfer; */
};
