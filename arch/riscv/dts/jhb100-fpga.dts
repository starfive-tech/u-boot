&sio0 {
	status = "okay";

	sio0_bt0: bt@0 {
		status = "okay";
	};

	sio0_kcs0: kcs@200 {
		status = "okay";
	};

	sio0_kcs1: kcs@300 {
		status = "okay";
	};

	sio0_pcc: pcc@800 {
		starfive,pcc-threshold = <0>;
		status = "okay";
	};

	sio0_mbox: mbox@600 {
		status = "okay";
	};

	sio0_wdi: wdi@900 {
		status = "okay";
	};
};

&espi0 {
	espi-wait-state = <15>;
	starfive,flash-mtd-device = "Data";
	starfive,host-src-addr = /bits/ 64 <0xf6810000>;
	perif-memcyc-size = <0x400000>;
	memory-region = <&espi0_mmbi_buffer_uncache>,
			<&espi0_perif_mem_uncache>,
			<&espi0_vw_mem_uncache>;

	starfive,bt-remap-num = <1>;
	starfive,kcs-remap-num = <1>;
	starfive,uart-remap-num = <1>;
	starfive,misc-remap-num = <1>;
	starfive,bt-io-addr = /bits/ 32 <0xe4>;
	starfive,kcs-io-addr = /bits/ 32 <0xca2>;
	starfive,uart-io-addr = /bits/ 32 <0x3f8>;
	starfive,wdi-io-addr = /bits/ 32 <0xa00>;
	starfive,mbox-io-addr = /bits/ 32 <0x300>;
	starfive,misc-io-addr = /bits/ 32 <0x480>;
	starfive,misc-sys-addr = /bits/ 32 <0x105c10c0>;

	starfive,vgpio_dir_bits = /bits/ 64 <0x00000000ffffffff 0x0000000000000000>;
	starfive,vgpio_lvl_bits = /bits/ 64 <0x0000000000000000 0x0000000000000000>;
	starfive,vgpio_phy_bits = /bits/ 64 <0x000000000000000f 0x0000000000000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&espi0_pins>;

	status = "okay";
};

&pwm {
	clocks = <&fpga_12mhz_clk>;
