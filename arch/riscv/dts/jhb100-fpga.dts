&i3c4 {
	status = "okay";
	clocks = <&fpga_12mhz_clk>;
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <1000000>;
	mode = "master";
	hotjoin;
	pinctrl-names = "default";
	pinctrl-0 = <&i3c4_pins>;
	is-mng;
	dmas = <&dma_i3c 4 9 8>;
	dma-names = "rx-tx";
	vcc-supply = <&reg_vcc_1v8>;
	#address-cells = <3>;
	#size-cells = <0>;

	hub@0,0 {
		reg = <0x0 0x0 0x0>;
		cp0-ldo-en = "disabled";
		cp1-ldo-en = "disabled";
		cp0-ldo-volt = "1.8V";
		cp1-ldo-volt = "1.8V";
		tp0145-ldo-en = "disabled";
		tp2367-ldo-en = "disabled";
		tp0145-ldo-volt = "1.0V";
		tp2367-ldo-volt = "1.0V";
		tp0145-pullup = "2k";
		tp2367-pullup = "2k";
		tp0145-io-strength = "50Ohms";
		tp2367-io-strength = "50Ohms";

		target-port@0 {
			mode = "i3c";
			pullup = "enabled";
		};
		target-port@1 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@2 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@3 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@4 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@5 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@6 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@7 {
			mode = "disabled";
			pullup = "disabled";
		};
	};
};

