&dc0_clk {
	single-node = <1>;
	status = "okay";
};

&dma_i3c {
	status = "disabled";
};

&dma_sfc0 {
	status = "okay";
};

&dma_sfc1 {
	status = "okay";
};

&dma_spi0 {
	status = "okay";
};

&dma_uart {
	status = "okay";
};

&dp {
	status = "okay";
};

&espi0 {
	starfive,flash-mtd-device = "bios-image0";
	starfive,host-src-addr = /bits/ 64 <0xf6810000>;
	perif-memcyc-size = <0x400000>;
	memory-region = <&espi0_mmbi_buffer_uncache>,
			<&espi0_perif_mem_uncache>,
			<&espi0_vw_mem_uncache>;

	starfive,bt-remap-num = <2>;
	starfive,kcs-remap-num = <4>;
	starfive,uart-remap-num = <2>;
	starfive,bt-io-addr = /bits/ 32 <0xe4 0xf4>;
	starfive,kcs-io-addr = /bits/ 32 <0xca2 0xcb2 0xcc2 0xcd2>;
	starfive,uart-io-addr = /bits/ 32 <0x3f8 0x410>;
	starfive,wdi-io-addr = /bits/ 32 <0xa00>;
	starfive,mbox-io-addr = /bits/ 32 <0x300>;

	starfive,vgpio_dir_bits = /bits/ 64 <0xffffffff00000000 0x0000000000000000>;
	starfive,vgpio_lvl_bits = /bits/ 64 <0x0000000000000000 0x0000000000000000>;
	starfive,vgpio_phy_bits = /bits/ 64 <0x0000000f0000000f 0x0000000000000000>;

	status = "okay";
};

&espi0_mmbi {
	mmbi-id = /bits/ 8 <0>;
	mmbi-instance-num = /bits/ 32 <1>;
	mmbi-instance-size = /bits/ 32 <0x10000>;
	mmbi-src-addr-offset = /bits/ 32 <0x10000>;
	mmbi-osuse = /bits/ 8 <0 0 0 0 0 0 0 0>;
	memory-region = <&espi0_mmbi_buffer_uncache>;
	status = "okay";
};

&gmac0 {
	assigned-clocks = <&per3crg JHB100_PER3CLK_GMAC0_RMII_MUX>;
	assigned-clock-parents = <&per3_gmac0_rmii_rclki>;
	mac-mode = "rmii";
	snps,use-ncsi;
	snps,ps-speed = <100>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_rmii_pins>;
	status = "okay";
};

&gmac2 {
	clocks = <&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_ACLK_I>,
		 <&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_CSR_I>,
		 <&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_PTP_REF_I>,
		 <&per2crg JHB100_PER2CLK_GMAC2_RGMII_DIV>,
		 <&per2crg JHB100_PER2CLK_MAIN_ICG_EN_GMAC2>;
	assigned-clocks = <&per2crg JHB100_PER2CLK_GMAC2_RGMII_125_MUX>,
			  <&per2crg JHB100_PER2CLK_GMAC2_RX_MUX_DLY>,
			  <&per2crg JHB100_PER2CLK_GMAC2_TX_MUX>,
			  <&per2crg JHB100_PER2CLK_GMAC2_TXCK_MUX_DLY>;
	assigned-clock-parents = <&per2_gmac2_rgmii_rx>,
				 <&per2crg JHB100_PER2CLK_GMAC2_RGMII_125_MUX>,
				 <&per2crg JHB100_PER2CLK_GMAC2_RGMII_DIV>,
				 <&per2crg JHB100_PER2CLK_GMAC2_TX_MUX>;
	phy-mode = "rgmii-id";
	phy-handle = <&phy2>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac2_mdio_pins &gmac2_rgmii_pins>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		phy2: ethernet-phy@2 {
			reg = <0>;
		};
	};
};

