/* ADC pinmux */
&pinctrl_adc0 {
	adc0_vin0_pins: adc0_vin0-grp {
		adc0_vin0-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G0,
					 FUNC_ADC1_VIN0)>;
			input-enable;
		};
	};

	adc0_vin1_pins: adc0_vin1-grp {
		adc0_vin1-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G1,
					 FUNC_ADC1_VIN1)>;
			input-enable;
		};
	};

	adc0_vin2_pins: adc0_vin2-grp {
		adc0_vin2-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G2,
					 FUNC_ADC1_VIN2)>;
			input-enable;
		};
	};

	adc0_vin3_pins: adc0_vin3-grp {
		adc0_vin3-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G3,
					 FUNC_ADC1_VIN3)>;
			input-enable;
		};
	};

	adc0_vin4_pins: adc0_vin4-grp {
		adc0_vin4-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G4,
					 FUNC_ADC1_VIN4)>;
			input-enable;
		};
	};

	adc0_vin5_pins: adc0_vin5-grp {
		adc0_vin5-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G5,
					 FUNC_ADC1_VIN5)>;
			input-enable;
		};
	};

	adc0_vin6_pins: adc0_vin6-grp {
		adc0_vin6-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G6,
					 FUNC_ADC1_VIN6)>;
			input-enable;
		};
	};

	adc0_vin7_pins: adc0_vin7-grp {
		adc0_vin7-pins {
			pinmux = <PINMUX(PADNUM_ADC0_GPIO_G7,
					 FUNC_ADC1_VIN7)>;
			input-enable;
		};
	};
};

&pinctrl_adc1 {
