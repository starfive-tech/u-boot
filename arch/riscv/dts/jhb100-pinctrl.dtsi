		sgpio0_mdi-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C31,
					FUNC_BMCPERIPH1_SGPIO0_M_DATA_IN)>;
			input-enable;
		};
	};

	sgpio1_pins: sgpio1-grp {
		sgpio1_mclk-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C32,
					FUNC_BMCPERIPH1_SGPIO1_M_CLK)>;
		};

		sgpio1_mld-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C33,
					FUNC_BMCPERIPH1_SGPIO1_M_LOAD)>;
		};

		sgpio1_mdo-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C34,
					FUNC_BMCPERIPH1_SGPIO1_M_DATA_OUT)>;
		};

		sgpio1_mdi-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH1_GPIO_C35,
					FUNC_BMCPERIPH1_SGPIO1_M_DATA_IN)>;
			input-enable;
		};
	};
};

/* SMBUS_ALT pinmux */
&pinctrl_bmcperiph0 {
	smbus0_alt_pins: smbus0_alt-grp {
		smbus0_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B28,
					 FUNC_BMCPERIPH0_SMBUS0_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus1_alt_pins: smbus1_alt-grp {
		smbus1_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B29,
					 FUNC_BMCPERIPH0_SMBUS1_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus2_alt_pins: smbus2_alt-grp {
		smbus2_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B30,
					 FUNC_BMCPERIPH0_SMBUS2_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus3_alt_pins: smbus3_alt-grp {
		smbus3_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B31,
					 FUNC_BMCPERIPH0_SMBUS3_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus4_alt_pins: smbus4_alt-grp {
		smbus4_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B32,
					 FUNC_BMCPERIPH0_SMBUS4_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus5_alt_pins: smbus5_alt-grp {
		smbus5_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B33,
					 FUNC_BMCPERIPH0_SMBUS5_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus6_alt_pins: smbus6_alt-grp {
		smbus6_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B34,
					 FUNC_BMCPERIPH0_SMBUS6_SMBALERT)>;
			/* input-enable; */
		};
	};

	smbus7_alt_pins: smbus7_alt-grp {
		smbus7_alt-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B35,
					 FUNC_BMCPERIPH0_SMBUS7_SMBALERT)>;
			/* input-enable; */
		};
	};
};

