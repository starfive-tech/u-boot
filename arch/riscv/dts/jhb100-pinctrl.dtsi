/* AUXPWRGOOD pinmux */
&pinctrl_sys0 {
	auxpowergood0_pins: auxpowergood0-grp {
		auxpowergood0-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_GPIO_A0,
					 FUNC_SYSTOP_SYS0_DOM_HOSTSS_AUXPWRGOOD0)>;
			input-enable;
		};
	};

	auxpowergood1_pins: auxpowergood1-grp {
		auxpowergood1-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0_GPIO_A1,
					 FUNC_SYSTOP_SYS0_DOM_HOSTSS_AUXPWRGOOD1)>;
			input-enable;
		};
	};
};

/* CAN pinmux */
&pinctrl_bmcperiph2_pok {
	can0_pins: can0-grp {
		can0_tx-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_POK_GPIO_D31,
					 FUNC_BMCPERIPH2_POK_CAN0_TXD)>;
		};

		can0_rx-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_POK_GPIO_D32,
					 FUNC_BMCPERIPH2_POK_CAN0_RXD)>;
			input-enable;
		};

		can0_stby-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_POK_GPIO_D33,
					 FUNC_BMCPERIPH2_POK_CAN0_STBY)>;
		};
	};

	can1_pins: can1-grp {
		can1_tx-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_POK_GPIO_D34,
					 FUNC_BMCPERIPH2_POK_CAN1_TXD)>;
		};

		can1_rx-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_POK_GPIO_D35,
					 FUNC_BMCPERIPH2_POK_CAN1_RXD)>;
			input-enable;
		};

		can1_stby-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH2_POK_GPIO_D36,
					 FUNC_BMCPERIPH2_POK_CAN1_STBY)>;
		};
	};
};

 /* eMMC pinmux */
&pinctrl_emmc {
	emmc0_pins: emmc0-grp {
		emmc0_clk-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F5,
					 FUNC_EMMC0_CLK)>;
		};

		emmc0_rst-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F10,
					 FUNC_EMMC0_RST_N)>;
		};

		emmc0_cmd-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F4,
					 FUNC_EMMC0_CMD)>;
		};

		emmc0_dqs-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F11,
					 FUNC_EMMC0_DQS)>;
		};

		emmc0_data0-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F0,
					 FUNC_EMMC0_DATA0)>;
		};

		emmc0_data1-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F1,
					 FUNC_EMMC0_DATA1)>;
		};

		emmc0_data2-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F2,
					 FUNC_EMMC0_DATA2)>;
		};

		emmc0_data3-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F3,
					 FUNC_EMMC0_DATA3)>;
		};

		emmc0_data4-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F9,
					 FUNC_EMMC0_DATA4)>;
		};

		emmc0_data5-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F8,
					 FUNC_EMMC0_DATA5)>;
		};

		emmc0_data6-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F7,
					 FUNC_EMMC0_DATA6)>;
		};

		emmc0_data7-pins {
			pinmux = <PINMUX(PADNUM_EMMC0_GPIO_F6,
					 FUNC_EMMC0_DATA7)>;
		};
	};
};

/* eSPI pinmux */
&pinctrl_sys0h {
	espi0_pins: espi0-grp {
		espi0-rst-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A11,
					 FUNC_SYSTOP_SYS0H_ESPI0_RESET)>;
			input-enable;
		};

		espi0-alt-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A10,
					 FUNC_SYSTOP_SYS0H_ESPI0_ALERT)>;
		};

		espi0-cs-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A9,
					 FUNC_SYSTOP_SYS0H_ESPI0_CS)>;
			bias-pull-up;
			input-enable;
		};

		espi0-clk-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A8,
					 FUNC_SYSTOP_SYS0H_ESPI0_CLK)>;
			bias-pull-down;
			input-enable;
		};

		espi0-io0-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A4,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA0)>;
			bias-pull-up;
			input-enable;
		};

		espi0-io1-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A5,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA1)>;
			bias-pull-up;
			input-enable;

		};

		espi0-io2-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A6,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA2)>;
			bias-pull-up;
			input-enable;
		};

		espi0-io3-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A7,
					 FUNC_SYSTOP_SYS0H_ESPI0_DATA3)>;
			bias-pull-up;
			input-enable;
		};
	};
};

&pinctrl_sys1 {
	espi1_pins: espi1-grp {
		espi0-rst-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A23,
					 FUNC_SYSTOP_SYS1_ESPI1_RESET)>;
			input-enable;
		};

		espi1-alt-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A22,
					 FUNC_SYSTOP_SYS1_ESPI1_ALERT)>;
		};

		espi1-cs-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A21,
					 FUNC_SYSTOP_SYS1_ESPI1_CS)>;
			bias-pull-up;
			input-enable;
		};

		espi1-clk-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A20,
					 FUNC_SYSTOP_SYS1_ESPI1_CLK)>;
			bias-pull-down;
			input-enable;
		};

		espi1-io0-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A16,
					 FUNC_SYSTOP_SYS1_ESPI1_DATA0)>;
			bias-pull-up;
			input-enable;
		};

		espi1-io1-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A17,
					 FUNC_SYSTOP_SYS1_ESPI1_DATA1)>;
			bias-pull-up;
			input-enable;
		};

		espi1-io2-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A18,
					 FUNC_SYSTOP_SYS1_ESPI1_DATA2)>;
			bias-pull-up;
			input-enable;
		};

		espi1-io3-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS1_GPIO_A19,
					 FUNC_SYSTOP_SYS1_ESPI1_DATA3)>;
			bias-pull-up;
			input-enable;
		};
	};
};

/* eSPI VW pinmux */
