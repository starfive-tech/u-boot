		};

		espi1-vw2-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A14,
					 FUNC_SYSTOP_SYS0H_ESPI1_VW2)>;
		};

		espi1-vw3-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS0H_GPIO_A15,
					 FUNC_SYSTOP_SYS0H_ESPI1_VW3)>;
		};
	};
};

/* GMAC pinmux */
&pinctrl_bmcperiph3 {
	gmac0_rmii_pins: gmac0_rmii-grp {
		gmac0_rmii_txen-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E6,
					 FUNC_BMCPERIPH3_GMAC0_RMII_TXEN)>;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_txd0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E7,
					 FUNC_BMCPERIPH3_GMAC0_RMII_PHY_TXD0)>;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_txd1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E8,
					 FUNC_BMCPERIPH3_GMAC0_RMII_PHY_TXD1)>;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_rclki-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E9,
					 FUNC_BMCPERIPH3_GMAC0_RMII_RCLKI)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_rclko-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E10,
					 FUNC_BMCPERIPH3_GMAC0_RMII_RCLKO)>;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_rxdv-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E4,
					 FUNC_BMCPERIPH3_GMAC0_RMII_CRSDV)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_rxd0-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E3,
					 FUNC_BMCPERIPH3_GMAC0_RMII_PHY_RXD0)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};

		gmac0_rmii_rxd1-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH3_GPIO_E2,
					 FUNC_BMCPERIPH3_GMAC0_RMII_PHY_RXD1)>;
			input-enable;
			starfive,gmac_vsel = <0>;
		};
	};
};

