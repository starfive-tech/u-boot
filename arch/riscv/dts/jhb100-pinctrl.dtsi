/* UART port pinmux */
&pinctrl_sys2 {
	uart0_pins: uart0-grp {
		uart0_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A26,
					 FUNC_SYSTOP_SYS2_UART0_TX)>;
		};

		uart0_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A27,
					 FUNC_SYSTOP_SYS2_UART0_RX)>;
			input-enable;
		};
	};

	uart0_rs232_pins: uart0_rs232-grp {
		uart0_rs232_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A26,
					 FUNC_SYSTOP_SYS2_UART0_TX)>;
		};

		uart0_rs232_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A27,
					 FUNC_SYSTOP_SYS2_UART0_RX)>;
			input-enable;
		};

		uart0_rs232_cts-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A24,
					 FUNC_SYSTOP_SYS2_UART_CTS)>;
			input-enable;
		};

		uart0_rs232_rts-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A25,
					 FUNC_SYSTOP_SYS2_UART_RTS)>;
		};

		uart0_rs232_dcd-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A57,
					 FUNC_SYSTOP_SYS2_UART_DCD)>;
			input-enable;
		};

		uart0-rs232_dsr-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A58,
					 FUNC_SYSTOP_SYS2_UART_DSR)>;
			input-enable;
		};

		uart0_rs232_dtr-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A59,
					 FUNC_SYSTOP_SYS2_UART_DTR)>;
		};

		uart0_rs232_ri-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A60,
					 FUNC_SYSTOP_SYS2_UART_RI)>;
			input-enable;
		};
	};

	uart1_pins: uart1-grp {
		uart1_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A28,
					 FUNC_SYSTOP_SYS2_UART1_TX)>;
		};

		uart1_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A29,
					 FUNC_SYSTOP_SYS2_UART1_RX)>;
			input-enable;
		};
	};

	uart2_pins: uart2-grp {
		uart2_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A30,
					 FUNC_SYSTOP_SYS2_UART2_TX)>;
		};

		uart2_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A31,
					 FUNC_SYSTOP_SYS2_UART2_RX)>;
			input-enable;
		};
	};

	uart3_pins: uart3-grp {
		uart3_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A32,
					 FUNC_SYSTOP_SYS2_UART3_TX)>;
		};

		uart3_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A33,
					 FUNC_SYSTOP_SYS2_UART3_RX)>;
			input-enable;
		};
	};

	uart4_pins: uart4-grp {
		uart4_tx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A34,
					 FUNC_SYSTOP_SYS2_UART4_TX)>;
		};

		uart4_rx-pins {
			pinmux = <PINMUX(PADNUM_SYSTOP_SYS2_GPIO_A35,
