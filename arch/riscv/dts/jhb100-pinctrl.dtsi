/* VGA_VDAC_PHY pinmux */
&pinctrl_vga_vdac {
	vga_pins: vga-grp {
		vga_hs-pins {
			pinmux = <PINMUX(PADNUM_VGA_VDAC_GPIO_I0,
					 FUNC_VGA_VDAC_VGAHS)>;
		};

		vga_vs-pins {
			pinmux = <PINMUX(PADNUM_VGA_VDAC_GPIO_I1,
					 FUNC_VGA_VDAC_VGAVS)>;
		};

		vga_ddcclk-pins {
			pinmux = <PINMUX(PADNUM_VGA_VDAC_GPIO_I2,
					 FUNC_VGA_VDAC_DDCCLK)>;
		};

		vga_ddcdat-pins {
			pinmux = <PINMUX(PADNUM_VGA_VDAC_GPIO_I3,
					 FUNC_VGA_VDAC_DDCDAT)>;
		};
	};
};

/* WDT pinmux */
&pinctrl_bmcperiph0 {
	wdt_ext_reset_pins: wdt_ext_reset-grp {
		wdt_ext_reset-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B32,
					 FUNC_BMCPERIPH0_WDT0_3_OR_RESET_OUTPUT)>;
		};
	};

	wdt_secrp_rst_pins:  wdt_secrp_rst-grp {
		wdt_ext_reset-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B33,
					 FUNC_BMCPERIPH0_WDT_SECRP_RESET_OUTPUT)>;
		};
	};

	wdt4_ext_reset_pins:  wdt4_ext_reset-grp {
		wdt4_ext_reset-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B34,
					 FUNC_BMCPERIPH0_WDT4_RESET_OUTPUT)>;
		};
	};

	wdt4_restart_pins:  wdt4_restart-grp {
		wdt4_restart-pins {
			pinmux = <PINMUX(PADNUM_BMCPERIPH0_GPIO_B35,
					 FUNC_BMCPERIPH0_WDT4_RESTART_INPUT)>;
			input-enable;
		};
	};
};
