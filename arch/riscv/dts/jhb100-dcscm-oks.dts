	/* 42-43 */	"CPU0_MISMATCH", "CPU2_SKT_FAULT_LED", "CPU1_SKTOCC1_N", "CPU3_SKT_FAULT_LED",
	/* 44-45 */	"CPU1_SKTOCC2_N", "", "CPU1_MISMATCH", "",
