#include "jhb100-dcscm.dtsi"
#include "jhb100-evb1-sfc0-flash.dtsi"

/ {
	chosen {
		stdout-path = "serial6:115200n8";
	};
};

&espi0 {
	starfive,vgpio_mode = <1>;
	gpio-line-names  =
										/* Output pins */
		"", "", "", "",							/* VGPIO0-3 */
		"VW_FM_DUAL_PARTITION_N", "VW_FM_STANDALONE_MODE_N",		/* VGPIO4-5 */
		"VW_FM_4S_8S_N_MODE", "VW_FM_NODE_ID_1",			/* VGPIO6-7 */
		"VW_FM_NODE_ID_0", "", "", "", "", "", "", "",			/* VGPIO8-15*/
		"", "", "", "",	"", "", "", "",					/* VGPIO16-23 */
		"", "", "", "",	"", "", "", "",					/* VGPIO23-31 */
										/* Input pins */
		"", "", "", "",							/* VGPIO32-35 */
		"VW_FM_BIOS_POST_CMPLT_N", "VW_CORE_BIOS_DONE_N", "", "",	/* VGPIO36-39 */
		"", "", "", "",	"", "", "", "",					/* VGPIO40-47 */
		"", "", "", "",	"", "", "", "",					/* VGPIO48-55 */
		"", "", "", "",	"", "", "", "";					/* VGPIO56-63 */
};

&espi1 {
	status = "disabled";
};

&espi1_mmbi {
	status = "disabled";
};

&gmac2 {
	status = "disabled";
};

&i2c4_master {
	status = "disabled";
};

&i2c5_master {
	status = "disabled";
};

&i2c8_master {
	status = "disabled";
};

&i3c4 {
	/* status = "okay"; */
};

&i3c5 {
	/* status = "okay"; */
};

&i3c8 {
	/* status = "okay"; */
};

&ltpi0 {
	nlgpio-number = /bits/ 16 <128>;

	llgpo0: virgpio@1000 {
		ngpios = <16>;
		gpo-init-value = <0x100>;
		status = "okay";
	};

	llgpi0: virgpio@1180 {
		ngpios = <16>;
		status = "okay";
	};

	nlgpo0: virgpio@2000 {
		ngpios = <128>;
		/* bit[31:0, 63:32, 95:64, 127,96] */
		gpo-init-value = <0x00400000 0x0E101300 0x03400800 0x0>;
		status = "okay";
	};

	nlgpi0: virgpio@2180 {
		ngpios = <128>;
		status = "okay";
	};
};

&ltpi1 {
	status = "disabled";
};

&pcie1_mctp {
	status = "disabled";
};

&pcie1_mmbi {
	status = "disabled";
};

&pcie_ep1 {
	status = "disabled";
};

&pinctrl_adc0 {
	gpio-line-names =
		"MUX_I3C14_EN_N", "MUX_I3C15_EN_N",			/* GPIOG0-1 */
		"BMC_MUX_I3C14_SEL", "BMC_MUX_I3C15_SEL",		/* GPIOG2-3 */
		"NC", "SPI_SCMCNTRL_IRQ0_R_N", "NC", "NC";		/* GPIOG4-7 */
};

&pinctrl_adc1 {
	gpio-line-names =
