&sfc0 {
	rx-sample-delay-ns = <10>;
};

&sfc1 {
	rx-sample-delay-ns = <10>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <20000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&sfc2 {
	rx-sample-delay-ns = <10>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <20000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&sgpio0 {
	/* SGPIO lines: Each IO number in pairs (input, output) */
	gpio-line-names =
	/* 0-1 */	"CPU0_VRHOT_N", "LED_POSTCODE_0_LSB", "CPU0_THERMTRIP_N", "LED_POSTCODE_1",
	/* 2-3 */	"CPU0_MEMTRIP_N", "LED_POSTCODE_2", "CPU0_MEM_VRHOT_N", "LED_POSTCODE_3",
	/* 4-5 */	"CPU0_MEM_HOT_N", "LED_POSTCODE_4", "CPU0_MON_FAIL_N", "LED_POSTCODE_5",
	/* 6-7 */	"CPU1_VRHOT_N", "LED_POSTCODE_6", "CPU1_THERMTRIP_N", "LED_POSTCODE_7_MSB",
	/* 8-9 */	"CPU1_MEMTRIP_N", "FM_ASYNC_WARM_RESET_REQ", "CPU1_MEM_VRHOT_N", "HPM_FRU_READ_DONE",
	/* 10-11 */	"CPU1_MEM_HOT_N", "FM_ASYNC_GLOBAL_RESET_REQ", "CPU1_MON_FAIL_N", "BMC_BOOT_DONE",
	/* 12-13 */	"CPU2_VRHOT_N", "NMI_OUT", "CPU2_THERMTRIP_N", "AGGREGATOR_MODE",
	/* 14-15 */	"CPU2_MEMTRIP_N", "RST_I3C_PCIE_HUB_N", "CPU2_MEM_VRHOT_N", "",
	/* 16-17 */	"CPU2_MEM_HOT_N", "HPM0_PRESENT", "CPU2_MON_FAIL_N", "HPM1_PRESENT",
	/* 18-19 */	"CPU3_VRHOT_N", "HPM2_PRESENT", "CPU3_THERMTRIP_N", "HPM3_PRESENT",
	/* 20-21 */	"CPU3_MEMTRIP_N", "HPM0_SOURCE_TO_DESTINATION_FAIL", "CPU3_MEM_VRHOT_N", "HPM1_SOURCE_TO_DESTINATION_FAIL",
	/* 22-23 */	"CPU3_MEM_HOT_N", "HPM2_SOURCE_TO_DESTINATION_FAIL", "CPU3_MON_FAIL_N", "HPM3_SOURCE_TO_DESTINATION_FAIL",
	/* 24-25 */	"FM_BMC_VAL_EN", "HPM0_FRU_VALID", "FM_SERIAL_BOOT", "HPM1_FRU_VALID",
	/* 26-27 */	"FM_INTRUSION_CABLE_PRES_N", "HPM2_FRU_VALID", "USB_OC_P2_3_N", "HPM3_FRU_VALID",
