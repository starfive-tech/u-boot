&pinctrl_vga_vdac {
	gpio-line-names =
		"VGA_HS", "VGA_VS", "VGA_DDCCLK", "VGA_DDCDAT";		/* GPIOI0-3 */
};

&sfc0 {
	pinctrl-0 = <&sfc0_1cs_pins>;
	num-cs = <1>;
	/delete-node/ flash@1;
};

&sfc1 {
	status = "okay";
	rx-sample-delay-ns = <10>;
};
