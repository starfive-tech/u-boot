&adc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&adc0_vin0_pins &adc0_vin1_pins &adc0_vin2_pins &adc0_vin3_pins
		     &adc0_vin4_pins &adc0_vin5_pins &adc0_vin6_pins &adc0_vin7_pins>;
	upper-bound = /bits/ 16 <0xfff>;
	lower-bound = /bits/ 16 <0>;
	scan-freq = /bits/ 16 <0x3e3>;
	status = "okay";
};

&adc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&adc1_vin0_pins &adc1_vin1_pins &adc1_vin2_pins &adc1_vin3_pins
		     &adc1_vin4_pins &adc1_vin5_pins &adc1_vin6_pins &adc1_vin7_pins>;
	upper-bound = /bits/ 16 <0xfff>;
	lower-bound = /bits/ 16 <0>;
	scan-freq = /bits/ 16 <0x3e3>;
	status = "okay";
};

&can0 {
	pinctrl-names = "default";
	pinctrl-0 = <&can0_pins>;
	status = "disabled";
};

&can1 {
	pinctrl-names = "default";
	pinctrl-0 = <&can1_pins>;
	status = "disabled";
};

&dma_i3c {
	status = "disabled";
};

&dma_spi0 {
	status = "okay";
};

&i2c1_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "okay";
};

&i2c2_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	status = "disabled";
};

/* SMBus ARP test: I2C3 as SMBus ARP master */
&i2c3_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	status = "okay";

	smbus_arp@61 {
		compatible = "i2c-smbus-arp";
		reg = <0x61>;
	};
};

&i2c4_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	status = "disabled";
};

&i2c5_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "disabled";
};

&i2c6_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	status = "disabled";
};

&i2c7_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;
	status = "disabled";
};

/* SMBus loopback test: I2C8 as master, I2C9 as slave acting as an emulated EEPROM */
&i2c8_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_pins>;
	status = "disabled";
};

/* SMBus loopback test: I2C8 as master, I2C9 as slave acting as an emulated EEPROM */
&i2c9_slave {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c9_pins>;
	status = "disabled";

	slave-eeprom@66 {
		compatible = "slave-24c02";
		reg = <(0x66 | I2C_OWN_SLAVE_ADDRESS)>;
	};
};

&i2c10_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c10_pins>;
	status = "disabled";
};

&i2c11_master {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c11_pins>;
	status = "disabled";
};

&i2c11_slave {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c11_pins>;
	status = "okay";

	starfive,mctp-i2c-ms = <&i2c0_master>;
	mctp-controller;
	mctp@15 {
		compatible = "mctp-i2c-controller";
		reg = <(0x15 | I2C_OWN_SLAVE_ADDRESS)>;
	};
};

&i3c0 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	pinctrl-names = "default";
	pinctrl-0 = <&i3c0lv_pins>;
	status = "disabled";
};

&i3c1 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	pinctrl-names = "default";
	pinctrl-0 = <&i3c1lv_pins>;
	status = "disabled";
};

&i3c2 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	pinctrl-names = "default";
	pinctrl-0 = <&i3c2lv_pins>;
	status = "disabled";
};

&i3c3 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	pinctrl-names = "default";
	pinctrl-0 = <&i3c3lv_pins>;
	status = "disabled";
};

&i3c4 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	pinctrl-names = "default";
	pinctrl-0 = <&i3c4_pins>;
	status = "disabled";
};

&i3c4_syscon {
	gpio-select = <GPIO_LEVEL_BIT GPIO_NORMAL>;
};

