&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_ch0_pins &pwm_ch1_pins &pwm_ch2_pins &pwm_ch3_pins
		     &pwm_ch4_pins &pwm_ch5_pins &pwm_ch6_pins &pwm_ch7_pins>;
	status = "okay";
};

&pwm_tach {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_tach0_i0_pins &pwm_tach0_i1_pins
		     &pwm_tach0_i2_pins &pwm_tach0_i3_pins
		     &pwm_tach0_i4_pins &pwm_tach0_i5_pins
		     &pwm_tach0_i6_pins &pwm_tach0_i7_pins
		     &pwm_tach0_i8_pins &pwm_tach0_i9_pins
		     &pwm_tach0_i10_pins &pwm_tach0_i11_pins
		     &pwm_tach0_i12_pins &pwm_tach0_i13_pins
		     &pwm_tach0_i14_pins &pwm_tach0_i15_pins>;
	status = "okay";

	fan@0 {
		tach-ch = <0x0>, <0x8>;
	};
	fan@1 {
		tach-ch = <0x1>, <0x9>;
	};
	fan@2 {
		tach-ch = <0x2>, <0xa>;
	};
	fan@3 {
		tach-ch = <0x3>, <0xb>;
	};
	fan@4 {
		tach-ch = <0x4>, <0xc>;
	};
	fan@5 {
		tach-ch = <0x5>, <0xd>;
	};
	fan@6 {
		tach-ch = <0x6>, <0xe>;
	};
	fan@7 {
		tach-ch = <0x7>, <0xf>;
	};
};

