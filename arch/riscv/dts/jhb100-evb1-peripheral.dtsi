&adc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&adc0_vin0_pins &adc0_vin1_pins &adc0_vin2_pins &adc0_vin3_pins
		     &adc0_vin4_pins &adc0_vin5_pins &adc0_vin6_pins &adc0_vin7_pins>;
	upper-bound-mv = /bits/ 16 <1800>;
	lower-bound-mv = /bits/ 16 <0>;
	scan-freq = /bits/ 16 <0x3e3>;
	status = "okay";
};

&adc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&adc1_vin0_pins &adc1_vin1_pins &adc1_vin2_pins &adc1_vin3_pins
		     &adc1_vin4_pins &adc1_vin5_pins &adc1_vin6_pins &adc1_vin7_pins>;
	upper-bound-mv = /bits/ 16 <1800>;
	lower-bound-mv = /bits/ 16 <0>;
	scan-freq = /bits/ 16 <0x3e3>;
	status = "okay";
};

&can0 {
	ts = <0x07>; /* bit 0 enable ts, bit 1 enable tts, bit 2: 0 SOF, 1 EOF */
	status = "okay";
};

&can1 {
	ts = <0x07>; /* bit 0 enable ts, bit 1 enable tts, bit 2: 0 SOF, 1 EOF */
	status = "okay";
};

&dma_i3c {
	status = "disabled";
};

&dma_spi0 {
	status = "okay";
};

&i2c1_master {
	clock-frequency = <100000>;
	status = "okay";
};

&i2c2_master {
	clock-frequency = <100000>;
	status = "disabled";
};

/* SMBus ARP test: I2C3 as SMBus ARP master */
&i2c3_master {
	clock-frequency = <100000>;
	status = "okay";

	smbus_arp@61 {
		compatible = "i2c-smbus-arp";
		reg = <0x61>;
	};
};

&i2c4_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c5_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c6_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c7_master {
	clock-frequency = <100000>;
	status = "disabled";
};

/* SMBus loopback test: I2C8 as master, I2C9 as slave acting as an emulated EEPROM */
&i2c8_master {
	clock-frequency = <100000>;
	status = "disabled";
};

/* SMBus loopback test: I2C8 as master, I2C9 as slave acting as an emulated EEPROM */
&i2c9_slave {
	clock-frequency = <100000>;
	status = "disabled";

	slave-eeprom@66 {
		compatible = "slave-24c02";
		reg = <(0x66 | I2C_OWN_SLAVE_ADDRESS)>;
	};
};

&i2c10_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c11_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c11_slave {
	clock-frequency = <100000>;
	status = "okay";

	starfive,mctp-i2c-ms = <&i2c0_master>;
	mctp-controller;
	mctp@15 {
		compatible = "mctp-i2c-controller";
		reg = <(0x15 | I2C_OWN_SLAVE_ADDRESS)>;
	};
};

&i3c0 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	dmas = <&dma_i3c 0 1 0>;
	dma-names = "rx-tx";
	i3c-od-pu-offset = <2>;
	i3c-od-lo-offset = <0>;
	master-sda-tx-hold = <3>;
	master-sda-pp-od-switch-dly = <1>;
	master-sda-od-pp-switch-dly = <1>;
	master-stop-hold-cnt = <0x8>;
	status = "disabled";

	#address-cells = <3>;
	#size-cells = <0>;

	eeprom@50 {
		reg = <0x50 0x0 0x10>;
		compatible = "atmel,24c64";
		vcc-supply = <&vcc_1v8>;
		pagesize = <32>;
	};
};

