	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;
	status = "okay";

	spi_dev0: spi@0 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <12000000>;
		reg = <0>;
	};

	spi_dev1: spi@1 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <12000000>;
		reg = <1>;
	};
};

&uart9 {
	status = "okay";
