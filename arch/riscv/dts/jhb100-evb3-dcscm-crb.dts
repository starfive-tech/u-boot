		"VW_FM_4S_8S_N_MODE", "VW_FM_NODE_ID_1",			/* VGPIO6-7 */
		"VW_FM_NODE_ID_0", "", "", "", "", "", "", "",			/* VGPIO8-15*/
		"", "", "", "",	"", "", "", "",					/* VGPIO16-23 */
		"", "", "", "",	"", "", "", "",					/* VGPIO23-31 */
										/* Input pins */
		"", "", "", "",							/* VGPIO32-35 */
		"VW_FM_BIOS_POST_CMPLT_N", "VW_CORE_BIOS_DONE_N", "", "",	/* VGPIO36-39 */
		"", "", "", "",	"", "", "", "",					/* VGPIO40-47 */
		"", "", "", "",	"", "", "", "",					/* VGPIO48-55 */
		"", "", "", "",	"", "", "", "";					/* VGPIO56-63 */
};

