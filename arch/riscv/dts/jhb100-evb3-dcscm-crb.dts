#include "jhb100-evb3.dtsi"
#include "jhb100-dcscm.dtsi"

/ {
	chosen {
		stdout-path = "serial4:115200n8";
	};
};

&gmac2 {
	mdio {
		phy2: ethernet-phy@2 {
			reg = <0>;
		};
	};
};

&jtag0 {
	status = "okay";
};

&pinctrl_adc0 {
	gpio-line-names =
		"IRQ_PMBUS1_ALERT_N", "FM_SPD_SWITCH_CTRL_N",		/* GPIOG0-1 */
		"FP_NMI_BTN_N", "FP_LED_STATUS_GREEN_N",		/* GPIOG2-3 */
		"FP_ID_BTN_N", "PWRGD_AUX_PWRGD_BMC_CPU0",		/* GPIOG4-5 */
		"NC", "NC";						/* GPIOG6-7 */

	gpiog1 {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FM_SPD_SWITCH_CTRL_N";
	};
};

&pinctrl_adc1 {
	gpio-line-names =
		"RST_BMC_PCIE_MUX_N", "RST_BMC_HSBP_MUX_N",		/* GPIOH0-1 */
		"FM_SMB_BMC_NVME_LVC3_ALERT_N", "FM_PARTITION_SEL",	/* GPIOH2-3 */
		"REMOTE_DEBUG_ENABLE", "SIO_S3", "NC", "NC";		/* GPIOH4-7 */

	gpioh0 {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "RST_BMC_PCIE_MUX_N";
	};

	gpioh1 {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "RST_BMC_HSBP_MUX_N";
	};
};

&pinctrl_bmcperiph0 {
	gpio-line-names =
		"I2C0_SCL", "I2C0_SDA", "I2C1_SCL", "I2C1_SDA",			/* GPIOB0-3 */
		"I2C2_SCL", "I2C2_SDA", "I2C3_SCL", "I2C3_SDA",			/* GPIOB4-7 */
		"I2C4_SCL", "I2C4_SDA",						/* GPIOB8-9 */
		"PCH_BMC_THERMTRIP", "CPU_CATERR",				/* GPIOB10-11 */
		"I2C6_SCL", "I2C6_SDA", "I2C7_SCL", "I2C7_SDA",			/* GPIOB12-15 */
		"I2C8_SCL", "I2C8_SDA", "I2C9_SCL", "I2C9_SDA",			/* GPIOB16-19 */
		"I2C10_SCL", "I2C10_SDA", "I2C11_SCL", "I2C11_SDA",		/* GPIOB20-23 */
		"GMAC2_MDC", "GMAC2_MDIO", "NC", "NC",				/* GPIOB24-27 */
		"NC", "NC", "NC", "NC",						/* GPIOB28-31 */
		"NC", "NC", "NC", "NC",						/* GPIOB32-35 */
		"I3C12_SCL", "I3C12_SDA", "I3C13_SCL", "I3C13_SDA",		/* GPIOB36-39 */
		"FM_BMC_SAFS_EN", "FM_LED_BMC_CPU_RSTIND",			/* GPIOB40-41 */
		"PWRGD_CPU0_AUXPWRGD_1V8", "FM_SKT1_FAULT_LED",			/* GPIOB42-43 */
		"I3C0LV_SCL", "I3C0LV_SDA", "I3C1LV_SCL", "I3C1LV_SDA",		/* GPIOB44-47 */
		"I3C2LV_SCL", "I3C2LV_SDA", "NC", "NC",				/* GPIOB48-51 */
		"NC", "NC", "NC", "NC",						/* GPIOB52-55 */
		"NC", "NC", "NC", "NC";						/* GPIOB56-59 */

	gpioe-i3c0-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOB8-11, 32-33 */
	gpioe-i3c1-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOB12-15, 34-35 */
	gpioe-i3c2-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOB16-23 */
	gpioe-i3c4-vsel = <JHB100_VREF_1_8V>; /* VREF for GPIOB36-43 */

	gpiob41 {
		gpio-hog;
		gpios = <41 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FM_LED_BMC_CPU_RSTIND";
	};

	gpiob43 {
		gpio-hog;
		gpios = <43 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FM_SKT1_FAULT_LED";
	};
};

&pinctrl_bmcperiph1 {
	gpio-line-names =
		"SPI0_CS0", "SPI0_CS1", "SPI0_SCLK", "SPI0_TX",			/* GPIOC0-3 */
		"SPI0_RX", "SFC0_CS0", "FM_SKT0_FAULT_LED", "SFC0_SCLK",	/* GPIOC4-7 */
		"SFC0_IO0", "SFC0_IO1", "SFC0_IO2", "SFC0_IO3",			/* GPIOC8-11 */
		"RST_SRST_BMC_SCM_FPGA_N", "FM_CPU1_ERR0_LVT3_N",		/* GPIOC12-13 */
		"NC", "FM_CPU0_ERR2_LVC3_N",					/* GPIOC14-15 */
		"FM_NODE_ID0", "FM_NODE_ID1",					/* GPIOC16-17 */
		"FM_CPU0_ERR0_LVC3_N", "FM_CPU0_ERR1_LVC3_N",			/* GPIOC18-19 */
		"PRDY_N", "PREQ_N", "NC", "NC",					/* GPIOC20-23 */
		"FM_4S_8S_N_MODE", "NC",					/* GPIOC24-25 */
		"FM_BMC_CMOS_CLR_R_N", "PS_PWROK",				/* GPIOC26-27 */
		"SGPIO0_CLK", "SGPIO0_LD", "SGPIO0_DO", "SGPIO0_DI",		/* GPIOC28-31 */
		"FM_STANDALONE_MODE_N", "FM_BMC_TRUST_N",			/* GPIOC32-33 */
		"FM_CPU1_ERR1_LVT3_N", "FM_CPU1_ERR2_LVT3_N";			/* GPIOC34-35 */

	gpioe-spi-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOC0-4 */
	gpioe-qspi0-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOC5-11 */
	gpioe-qspi1-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOC12-19 */
	gpioe-qspi2-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOC20-27 */

	gpioc6 {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FM_SKT0_FAULT_LED";
	};

	gpioc21 {
		gpio-hog;
		gpios = <21 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "PREQ_N";
	};

	gpioc26 {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "FM_BMC_CMOS_CLR_R_N";
	};

	gpioc33 {
		gpio-hog;
		gpios = <33 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FM_BMC_TRUST_N";
	};
};

&pinctrl_bmcperiph2 {
	gpio-line-names =
		"SIO_POWER_GOOD", "FP_ID_LED_N",				/* GPIOD0-1 */
		"FP_LED_STATUS_AMBER_N", "SIO_S5",				/* GPIOD2-3 */
		"A_P3V_BAT_SCALED_EN", "NC", "FM_SPEAKER_BMC", "NC",		/* GPIOD4-7 */
		"FM_BMC_CPU_FBRK_OUT_R_N", "DBP_PRESENT_IN_R2_N",		/* GPIOD8-9 */
		"FM_TPM_EN_PULSE", "FM_FORCE_BMC_UPDATE_N",			/* GPIOD10-11 */
		"PLTRST_N", "NC", "NC", "NC",					/* GPIOD12-15 */
		"NC", "NC", "NC", "GMAC2_RXCLK",				/* GPIOD16-19 */
		"GMAC2_RXDV", "GMAC2_RXD0", "GMAC2_RXD1", "GMAC2_RXD2",		/* GPIOD20-23 */
		"GMAC2_RXD3", "GMAC2_TXCLK", "GMAC2_TXEN", "GMAC2_TXD0",	/* GPIOD24-27 */
		"GMAC2_TXD1", "GMAC2_TXD2", "GMAC2_TXD3";			/* GPIOD28-30 */

	gpionw-vsel = <JHB100_VREF_1_8V>; /* VREF for GPIOD19-30 */
};

&pinctrl_bmcperiph2_pok {
	gpio-line-names =
		"NC", "NC", "NC", "NC",					/* GPIOD31-34 */
		"NC", "NC", "FP_RST_BTN_N", "BMC_RST_BTN_N",		/* GPIOD35-38 */
		"FP_PWR_BTN_N", "FM_BMC_PWRBTN_OUT_N", "NC", "NC",	/* GPIOD39-42 */
		"NC", "PWM0_CH3", "NC", "NC",				/* GPIOD43-46 */
		"NC", "NC";						/* GPIOD47-48 */
};

&pinctrl_bmcperiph3 {
	gpio-line-names =
		"NC", "NC", "GMAC0_RXD1", "GMAC0_RXD0",				/* GPIOE0-3 */
		"GMAC0_RXDV", "CLK_1_8M_UART", "GMAC0_TXEN", "GMAC0_TXD0",	/* GPIOE4-7 */
		"GMAC0_TXD1", "GMAC0_RCLKI", "GMAC0_RCLKO";			/* GPIOE8-11 */

	gpios-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOE0-10 */
};

&pinctrl_emmc {
	gpio-line-names =
		"EMMC0_CLK", "EMMC0_RST", "EMMC0_CMD", "EMMC0_DQS",		/* GPIOF0-3 */
		"EMMC0_DATA0", "EMMC0_DATA1", "EMMC0_DATA2", "EMMC0_DATA3",	/* GPIOF4-7 */
		"EMMC0_DATA4", "EMMC0_DATA5", "EMMC0_DATA6", "EMMC0_DATA7";	/* GPIOF8-11 */
};

&pinctrl_sys0 {
	gpio-line-names =
		"PWRGD_CPU0_AUXPWRGD", "NC", "HB_LED", "NC";		/* GPIOA0-3 */
};

&pinctrl_sys0h {
	gpio-line-names =
		"ESPI0_IO0", "ESPI0_IO1", "ESPI0_IO2", "ESPI0_IO3",		/* GPIOA4-7 */
		"ESPI0_CLK", "ESPI0_CS", "ESPI0_ALERT", "ESPI0_RESET",		/* GPIOA8-11 */
		"NC", "NC", "NC", "NC";						/* GPIOA12-15 */
};

&pinctrl_sys1 {
	gpio-line-names =
		"NC", "NC", "NC", "NC",		/* GPIOA16-19 */
		"NC", "NC", "NC", "NC";		/* GPIOA20-23 */
};

&pinctrl_sys2 {
	gpio-line-names =
		"NC", "NC", "NC", "NC",						/* GPIOA24-27 */
		"NC", "NC", "NC", "NC",						/* GPIOA28-31 */
		"NC", "NC", "UART4_TX", "UART4_RX",				/* GPIOA32-35 */
		"NC", "NC", "NC", "NC",						/* GPIOA36-39 */
		"NC", "NC", "NC", "NC",						/* GPIOA40-43 */
		"UART9_TX", "UART9_RX", "NC", "NC",				/* GPIOA44-47 */
		"UART11_TX", "UART11_RX", "FM_BMC_BMCINIT_R", "SIO_ONCONTROL",	/* GPIOA48-51 */
		"NC", "NC", "NC", "NC",						/* GPIOA52-55 */
		"NC", "NC", "NC", "NC",						/* GPIOA56-59 */
		"NC";								/* GPIOA60 */

	gpiow-vsel = <JHB100_VREF_3_3V>; /* VREF for GPIOA36-43 */

	gpioa50 {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FM_BMC_BMCINIT_R";
	};

	gpioa51 {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "SIO_ONCONTROL";
	};
};

&pinctrl_vga_vdac {
	gpio-line-names =
		"NC", "NC", "NC", "NC";		/* GPIOI0-3 */
};

&uart4 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ resets;
};

&usb0 {
	status = "disabled";
};

&usb1 {
	status = "okay";
};

&usb1core {
	dr_mode = "host";
};
