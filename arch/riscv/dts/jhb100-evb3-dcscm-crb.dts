&sol4 {
	memory-region = <&sol_tx_mem_uncache>,
			<&sol_rx_mem_uncache>;
	tx-size = <3>;
	rx-size = <3>;
	dev-id = <4>;
	status = "okay";
};

&uart4 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ resets;
};

&usb0 {
	status = "disabled";
};

&usb1 {
	status = "okay";
};

&usb1core {
	dr_mode = "host";
};

&i3c0 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	i3c-od-scl-high-ns = <1000>;
	i3c-od-scl-low-ns = <1500>;
	i3c-pp-scl-high-ns = <60>;
	i3c-pp-scl-low-ns = <100>;
	master-sda-tx-hold = <3>;
	master-sda-pp-od-switch-dly = <1>;
	master-sda-od-pp-switch-dly = <1>;
	master-stop-hold-cnt = <0xf>;
	is-mng;
	status = "okay";
	#address-cells = <3>;
	#size-cells = <0>;

	hub@0,4cd00000000 {
		compatible = "renesas,i3chub-rg3mxxb12b1";
		reg = <0x0 0x4cd 0x0>;
		cp0-ldo-en = "disabled";
		cp1-ldo-en = "disabled";
		cp0-ldo-volt = "1.0V";
		cp1-ldo-volt = "1.0V";
		tp0145-ldo-en = "disabled";
		tp2367-ldo-en = "disabled";
		tp0145-ldo-volt = "1.0V";
		tp2367-ldo-volt = "1.0V";
		tp0145-pullup = "2k";
		tp2367-pullup = "2k";
		tp0145-io-strength = "50Ohms";
		tp2367-io-strength = "50Ohms";

		target-port@0 {
			mode = "i3c";
			pullup = "enabled";
		};
		target-port@1 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@2 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@3 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@4 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@5 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@6 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@7 {
			mode = "disabled";
			pullup = "disabled";
		};
	};
};

&dc0_clk {
	single-node = <1>;
	status = "okay";
};

&rpmi_pmdomain {
	off-domains = <PD_HOST1_USB PD_GPU0 PD_GPU1 PD_DC1 PD_HOSTSS_i1 PD_UFS PD_BMCPCIe_RP>;
};
