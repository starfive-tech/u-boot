#include "jhb100.dtsi"
#include "jhb100-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/i2c/i2c.h>

/ {
	model = "StarFive JHB100 DC-SCM";
	compatible = "starfive,jhb100-dcscm", "starfive,jhb100";

	aliases {
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		serial10 = &uart10;
		serial11 = &uart11;
		serial12 = &uart12;
		serial13 = &uart13;
		serial14 = &uart14;

		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		ethernet2 = &gmac2;
		ethernet3 = &gmac3;

		i2c0 = &i2c0_master;
		i2c1 = &i2c0_slave;

		i2c2 = &i2c1_master;
		i2c3 = &i2c1_slave;

		i2c4 = &i2c2_master;
		i2c5 = &i2c2_slave;

		i2c6 = &i2c3_master;
		i2c7 = &i2c3_slave;

		i2c8 = &i2c4_master;
		i2c9 = &i2c4_slave;

		i2c10 = &i2c5_master;
		i2c11 = &i2c5_slave;

		i2c12 = &i2c6_master;
		i2c13 = &i2c6_slave;

		i2c14 = &i2c7_master;
		i2c15 = &i2c7_slave;

		i2c16 = &i2c8_master;
		i2c17 = &i2c8_slave;

		i2c18 = &i2c9_master;
		i2c19 = &i2c9_slave;

		i2c20 = &i2c10_master;
		i2c21 = &i2c10_slave;

		i2c22 = &i2c11_master;
		i2c23 = &i2c11_slave;

		i2c24 = &i2c12_master;
		i2c25 = &i2c12_slave;

		i2c26 = &i2c13_master;
		i2c27 = &i2c13_slave;

		i2c28 = &i2c14_master;
		i2c29 = &i2c14_slave;

		i2c30 = &i2c15_master;
		i2c31 = &i2c15_slave;

		i2c32 = &i3c0;
		i2c33 = &i3c1;
		i2c34 = &i3c2;
		i2c35 = &i3c3;
		i2c36 = &i3c4;
		i2c37 = &i3c5;
		i2c38 = &i3c6;
		i2c39 = &i3c7;
		i2c40 = &i3c8;
		i2c41 = &i3c9;
		i2c42 = &i3c10;
		i2c43 = &i3c11;
		i2c44 = &i3c12;
		i2c45 = &i3c13;
		i2c46 = &i3c14;
		i2c47 = &i3c15;

		i3c0 = &i3c0;
		i3c1 = &i3c1;
		i3c2 = &i3c2;
		i3c3 = &i3c3;
		i3c4 = &i3c4;
		i3c5 = &i3c5;
		i3c6 = &i3c6;
		i3c7 = &i3c7;
		i3c8 = &i3c8;
		i3c9 = &i3c9;
		i3c10 = &i3c10;
		i3c11 = &i3c11;
		i3c12 = &i3c12;
		i3c13 = &i3c13;
		i3c14 = &i3c14;
		i3c15 = &i3c15;

		mctp_pcie0 = &pcie0_mctp;
		mctp_pcie1 = &pcie1_mctp;
		mctp_pcie2 = &pcierp_mctp;

		peci0 = &peci0;
		peci4 = &peci1;

		spi0 = &sfc0;
		spi1 = &sfc1;
		spi2 = &sfc2;
		spi3 = &spi0;
	};

	cpus {
		timebase-frequency = <5000000>;
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;	/* 2GB */
	};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		#include "jhb100-reserved-mem.dtsi"
		#include "jhb100-evb3-extend-reserved-mem.dtsi"
	};

	vcc_1v8: regulator-vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
};

&dc0_clk {
	single-node = <1>;
	status = "okay";
};

&dc1_clk {
	single-node = <0>;
	status = "okay";
};

&dma_i2c {
	status = "disabled";
};

&dma_i3c {
	status = "okay";
};

&dma_sfc0 {
	status = "okay";
};

&dma_sfc1 {
	status = "okay";
};

&dma_sfc2 {
	status = "okay";
};

&dma_spi0 {
	status = "okay";
};

&dma_system {
	status = "okay";
};

&dma_uart {
	status = "okay";
};

&dp {
	status = "okay";
};

&emmc0 {
	mmc-hs400-1_8v;
	max-frequency = <200000000>;
	non-removable;
	status = "okay";
};

&espi0 {
	starfive,flash-mtd-device = "bios-image0";
	starfive,host-src-addr = /bits/ 64 <0xf6810000>;
	perif-memcyc-size = <0x400000>;
	memory-region = <&espi0_mmbi_buffer_uncache>,
			<&espi0_perif_mem_uncache>,
			<&espi0_vw_mem_uncache>;

	starfive,bt-remap-num = <2>;
	starfive,kcs-remap-num = <4>;
	starfive,uart-remap-num = <2>;
	starfive,bt-io-addr = /bits/ 32 <0xe4 0xf4>;
	starfive,kcs-io-addr = /bits/ 32 <0xca2 0xcb2 0xcc2 0xcd2>;
	starfive,uart-io-addr = /bits/ 32 <0x3f8 0x410>;
	starfive,wdi-io-addr = /bits/ 32 <0xa00>;
	starfive,mbox-io-addr = /bits/ 32 <0x300>;

	starfive,vgpio_dir_bits = /bits/ 64 <0xffffffff00000000 0x0000000000000000>;
	starfive,vgpio_lvl_bits = /bits/ 64 <0x0000000000000000 0x0000000000000000>;
	starfive,vgpio_phy_bits = /bits/ 64 <0x0000000f0000000f 0x0000000000000000>;

	status = "okay";
};

&espi0_mmbi {
	mmbi-id = /bits/ 8 <0>;
	mmbi-instance-num = /bits/ 32 <1>;
	mmbi-instance-size = /bits/ 32 <0x10000>;
	mmbi-src-addr-offset = /bits/ 32 <0x10000>;
	mmbi-osuse = /bits/ 8 <0 0 0 0 0 0 0 0>;
	memory-region = <&espi0_mmbi_buffer_uncache>;
	status = "okay";
};

&espi1 {
	starfive,flash-mtd-device = "bios-image1";
	starfive,host-src-addr = /bits/ 64 <0xf6810000>;
	perif-memcyc-size = <0x400000>;
	memory-region = <&espi1_mmbi_buffer_uncache>,
			<&espi1_perif_mem_uncache>,
			<&espi1_vw_mem_uncache>;

	starfive,bt-remap-num = <2>;
	starfive,kcs-remap-num = <4>;
	starfive,uart-remap-num = <2>;
	starfive,bt-io-addr = /bits/ 32 <0xe4 0xf4>;
	starfive,kcs-io-addr = /bits/ 32 <0xca2 0xcb2 0xcc2 0xcd2>;
	starfive,uart-io-addr = /bits/ 32 <0x3f8 0x410>;
	starfive,wdi-io-addr = /bits/ 32 <0xa00>;
	starfive,mbox-io-addr = /bits/ 32 <0x300>;

	starfive,vgpio_dir_bits = /bits/ 64 <0xffffffff00000000 0x0000000000000000>;
	starfive,vgpio_lvl_bits = /bits/ 64 <0x0000000000000000 0x0000000000000000>;
	starfive,vgpio_phy_bits = /bits/ 64 <0x0000000f0000000f 0x0000000000000000>;

	status = "okay";
};

&espi1_mmbi {
	mmbi-id = /bits/ 8 <1>;
	mmbi-instance-num = /bits/ 32 <1>;
	mmbi-instance-size = /bits/ 32 <0x10000>;
	mmbi-src-addr-offset = /bits/ 32 <0x10000>;
	mmbi-osuse = /bits/ 8 <0 0 0 0 0 0 0 0>;
	memory-region = <&espi1_mmbi_buffer_uncache>;
	status = "okay";
};

&gmac0 {
	assigned-clocks = <&per3crg JHB100_PER3CLK_GMAC0_RMII_MUX>;
	assigned-clock-parents = <&per3_gmac0_rmii_rclki>;
	pinctrl-names = "default";
	mac-mode = "rmii";
	snps,use-ncsi;
	snps,ps-speed = <100>;
	pinctrl-0 = <&gmac0_rmii_pins>;
	status = "okay";
};

&gmac1 {
	phy-handle = <&phy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_mdio_pins>;
	snps,ps-speed = <1000>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		phy1: ethernet-phy@0 {
			reg = <0>;
			motorcomm,clk-out-frequency-hz = <25000000>;
		};
	};
};

&gmac2 {
	assigned-clocks = <&per2crg JHB100_PER2CLK_GMAC2_RMII_MUX_DLY>,
			  <&per2crg JHB100_PER2CLK_GMAC2_TX_MUX>,
			  <&per2crg JHB100_PER2CLK_GMAC2_RX_MUX_DLY>,
			  <&per2crg JHB100_PER2CLK_GMAC2_TXCK_MUX_DLY>;
	assigned-clock-parents = <&per2crg JHB100_PER2CLK_GMAC2_RMII_50>,
				 <&per2crg JHB100_PER2CLK_GMAC2_RMII_DIV>,
				 <&per2crg JHB100_PER2CLK_GMAC2_RMII_DIV>,
				 <&per2crg JHB100_PER2CLK_GMAC2_RMII_50>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac2_rmii_pins>;
	mac-mode = "rmii";
	snps,use-ncsi;
	snps,ps-speed = <100>;
	status = "okay";
};

