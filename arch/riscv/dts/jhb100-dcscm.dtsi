&sio0 {
	status = "okay";

	sio0_bt0: bt@0 {
		bt_chan = <0>;
		status = "okay";
	};

	sio0_bt1: bt@100 {
		bt_chan = <1>;
		status = "okay";
	};

	sio0_kcs0: kcs@200 {
		kcs_chan = <0>;
		status = "okay";
	};

	sio0_kcs1: kcs@300 {
		kcs_chan = <1>;
		status = "okay";
	};

	sio0_kcs2: kcs@400 {
		kcs_chan = <2>;
		status = "okay";
	};

	sio0_kcs3: kcs@500 {
		kcs_chan = <3>;
		status = "okay";
	};

	sio0_mbox: mbox@600 {
		status = "okay";
	};

	sio0_pcc: pcc@800 {
		starfive,pcc-threshold = <0>;
		status = "okay";
	};

	sio0_wdi: wdi@900 {
		status = "okay";
	};
};

&sio1 {
	status = "okay";

	sio1_bt0: bt@0 {
		bt_chan = <2>;
		status = "okay";
	};

	sio1_bt1: bt@100 {
		bt_chan = <3>;
		status = "okay";
	};

	sio1_kcs0: kcs@200 {
		kcs_chan = <4>;
		status = "okay";
	};

	sio1_kcs1: kcs@300 {
		kcs_chan = <5>;
		status = "okay";
	};

	sio1_kcs2: kcs@400 {
		kcs_chan = <6>;
		status = "okay";
	};

	sio1_kcs3: kcs@500 {
		kcs_chan = <7>;
		status = "okay";
	};

	sio1_mbox: mbox@600 {
		status = "okay";
	};

	sio1_pcc: pcc@800 {
		starfive,pcc-threshold = <0>;
		status = "okay";
	};

	sio1_wdi: wdi@900 {
		status = "okay";
	};
};

&sol5 {
	memory-region = <&sol_tx_mem_uncache>,
			<&sol_rx_mem_uncache>;
	tx-size = <3>;
	rx-size = <3>;
	dev-id = <5>;
	status = "okay";
};

&sol6 {
	memory-region = <&sol_tx_mem_uncache>,
			<&sol_rx_mem_uncache>;
	tx-size = <3>;
	rx-size = <3>;
	dev-id = <6>;
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&uart5 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_pins>;
};

&uart6 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-names = "default";
	pinctrl-0 = <&uart6_pins>;
};

&uart_routing {
	status = "okay";
};

&usb1 {
	status = "okay";
};

&vga {
	status = "okay";
};

&voutcrg {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&wdt1 {
	status = "disabled";
};

&wdt2 {
	status = "disabled";
};

&wdt3 {
	status = "disabled";
};

&led0 {
	status = "okay";
};

&vce0 {
	memory-region = <&pcie0_media_mem_uncache>;
	status = "okay";
};

&vce1 {
	memory-region = <&pcie1_media_mem_uncache>;
	status = "okay";
};
