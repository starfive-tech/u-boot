&ltpi0 {
	uart-channels = <&uart_routing>;
	uart-max-baudrate = /bits/ 32 <115200>;
	data-sup;
	ddr-sup;
	status = "okay";
};

&ltpi1 {
	uart-channels = <&uart_routing>;
	uart-max-baudrate = /bits/ 32 <115200>;
	data-sup;
	ddr-sup;
