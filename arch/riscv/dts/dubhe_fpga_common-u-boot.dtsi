/ {

	aliases {
		spi0 = &qspi1;
	};

	chosen {
		stdout-path = "serial0";
		bootph-pre-ram;
	};

	config {
		u-boot,spl-payload-offset = <0x42000>;
		bootph-pre-ram;
	};

	cpus {
		bootph-pre-ram;
		cpu@0 {
			bootph-pre-ram;
		};

		cpu@1 {
			bootph-pre-ram;
		};

		cpu@2 {
			bootph-pre-ram;
		};

		cpu@3 {
			bootph-pre-ram;
		};
	};

	memory@80000000 {
		bootph-pre-ram;
	};

	soc {
		bootph-pre-ram;
		dmc: dmc@10280000 {
			compatible = "starfive,dubhe-ddr";
			reg = <0x0 0x10280000 0x0 0x10000
			       0x0 0x10290000 0x0 0x10000
			       0x0 0x102A0000 0x0 0x10000>;
			clocks = <&pbus_clk>;
			clock-frequency = <25000000>;
			bootph-pre-ram;
		};
	};

	binman: binman	{
		multiple-images;

		uboot_fit {
			filename = "u-boot.itb";

			fit {
				description = "Configuration to load OpenSBI before U-Boot";
				#address-cells = <1>;
				fit,fdt-list = "of-list";

				images {
					uboot {
						description = "U-Boot";
						type = "standalone";
						os = "U-Boot";
						arch = "riscv";
						compression = "none";
						load = <CONFIG_TEXT_BASE>;

						uboot_blob: blob-ext {
							filename = "u-boot-nodtb.bin";
						};
					};

					opensbi {
						description = "OpenSBI fw_dynamic Firmware";
						type = "firmware";
						os = "opensbi";
						arch = "riscv";
						compression = "none";
						load = <CONFIG_SPL_OPENSBI_LOAD_ADDR>;
						entry = <CONFIG_SPL_OPENSBI_LOAD_ADDR>;

						opensbi_blob: opensbi {
							filename = "fw_dynamic.bin";
						};
					};

					fdt-90 {
						description = "U-Boot proper device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						fdt_90_blob: blob-ext {
							filename = "arch/riscv/dts/dubhe90_fpga.dtb";
						};
					};

					fdt-83 {
						description = "U-Boot proper device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						fdt_83_blob: blob-ext {
							filename = "arch/riscv/dts/dubhe83_fpga.dtb";
						};
					};

					fdt-80 {
						description = "U-Boot proper device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						fdt_80_blob: blob-ext {
							filename = "arch/riscv/dts/dubhe80_fpga.dtb";
						};
					};

					fdt-70 {
						description = "U-Boot proper device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						fdt_70_blob: blob-ext {
							filename = "arch/riscv/dts/dubhe70_fpga.dtb";
						};
					};

					fdt-70a {
						description = "U-Boot proper device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						fdt_70a_blob: blob-ext {
							filename = "arch/riscv/dts/dubhe70a_fpga.dtbo";
						};
					};

					fdt-70s {
						description = "U-Boot proper device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						fdt_70s_blob: blob-ext {
							filename = "arch/riscv/dts/dubhe70s_fpga.dtbo";
						};
					};
				};

				configurations {
					default = "conf-90";
					conf-90 {
						description = "conf-90";
						firmware = "opensbi";
						loadables = "uboot";
						fdt = "fdt-90";
					};

					conf-83 {
						description = "conf-83";
						firmware = "opensbi";
						loadables = "uboot";
						fdt = "fdt-83";
					};

					conf-80 {
						description = "conf-80";
						firmware = "opensbi";
						loadables = "uboot";
						fdt = "fdt-80";
					};

					conf-70a {
						description = "conf-70a";
						firmware = "opensbi";
						loadables = "uboot";
						fdt = "fdt-70", "fdt-70a";
					};

					conf-70s {
						description = "conf-70s";
						firmware = "opensbi";
						loadables = "uboot";
						fdt = "fdt-70", "fdt-70s";
					};
				};
			};
		};

		kernel_fit {
			filename = "kernel.itb";

			fit {
				description = "FIT with Linux kernel image, FDT";
				#address-cells = <1>;
				images {
					kernel {
						description = "Linux kernel";
						type = "kernel";
						arch = "riscv";
						os = "linux";
						compression = "none";
						load = /bits/ 64 <0xa1000000>;
						entry = /bits/ 64 <0xa1000000>;
						kernel_blob: blob-ext {
							filename = "Image";
						};
					};

					kernel-fdt-90 {
						description = "Linux kernel device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						load = /bits/ 64 <0xa0000000>;
						kernel_fdt_90_blob: blob-ext {
							filename = "dubhe90_fpga.dtb";
						};
					};

					kernel-fdt-83 {
						description = "Linux kernel device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						load = /bits/ 64 <0xa0000000>;
						kernel_fdt_83_blob: blob-ext {
							filename = "dubhe83_fpga.dtb";
						};
					};

					kernel-fdt-80 {
						description = "Linux kernel device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						load = /bits/ 64 <0xa0000000>;
						kernel_fdt_80_blob: blob-ext {
							filename = "dubhe80_fpga.dtb";
						};
					};

					kernel-fdt-70 {
						description = "Linux kernel device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						load = /bits/ 64 <0xa0000000>;
						kernel_fdt_70_blob: blob-ext {
							filename = "dubhe70_fpga.dtb";
						};
					};

					kernel-fdt-70a {
						description = "Linux kernel device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						load = /bits/ 64 <0xa0010000>;
						kernel_fdt_70a_blob: blob-ext {
							filename = "dubhe70a_fpga.dtbo";
						};
					};

					kernel-fdt-70s {
						description = "Linux kernel device tree binary";
						type = "flat_dt";
						arch = "riscv";
						compression = "none";
						load = /bits/ 64 <0xa0010000>;
						kernel_fdt_70s_blob: blob-ext {
							filename = "dubhe70s_fpga.dtbo";
						};
					};
				};

				configurations {
					default = "dubhe-90";
					dubhe-90 {
						description = "Starfive Dubhe-90 FPGA";
						kernel = "kernel";
						fdt = "kernel-fdt-90";
					};

					dubhe-83 {
						description = "Starfive Dubhe-83 FPGA";
						kernel = "kernel";
						fdt = "kernel-fdt-83";
					};

					dubhe-80 {
						description = "Starfive Dubhe-80 FPGA";
						kernel = "kernel";
						fdt = "kernel-fdt-80";
					};

					dubhe-70a {
						description = "Starfive Dubhe-70 AXI FPGA";
						kernel = "kernel";
						fdt = "kernel-fdt-70", "kernel-fdt-70a";
					};

					dubhe-70s {
						description = "Starfive Dubhe-70 StarLink FPGA";
						kernel = "kernel";
						fdt = "kernel-fdt-70", "kernel-fdt-70s";
					};
				};
			};
		};
	};
};

&clint {
	clocks = <&pbus_clk>;
	bootph-pre-ram;
};

&gmac0 {
	mac-address = [de ad be ef de ad];
};

&pbus_clk {
	bootph-pre-ram;
};

&plic0 {
	bootph-pre-ram;
};

&spi0 {
	bootph-pre-ram;

	mmc@0 {
		bootph-pre-ram;
	};
};

&qspi1 {
	bootph-pre-ram;

	flash@0 {
		bootph-pre-ram;
	};
};

&uart0 {
	bootph-pre-ram;
};

&pbus_clk {
	bootph-pre-ram;
};

&cpu0_intc {
	bootph-pre-ram;
};

&cpu1_intc {
	bootph-pre-ram;
};

&cpu2_intc {
	bootph-pre-ram;
};

&cpu3_intc {
	bootph-pre-ram;
};

