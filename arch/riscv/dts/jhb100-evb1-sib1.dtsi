&dma_i3c {
	status = "disabled";
};

&espi0 {
	status = "okay";
};

&i2c1_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c2_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c3_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c4_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c6_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c7_master {
	clock-frequency = <100000>;
	status = "okay";

	ipmb@10 {
		compatible = "ipmb-dev";
		reg = <0x10>;
		i2c-protocol;
		slave-dev = <&i2c7_slave>;
	};
};

&i2c7_slave {
	clock-frequency = <100000>;
	status = "okay";
};

&i2c8_master {
	clock-frequency = <100000>;
	status = "okay";

	pmbus@58 {
		compatible = "pmbus";
		reg = <0x58>;
	};
};

&i2c9_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c10_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i2c11_master {
	clock-frequency = <100000>;
	status = "disabled";
};

&i3c0 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	i3c-od-scl-high-ns = <1000>;
	i3c-od-scl-low-ns = <1500>;
	i3c-pp-scl-high-ns = <60>;
	i3c-pp-scl-low-ns = <100>;
	master-sda-tx-hold = <3>;
	master-sda-pp-od-switch-dly = <1>;
	master-sda-od-pp-switch-dly = <1>;
	master-stop-hold-cnt = <0xf>;
	is-mng;
	status = "okay";
	#address-cells = <3>;
	#size-cells = <0>;

	hub@0,4cd00000000 {
		compatible = "renesas,i3chub-rg3mxxb12b1";
		reg = <0x0 0x4cd 0x0>;
		cp0-ldo-en = "disabled";
		cp1-ldo-en = "disabled";
		cp0-ldo-volt = "1.0V";
		cp1-ldo-volt = "1.0V";
		tp0145-ldo-en = "disabled";
		tp2367-ldo-en = "disabled";
		tp0145-ldo-volt = "1.0V";
		tp2367-ldo-volt = "1.0V";
		tp0145-pullup = "2k";
		tp2367-pullup = "2k";
		tp0145-io-strength = "50Ohms";
		tp2367-io-strength = "50Ohms";

		target-port@0 {
			mode = "i3c";
			pullup = "enabled";
		};
		target-port@1 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@2 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@3 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@4 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@5 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@6 {
			mode = "disabled";
			pullup = "disabled";
		};
		target-port@7 {
			mode = "disabled";
			pullup = "disabled";
		};
	};
};

&i3c1 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	hotjoin;
	status = "disabled";
};

&i3c2 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <12500000>;
	mode = "master";
	hotjoin;
	status = "disabled";
};

&i3c12 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <1000000>;
	mode = "master";
	hotjoin;
	status = "disabled";
};

&i3c13 {
	i2c-scl-hz = <400000>;
	i3c-scl-hz = <1000000>;
	mode = "master";
	hotjoin;
	status = "disabled";
};

&jtag1 {
	status = "okay";
};

&peci0 {
	status = "okay";
};

&peci1 {
	status = "disabled";
};

&pinctrl_adc0 {
	smbus8_alt_a_pins: smbus8_alt_a-grp {
		smbus8_alt_a-pins {
			input-enable;
		};
	};
};

&sgpio0 {
	status = "okay";

	/* SGPIO lines: Each IO number in pairs (input, output) */
	gpio-line-names =
	/* 0-1 */	"CPU1_PRESENCE", "P80_DOUT0", "CPU1_THERMTRIP", "P80_DOUT1",
	/* 2-3 */	"CPU1_VRHOT", "P80_DOUT2", "H_CPU0_MON_FAIL_LVC1_N", "P80_DOUT3",
	/* 4-5 */	"CPU1_MEM_VRHOT", "P80_DOUT4", "CPU1_MEM_THERM_EVENT", "P80_DOUT5",
	/* 6-7 */	"FM_CPU0_PROC_ID0", "P80_DOUT6", "FM_CPU0_PROC_ID1", "P80_DOUT7",
	/* 8-9 */	"CPU1_MISMATCH", "LED_CPU1_CH1_DIMM1_FAULT", "", "LED_CPU1_CH1_DIMM2_FAULT",
	/* 10-11 */	"CPU2_PRESENCE", "LED_CPU1_CH2_DIMM1_FAULT", "CPU2_THERMTRIP", "LED_CPU1_CH2_DIMM2_FAULT",
	/* 12-13 */	"CPU2_VRHOT", "LED_CPU1_CH3_DIMM1_FAULT", "H_CPU1_MON_FAIL_LVC1_N", "LED_CPU1_CH3_DIMM2_FAULT",
	/* 14-15 */	"CPU2_MEM_VRHOT", "LED_CPU1_CH4_DIMM1_FAULT", "CPU2_MEM_THERM_EVENT", "LED_CPU1_CH4_DIMM2_FAULT",
	/* 16-17 */	"FM_CPU1_PROC_ID0", "LED_CPU1_CH5_DIMM1_FAULT", "FM_CPU1_PROC_ID1", "LED_CPU1_CH5_DIMM2_FAULT",
	/* 18-19 */	"CPU2_MISMATCH", "LED_CPU1_CH6_DIMM1_FAULT", "", "LED_CPU1_CH6_DIMM2_FAULT",
	/* 20-21 */	"", "LED_FAN1_FAULT", "", "LED_FAN2_FAULT",
	/* 22-23 */	"", "LED_FAN3_FAULT", "", "LED_FAN4_FAULT",
	/* 24-25 */	"", "LED_FAN5_FAULT", "", "LED_FAN6_FAULT",
	/* 26-27 */	"", "LED_FAN7_FAULT", "", "LED_FAN8_FAULT",
	/* 28-29 */	"", "LED_CPU2_CH1_DIMM1_FAULT", "", "LED_CPU2_CH1_DIMM2_FAULT",
	/* 30-31 */	"", "LED_CPU2_CH2_DIMM1_FAULT", "", "LED_CPU2_CH2_DIMM2_FAULT",
	/* 32-33 */	"", "LED_CPU2_CH3_DIMM1_FAULT", "", "LED_CPU2_CH3_DIMM2_FAULT",
