	/* 96-97 */	"", "FM_SURPRISE_RESET_N", "", "FM_CPU1_INTR_CLK_CONFDONE_N",
	/* 98-99 */	"", "FM_GLOBAL_RESET_N", "FM_1200VA_OC", "BMC_BOOT_DONE",
