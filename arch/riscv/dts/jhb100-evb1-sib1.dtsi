	/* 40-41 */	"CPU2_CPLD_CRC_ERROR", "", "CPU1_CATERR_IERR", "",
	/* 42-43 */	"CPU1_CATERR_MCERR", "", "CPU2_CATERR_IERR", "",
	/* 44-45 */	"CPU2_CATERR_MCERR", "", "", "",
	/* 46-47 */	"", "", "", "",
	/* 48-49 */	"MAIN_PLD_MINOR_REV_BIT0", "", "MAIN_PLD_MINOR_REV_BIT1", "",
	/* 50-51 */	"MAIN_PLD_MINOR_REV_BIT2", "", "MAIN_PLD_MINOR_REV_BIT3", "",
	/* 52-53 */	"MAIN_PLD_MAJOR_REV_BIT0", "", "MAIN_PLD_MAJOR_REV_BIT1", "",
