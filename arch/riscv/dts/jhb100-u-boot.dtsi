&pinctrl_sys0 {
	bootph-pre-ram;
};

&pinctrl_sys1 {
	bootph-pre-ram;
};

&pinctrl_sys2 {
	gpiow-vsel = <JHB100_VREF_3_3V>;
	bootph-pre-ram;
	bootph-some-ram;

	uart6_pins: uart6-grp {
		bootph-pre-ram;
		bootph-some-ram;

		uart6_tx-pins {
			drive-strength = <12>;
			bootph-pre-ram;
			bootph-some-ram;
		};

		uart6_rx-pins {
			drive-strength = <12>;
			bootph-pre-ram;
			bootph-some-ram;
		};
	};
};

