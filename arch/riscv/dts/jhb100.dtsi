				resets = <&per1crg JHB100_PER1RST_IOMUX_PRESETN>;
				interrupts = <61>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_bmcperiph1 0 0 36>;
			};

			pinctrl_bmcperiph2: pinctrl@11bc2000 {
				compatible = "starfive,jhb100-sys-pinctrl-bmcperiph2";
				reg = <0x0 0x11bc2000 0x0 0x400>;
				resets = <&per2crg JHB100_PER2RST_IOMUX_PRESETN>;
				interrupts = <62>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_bmcperiph2 0 0 31>;
			};

			can0: can@11be1100 {
				compatible = "ipms,can";
				reg = <0x0 0x11be1100 0x0 0x400>;
				interrupts = <143>;
				clocks = <&per2crg JHB100_PER2CLK_CAN0_CORE_DIV>,
					<&per2crg JHB100_PER2CLK_MAIN_ICG_EN_CAN0>;
				clock-names = "core_clk", "main_clk";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_CAN0>;
				status = "disabled";
			};

			can1: can@11be1200 {
				compatible = "ipms,can";
				reg = <0x0 0x11be1200 0x0 0x400>;
				interrupts = <144>;
				clocks = <&per2crg JHB100_PER2CLK_CAN1_CORE_DIV>,
					<&per2crg JHB100_PER2CLK_MAIN_ICG_EN_CAN1>;
				clock-names = "core_clk", "main_clk";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_CAN1>;
				status = "disabled";
			};

			rtc: rtc@11be1300 {
				compatible = "starfive,jhb100-rtc", "starfive,jh7110-rtc";
				reg = <0x0 0x11be1300 0x0 0x100>;
				interrupts = <142>;
				interrupt-names = "rtc";
				clocks = <&rtc_apb>, <&osc>;
				clock-names = "pclk", "cal_clk";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_RTC>;
				rtc,cal-clock-freq = <1000000>;
				status = "disabled";
			};

			adc0: saradc@11be1400 {
				compatible = "starfive,jhb100-saradc";
				reg = <0x0 0x11be1400 0x0 0x400>;
				interrupts = <145>;
				clocks = <&per2crg JHB100_PER2CLK_MAIN_ICG_EN_ADC0>;
				resets = <&per2crg JHB100_PER2RST_ADC0_PRESETN>;
				#io-channel-cells = <1>;
				upper-bound = <0xfff>;
				lower-bound = <0>;
				/* Cycle time = (scan-freq + 5) * 10 ns, minimum scan-freq is 15 */
				scan-freq = <20>;
				status = "disabled";
			};

			adc1: saradc@11be1800 {
				compatible = "starfive,jhb100-saradc";
				reg = <0x0 0x11be1800 0x0 0x400>;
				interrupts = <146>;
				clocks = <&per2crg JHB100_PER2CLK_MAIN_ICG_EN_ADC1>;
				resets = <&per2crg JHB100_PER2RST_ADC1_PRESETN>;
				#io-channel-cells = <1>;
				upper-bound = <0xfff>;
				lower-bound = <0>;
				/* Cycle time = (scan-freq + 5) * 10 ns, minimum scan-freq is 15 */
				scan-freq = <20>;
				status = "disabled";
			};

			pinctrl_bmcperiph3: pinctrl@11c42000 {
				compatible = "starfive,jhb100-sys-pinctrl-bmcperiph3";
				reg = <0x0 0x11c42000 0x0 0x1000>;
				resets = <&per3crg JHB100_PER3RST_IOMUX_PRESETN>;
				interrupts = <64>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_bmcperiph3 0 0 11>;
			};

			peci0: peci-controller@11c60000 {
				compatible = "starfive,jhb100-peci";
				reg = <0x0 0x11c60000 0x0 0x400>;
				interrupts = <222>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_PECI0>;
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_PECI0>;
				cmd-timeout-ms = <1000>;
				status = "disabled";
			};

			peci1: peci-controller@11c60400 {
				compatible = "starfive,jhb100-peci";
				reg = <0x0 0x11c60400 0x0 0x400>;
				interrupts = <223>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_PECI1>;
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_PECI1>;
				cmd-timeout-ms = <1000>;
				status = "disabled";
			};

			hwspinlock: hwspinlock@13012000 {
				compatible = "starfive,jhb100-hwspinlock";
				reg = <0x0 0x13012000 0x0 0x100>;
				/* clocks = <>; */
				/* resets = <>; */
				#hwlock-cells = <1>;
				status = "disabled";
			};

			pvt_sys: pvt@13020000 {
				compatible = "moortec,mr75203";
				reg = <0x0 0x13020000 0x0 0x80>,
				      <0x0 0x13020080 0x0 0x80>,
				      <0x0 0x13020100 0x0 0x80>;
				reg-names = "common", "ts", "pd";
				clocks = <&pvt_aon>;
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			pinctrl_sys0: pinctrl@13080000 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys0";
				reg = <0x0 0x13080000 0x0 0x800>;
				resets = <&syscrg JHB100_SYSRST_SYS0_IOMUX_PRESETN>;
				interrupts = <56>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys0 0 0 4>;
			};

			pinctrl_sys0h: pinctrl@13080800 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys0h";
				reg = <0x0 0x13080800 0x0 0x800>;
				resets = <&syscrg JHB100_SYSRST_SYS0H_IOMUX_PRESETN>;
				interrupts = <57>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys0h 0 0 12>;
			};

			pinctrl_sys1: pinctrl@13081000 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys1";
				reg = <0x0 0x13081000 0x0 0x1000>;
				resets = <&sys1crg JHB100_SYS1RST_SYS1_IOMUX_PRESETN>;
				interrupts = <58>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys1 0 0 8>;
			};

			pinctrl_sys2: pinctrl@13082000 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys2";
				reg = <0x0 0x13082000 0x0 0x1000>;
				interrupts = <59>;
				interrupt-controller;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys2 0 0 37>;
			};

			jtag0: jtag-master@130c0000 {
				compatible = "starfive,jhb100-jtag";
				reg = <0x0 0x130c0000 0x0 0x800>;
				clocks = <&sys2crg JHB100_SYS2CLK_MAIN_ICG_EN_JTAG0>;
				resets = <&sys2crg JHB100_SYS2RST_JTAG0_MST_WRAP_HRESETN>,
					<&sys2crg JHB100_SYS2RST_JTAG0_MST_WRAP_APB_PRESETN>;
				status = "disabled";
			};

			jtag1: jtag-master@130c0800 {
				compatible = "starfive,jhb100-jtag";
				reg = <0x0 0x130c0800 0x0 0x800>;
				clocks = <&sys2crg JHB100_SYS2CLK_MAIN_ICG_EN_JTAG1>;
				resets = <&sys2crg JHB100_SYS2RST_JTAG1_MST_WRAP_HRESETN>,
					<&sys2crg JHB100_SYS2RST_JTAG1_MST_WRAP_APB_PRESETN>;
				status = "disabled";
			};

			reri0: reri0@130e0000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e0000 0x0 0x1000>;
				interrupts-extended = <&plic 79>, <&intc 0>;
				interrupt-names = "hp", "lp";
				bank-name = "DDRSS";
				bank-desc = "Port 0 Read SRAM ECC",
					    "Port 1 Read SRAM ECC",
					    "Port 2 Read SRAM ECC",
					    "Port 3 Read SRAM ECC",
					    "PCIE Phy SRAM";
				status = "disabled";
			};

			reri1: reri1@130e1000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e1000 0x0 0x1000>;
				interrupts-extended = <&plic 80>, <&intc 1>;
				interrupt-names = "hp", "lp";
				bank-name = "BMCPCIeRP";
				bank-desc = "PCIE AXI mstr write",
					    "PCIE AXI mstr read",
					    "PCIE AXI slv write",
					    "PCIE AXI slv read",
					    "PCIE Phy SRAM",
					    "MCTP SRAM";
				status = "disabled";
			};

			reri2: reri2@130e2000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e2000 0x0 0x1000>;
				interrupts-extended = <&plic 81>, <&intc 2>;
				interrupt-names = "hp", "lp";
				bank-name = "BMCPeriph1";
				bank-desc = "UFS Phy SRAM";
				status = "disabled";
			};

			reri3: reri3@130e3000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e3000 0x0 0x1000>;
				interrupts-extended = <&plic 82>, <&intc 3>;
				interrupt-names = "hp", "lp";
				bank-name = "HOSTSS0";
				bank-desc = "PCIE AXI mstr write",
					    "PCIE AXI mstr read",
					    "PCIE AXI slv write",
					    "PCIE AXI slv read",
					    "PCIE Phy SRAM Ecc",
					    "MCTP SRAM ECC";
				status = "disabled";
			};

			reri4: reri3@130e4000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e4000 0x0 0x1000>;
				interrupts-extended = <&plic 83>, <&intc 4>;
				interrupt-names = "hp", "lp";
				bank-name = "HOSTSS1";
				bank-desc = "PCIE AXI mstr write",
					    "PCIE AXI mstr read",
					    "PCIE AXI slv write",
					    "PCIE AXI slv read",
					    "PCIE Phy SRAM Ecc",
					    "MCTP SRAM ECC";
				status = "disabled";
			};

			pvt_ddr: pvt@13100000 {
				compatible = "moortec,mr75203";
				reg = <0x0 0x13100000 0x0 0x80>,
				      <0x0 0x13100080 0x0 0x80>,
				      <0x0 0x13100100 0x0 0x80>;
				reg-names = "common", "ts", "pd";
				clocks = <&pvt_aon>;
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			l3_pmu: pmu@13216000 {
				compatible = "starfive,jhb100-starlink-pmu", "starfive,jh8100-starlink-pmu";
				reg = <0x0 0x13216000 0x0 0x10000>;
				interrupts = <11>, <10>, <12>;
				interrupt-names = "pmu", "llc_irq", "ecc_irq";
			};

			ddrc_edac: ddr_controller_edac@16100000 {
				compatible = "starfive,jhb100-ddrc";
				reg = <0x0 0x16100000 0x0 0x100000>;
				interrupts = <70>;
				status = "disabled";
			};

			intc: interrupt-controller@13220000 {
				compatible = "starfive,jhb100-intc";
				reg = <0x0 0x13220000 0x0 0x80>;
				clocks = <&cpucrg JHB100_CPUCLK_MAIN_ICG_EN_INT_CTRL>;
				resets = <&cpucrg JHB100_CPURST_MAIN_RSTN_INT_CTRL>;
				interrupts = <1>;
				interrupt-controller;
				#interrupt-cells = <1>;
			};

			sfc1: spi@17f00000  {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x17f00000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <112>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC1>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC1>;
				reset-names = "spi";
				num-cs = <3>;
				status = "disabled";
			};

			sfc2: spi@17f10000  {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x17f10000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <113>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC2>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC2>;
				reset-names = "spi";
				num-cs = <2>;
				status = "disabled";
			};

			spi0: spi@17f20000 {
				compatible = "starfive,jhb100-spi";
				reg = <0x0 0x17f20000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <110>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SPI0>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SPI0>;
				reset-names = "spi";
				num-cs = <2>;
				status = "disabled";
			};

			sfc0: spi@18000000 {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x18000000 0x0 0x8000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <111>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC0>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC0>;
				reset-names = "spi";
				num-cs = <2>;
				dmas = <&dma_sfc0 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};
		};

		bus_ioc: bus_ioc {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-coherent;
			ranges;

			stmmac_axi_setup: stmmac-axi-config {
				snps,wr_osr_lmt = <0xf>;
				snps,rd_osr_lmt = <0xf>;
				snps,blen = <256 128 64 32 0 0 0>;
			};

			gmac2: ethernet@11b80000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11b80000 0x0 0x4000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_ACLK_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_CSR_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_PTP_REF_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_TX_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_TX_180_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_RX_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_RX_180_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_RMII_I>;
				clock-names = "stmmaceth", "pclk", "ptp_ref",
					"tx", "gtx", "rx", "grx", "rmii";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_GMAC2>;
				interrupts = <140>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <64>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <4>;
				snps,rxpbl = <4>;
				status = "disabled";
			};

			gmac3: ethernet@11b84000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11b84000 0x0 0x4000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER1_SGMII_ACLK_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_CSR_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_PTP_REF_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_TX_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_TX_125_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_RX_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_RX_125_I>;
				clock-names = "stmmaceth", "pclk", "ptp_ref",
					"tx", "gtx", "rx", "grx";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_GMAC3>;
				interrupts = <141>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <64>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <4>;
				snps,rxpbl = <4>;
				status = "disabled";
			};

			gmac0: ethernet@11c00000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11c00000 0x0 0x4000>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_GMAC0>;
				clock-names = "pclk";
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_GMAC0>;
				interrupts = <224>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <64>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <4>;
				snps,rxpbl = <4>;
				status = "disabled";
			};

			gmac1: ethernet@11c04000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11c04000 0x0 0x4000>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_GMAC1>;
				clock-names = "pclk";
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_GMAC1>;
				interrupts = <225>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <64>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <4>;
				snps,rxpbl = <4>;
				status = "disabled";
			};
		};
	};
};
