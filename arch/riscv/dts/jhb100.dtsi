				resets = <&pcierpcrg JHB100_PCIERPRST_MAIN_RSTN_MCTP_PCIERP>;
				starfive,pcie-ecsr = <&pcie_rp_ecsr>;
				starfive,rx-packet-count = <64>;
				starfive,rx-ring-count = <64>;
				starfive,tx-ring-count = <64>;
				pcie_rc;
				status = "disabled";
