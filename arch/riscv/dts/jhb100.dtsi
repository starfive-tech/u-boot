			pvt_gpu0: pvt@10740000 {
				compatible = "moortec,mr75203";
				reg = <0x0 0x10740000 0x0 0x80>,
				      <0x0 0x10740080 0x0 0x80>,
				      <0x0 0x10740100 0x0 0x80>;
				reg-names = "common", "ts", "pd";
				clocks = <&gpu0crg JHB100_GPU0CLK_MAIN_ICG_EN_SENSORS1>;
				resets = <&gpu0crg JHB100_GPU0RST_MAIN_RSTN_SENSORS5>;
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			pcie_ep1: pcie-ep@10800000 {
				compatible = "starfive,jhb100-pcie-ep";
				reg = <0x0 0x10800000 0x0 0x100000>,
				<0x0 0x10900000 0x0 0x100000>;
				reg-names = "dbi", "dbi2";
				interrupts = <308>, <309>, <310>, <311>;
				interrupt-names = "pm_link", "flr", "err", "edma_local";
				clocks = <&host1crg JHB100_HOST1CLK_MAIN_ICG_EN_PCIE1_EP>;
				resets = <&host1crg JHB100_HOST1RST_MAIN_RSTN_DW_PCIE1_EP>;
				reset-names = "dbi_intf";
				max-link-speed = <4>;
				num-lanes = <1>;
				ecsr-syscon = <&pcie_ep1_ecsr>;

				status = "disabled";
			};

			pcie1_mctp: mctp@10d10000 {
				compatible = "starfive,jhb100-mctp";
				reg = <0x0 0x10d10000 0x0 0x1000>;
				/*interrupts = <349>, <&sysgpio 32 GPIO_ACTIVE_LOW>*/
				/*interrupt-names = "mctp", "pcie";*/
				/*clocks = <&host1crg JHB100_HOST1CLK_MAIN_ICG_EN_MCTP1>;*/
				resets = <&host1crg JHB100_HOST1RST_MAIN_RSTN_MCTP1_EP>;
				starfive,pcie-ecsr = <&pcie_ep1_ecsr>;
				starfive,rx-packet-count = <64>;
				starfive,rx-ring-count = <64>;
				starfive,tx-ring-count = <64>;
				status = "disabled";
			};

			pcie_ep1_ecsr: syscon@10d11000 {
