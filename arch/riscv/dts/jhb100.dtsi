			ufs0: ufs@11b10000 {
				compatible = "starfive,jhb100-ufs", "jedec,ufs-3.1";
				reg = <0x0 0x11b10000 0x0 0x10000>;
				interrupts = <104>, <105>;
				interrupts-names = "ufs", "err";
				clocks = <&per1crg JHB100_PER1CLK_UFS_REF>,
					 <&per1crg JHB100_PER1CLK_UFS_150>,
					 <&per1crg JHB100_PER1CLK_UFS_300>,
					 <&per1crg JHB100_PER1CLK_UFS_400>,
					 <&per1crg JHB100_PER1CLK_UFS_75>,
					 <&per1crg JHB100_PER1CLK_UFS_37_5>,
					 <&per1crg JHB100_PER1CLK_UFS_7_5>,
					 <&per1crg JHB100_PER1CLK_UFS_1_875>,
					 <&per1crg JHB100_PER1CLK_UFS_7_143>,
					 <&per1crg JHB100_PER1CLK_UFS_3_5715>,
					 <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_UFS>;
				clock-names = "ref_clk","clk_150", "clk_300","clk_400",
					      "clk_75", "clk_37_5", "clk_7_5","clk_1_875",
					      "clk_7_143", "clk_3_5715", "ufs";
				freq-table-hz = <26000000 26000000>,
						<50000000 150000000>,
						<300000000 300000000>,
						<400000000 400000000>,
						<75000000 75000000>,
						<37500000 37500000>,
						<7500000 7500000>,
						<1875000 1875000>,
						<7143000 7143000>,
						<3571500 3571500>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_UFS>,
					 <&per1crg JHB100_PER1RST_MAIN_RSTN_UFS_PHY>;
				reset-names = "main", "phy";
				hwlocks = <&hwspinlock 0>;
				status = "disabled";
			};

