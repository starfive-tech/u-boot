				interrupt-controller;
				#interrupt-cells = <2>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_adc1 0 0 8>;
			};

			can0: can@11bc4000 {
				compatible = "ipms,canfd";
				reg = <0x0 0x11bc4000 0x0 0x2000>;
				interrupts = <143>;
				clocks = <&per2crg JHB100_PER2CLK_CAN0_CORE_DIV>,
					<&per2crg JHB100_PER2CLK_MAIN_ICG_EN_CAN0>;
				clock-names = "core_clk", "main_clk";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_CAN0>;
				starfive,sys-syscon = <&syscon_bmcperiph2 0x50 0x0 0x1>;
				status = "disabled";
			};

			can1: can@11bc6000 {
				compatible = "ipms,canfd";
				reg = <0x0 0x11bc6000 0x0 0x2000>;
				interrupts = <144>;
				clocks = <&per2crg JHB100_PER2CLK_CAN1_CORE_DIV>,
					<&per2crg JHB100_PER2CLK_MAIN_ICG_EN_CAN1>;
				clock-names = "core_clk", "main_clk";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_CAN1>;
				starfive,sys-syscon = <&syscon_bmcperiph2 0x60 0x0 0x1>;
				status = "disabled";
			};

			pwm_tach: pwm-tach-controller@11be0000 {
				compatible = "starfive,jhb100-pwm-tach";
				reg = <0x0 0x11be0000 0x0 0x400>;
				interrupts = <128>;
				clocks = <&per2crg JHB100_PER2CLK_FAN_TACH_PCLK>;
				resets = <&per2crg JHB100_PER2RST_FAN_TACH_PRESETN>;
				status = "disabled";
			};

			pwm: pwm@11be0400 {
				compatible = "starfive,jhb100-pwm", "starfive,jh7110-pwm", "opencores,pwm-v1";
				reg = <0x0 0x11be0400 0x0 0x400>;
				clocks = <&pwm_apb>;
				#pwm-cells = <3>;
				status = "disabled";
			};

			rtc: rtc@11be1300 {
				compatible = "starfive,jhb100-rtc", "starfive,jh7110-rtc";
				reg = <0x0 0x11be1300 0x0 0x100>;
				interrupts = <142>;
				interrupt-names = "rtc";
				clocks = <&rtc_apb>, <&osc>;
				clock-names = "pclk", "cal_clk";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_RTC>;
				rtc,cal-clock-freq = <1000000>;
				status = "disabled";
			};

			adc0: saradc@11be1400 {
				compatible = "starfive,jhb100-saradc";
				reg = <0x0 0x11be1400 0x0 0x400>;
				interrupts = <145>;
				clocks = <&per2crg JHB100_PER2CLK_MAIN_ICG_EN_ADC0>;
				resets = <&per2crg JHB100_PER2RST_ADC0_PRESETN>;
				#io-channel-cells = <1>;
				upper-bound = <0xfff>;
				lower-bound = <0>;
				/* Cycle time = (scan-freq + 5) * 10 ns, minimum scan-freq is 15 */
				scan-freq = <20>;
				status = "disabled";
			};

			adc1: saradc@11be1800 {
				compatible = "starfive,jhb100-saradc";
				reg = <0x0 0x11be1800 0x0 0x400>;
				interrupts = <146>;
				clocks = <&per2crg JHB100_PER2CLK_MAIN_ICG_EN_ADC1>;
				resets = <&per2crg JHB100_PER2RST_ADC1_PRESETN>;
				#io-channel-cells = <1>;
				upper-bound = <0xfff>;
				lower-bound = <0>;
				/* Cycle time = (scan-freq + 5) * 10 ns, minimum scan-freq is 15 */
				scan-freq = <20>;
				status = "disabled";
			};

			pinctrl_bmcperiph3: pinctrl@11c42000 {
				compatible = "starfive,jhb100-sys-pinctrl-bmcperiph3";
				reg = <0x0 0x11c42000 0x0 0x1000>;
				resets = <&per3crg JHB100_PER3RST_IOMUX_PRESETN>;
				interrupts = <64>;
				interrupt-controller;
				#interrupt-cells = <2>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_bmcperiph3 0 0 11>;
			};

			peci0: peci-controller@11c60000 {
				compatible = "starfive,jhb100-peci";
				reg = <0x0 0x11c60000 0x0 0x400>;
				interrupts = <222>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_PECI0>;
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_PECI0>;
				cmd-timeout-ms = <1000>;
				status = "disabled";
			};

			peci1: peci-controller@11c60400 {
				compatible = "starfive,jhb100-peci";
				reg = <0x0 0x11c60400 0x0 0x400>;
				interrupts = <223>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_PECI1>;
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_PECI1>;
				cmd-timeout-ms = <1000>;
				status = "disabled";
			};

			hwspinlock: hwspinlock@13012000 {
				compatible = "starfive,jhb100-hwspinlock";
				reg = <0x0 0x13012000 0x0 0x2000>;
				resets = <&sys0crg JHB100_SYS0RST_RESOURCE_ARB>;
				#hwlock-cells = <1>;
				status = "disabled";
			};

			strap_reg: syscon@1301a000 {
				compatible = "starfive,jhb100-strap-syscon", "syscon";
				reg = <0x0 0x1301a000 0x0 0x2000>;
			};

			pvt_sys: pvt@13020000 {
				compatible = "starfive,jhb100-pvt";
				reg = <0x0 0x13020000 0x0 0x80>,
				      <0x0 0x13020080 0x0 0x80>,
				      <0x0 0x13020100 0x0 0x80>;
				reg-names = "common", "ts", "pd";
				clocks = <&sys1crg JHB100_SYS1CLK_APB_SENSOR_ICG_BUF>;
				resets = <&sys1crg JHB100_SYS1RST_MAIN_RSTN_CHIPTOP_SENSOR>;
				interrupts = <53>;
				label = "pvt_sys";
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			pinctrl_sys0: pinctrl@13080000 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys0";
				reg = <0x0 0x13080000 0x0 0x800>;
				resets = <&sys0crg JHB100_SYS0RST_SYS0_IOMUX_PRESETN>;
				interrupts = <56>;
				interrupt-controller;
				#interrupt-cells = <2>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys0 0 0 4>;
			};

			pinctrl_sys0h: pinctrl@13080800 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys0h";
				reg = <0x0 0x13080800 0x0 0x800>;
				resets = <&sys0crg JHB100_SYS0RST_SYS0H_IOMUX_PRESETN>;
				interrupts = <57>;
				interrupt-controller;
				#interrupt-cells = <2>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys0h 0 0 12>;
			};

			pinctrl_sys1: pinctrl@13081000 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys1";
				reg = <0x0 0x13081000 0x0 0x1000>;
				resets = <&sys1crg JHB100_SYS1RST_SYS1_IOMUX_PRESETN>;
				interrupts = <58>;
				interrupt-controller;
				#interrupt-cells = <2>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys1 0 0 8>;
			};

			pinctrl_sys2: pinctrl@13082000 {
				compatible = "starfive,jhb100-sys-pinctrl-systop-sys2";
				reg = <0x0 0x13082000 0x0 0x1000>;
				interrupts = <59>;
				interrupt-controller;
				#interrupt-cells = <2>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-ranges = <&pinctrl_sys2 0 0 37>;
			};

			jtag1: jtag-master@130c0000 {
				compatible = "starfive,jhb100-jtag";
				reg = <0x0 0x130c0000 0x0 0x100>,
				      <0x0 0x130c0400 0x0 0x400>;
				clocks = <&sys2crg JHB100_SYS2CLK_MAIN_ICG_EN_JTAG1>,
					 <&sys2crg JHB100_SYS2CLK_JTAGM1_200>,
					 <&sys2crg JHB100_SYS2CLK_JTAGM1_100>;
				clock-names = "main", "jtag", "apb";
				resets = <&sys2crg JHB100_SYS2RST_JTAG1_MST_WRAP_HRESETN>,
					<&sys2crg JHB100_SYS2RST_JTAG1_MST_WRAP_APB_PRESETN>;
				status = "disabled";
			};

			jtag0: jtag-master@130c0800 {
				compatible = "starfive,jhb100-jtag";
				reg = <0x0 0x130c0800 0x0 0x100>,
				      <0x0 0x130c0c00 0x0 0x400>;
				clocks = <&sys2crg JHB100_SYS2CLK_MAIN_ICG_EN_JTAG0>,
					 <&sys2crg JHB100_SYS2CLK_JTAGM0_200>,
					 <&sys2crg JHB100_SYS2CLK_JTAGM0_100>;
				clock-names = "main", "jtag", "apb";
				resets = <&sys2crg JHB100_SYS2RST_JTAG0_MST_WRAP_HRESETN>,
					<&sys2crg JHB100_SYS2RST_JTAG0_MST_WRAP_APB_PRESETN>;
				status = "disabled";
			};

			reri0: reri0@130e0000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e0000 0x0 0x1000>;
				interrupts-extended = <&plic 79>, <&intc 0>;
				interrupt-names = "hp", "lp";
				bank-name = "DDRSS";
				bank-desc = "Port 0 Read SRAM ECC",
					    "Port 1 Read SRAM ECC",
					    "Port 2 Read SRAM ECC",
					    "Port 3 Read SRAM ECC";
				status = "disabled";
			};

			reri1: reri1@130e1000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e1000 0x0 0x1000>;
				interrupts-extended = <&plic 80>, <&intc 1>;
				interrupt-names = "hp", "lp";
				bank-name = "BMCPCIeRP";
				bank-desc = "PCIE AXI mstr write",
					    "PCIE AXI mstr read",
					    "PCIE AXI slv write",
					    "PCIE AXI slv read",
					    "PCIE Phy SRAM",
					    "MCTP SRAM";
				status = "disabled";
			};

			reri2: reri2@130e2000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e2000 0x0 0x1000>;
				interrupts-extended = <&plic 81>, <&intc 2>;
				interrupt-names = "hp", "lp";
				bank-name = "BMCPeriph1";
				bank-desc = "UFS Phy SRAM";
				status = "disabled";
			};

			reri3: reri3@130e3000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e3000 0x0 0x1000>;
				interrupts-extended = <&plic 82>, <&intc 3>;
				interrupt-names = "hp", "lp";
				bank-name = "HOSTSS0";
				bank-desc = "PCIE AXI mstr write",
					    "PCIE AXI mstr read",
					    "PCIE AXI slv write",
					    "PCIE AXI slv read",
					    "PCIE Phy SRAM Ecc",
					    "MCTP SRAM ECC";
				status = "disabled";
			};

			reri4: reri4@130e4000 {
				compatible = "starfive,reri-edac";
				reg = <0x0 0x130e4000 0x0 0x1000>;
				interrupts-extended = <&plic 83>, <&intc 4>;
				interrupt-names = "hp", "lp";
				bank-name = "HOSTSS1";
				bank-desc = "PCIE AXI mstr write",
					    "PCIE AXI mstr read",
					    "PCIE AXI slv write",
					    "PCIE AXI slv read",
					    "PCIE Phy SRAM Ecc",
					    "MCTP SRAM ECC";
				status = "disabled";
			};

			pvt_ddr: pvt@13100000 {
				compatible = "starfive,jhb100-pvt";
				reg = <0x0 0x13100000 0x0 0x80>,
				      <0x0 0x13100080 0x0 0x80>,
				      <0x0 0x13100100 0x0 0x80>;
				reg-names = "common", "ts", "pd";
				clocks = <&pvt_aon>;
				interrupts = <34>;
				label = "pvt_ddr";
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			pvt_cpu: pvt@13210000 {
				compatible = "starfive,jhb100-pvt";
				reg = <0x0 0x13210000 0x0 0x80>,
				      <0x0 0x13210080 0x0 0x80>,
				      <0x0 0x13210100 0x0 0x80>,
				      <0x0 0x13210400 0x0 0x800>;
				reg-names = "common", "ts", "pd", "vm";
				intel,vm-map = [00 ff];
				clocks = <&cpucrg JHB100_CPUCLK_MAIN_ICG_EN_CPUSS_SENSORS>;
				resets = <&cpucrg JHB100_CPURST_MAIN_RSTN_CPUSS_SENSORS>;
				interrupts = <14>;
				label = "pvt_cpu";
				moortec,vm-active-channels = <16>;
				moortec,vm-pre-scaler-x2 = <1 1 1 1 2 1 1 1 1 1 1 1 3 1 1 1>;
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			led0: led@13215000 {
				compatible = "starfive,jhb100-leds";
				reg = <0x0 0x13215000 0x0 0xc>;
				clocks = <&cpucrg JHB100_CPUCLK_MAIN_ICG_EN_CPUSS_HEARTBEAT>;
				resets = <&cpucrg JHB100_CPURST_MAIN_RSTN_HEARTBEAT>;
				status = "disabled";
			};

			l3_pmu: pmu@13216000 {
				compatible = "starfive,jhb100-starnoc-pmu", "starfive,jh8100-starnoc-pmu";
				reg = <0x0 0x13216000 0x0 0x1000>;
				interrupts = <11>, <10>, <12>;
				interrupt-names = "pmu", "llc_irq", "ecc_irq";
			};

			intc: interrupt-controller@13220000 {
				compatible = "starfive,jhb100-intc";
				reg = <0x0 0x13220000 0x0 0x80>;
				interrupts = <1>;
				interrupt-controller;
				#interrupt-cells = <1>;
			};

			ldo0: ldo0@140c0000 {
				compatible = "actt,ldo-regulator";
				reg = <0x0 0x140c0000 0x0 0x80>;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1200000>;
				regulator-min-microamp = <366400>;
				regulator-max-microamp = <469300>;
				regulator-initial-microvolt = <1000000>;
				regulator-initial-microamp = <396300>;
				regulator-name = "ldo0";
				clocks = <&per0crg JHB100_PER0CLK_MAIN_ICG_EN_LDO0>;
				resets = <&per0crg JHB100_PER0RST_MAIN_RSTN_LDO0>;
				reset-names = "ldo";
				interrupts = <219>;
				status = "disabled";
			};

			ldo1: ldo1@140c0080 {
				compatible = "actt,ldo-regulator";
				reg = <0x0 0x140c0080 0x0 0x80>;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1200000>;
				regulator-min-microamp = <366400>;
				regulator-max-microamp = <469300>;
				regulator-initial-microvolt = <1000000>;
				regulator-initial-microamp = <396300>;
				regulator-name = "ldo1";
				clocks = <&per0crg JHB100_PER0CLK_MAIN_ICG_EN_LDO1>;
				resets = <&per0crg JHB100_PER0RST_MAIN_RSTN_LDO1>;
				reset-names = "ldo";
				interrupts = <220>;
				status = "disabled";
			};

			ddrc_edac: memory-controller@16000000 {
				compatible = "starfive,jhb100-ddrc";
				reg = <0x0 0x16000000 0x0 0x100000>;
				interrupts = <70>;
				starfive,data-width = <16>;
				status = "disabled";
			};

			sfc1: spi@17f00000  {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x17f00000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <112>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC1>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC1>;
				reset-names = "spi";
				num-cs = <3>;
				dmas = <&dma_sfc1 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			sfc2: spi@17f10000  {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x17f10000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <113>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC2>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC2>;
				reset-names = "spi";
				num-cs = <3>;
				dmas = <&dma_sfc2 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			spi0: spi@17f20000 {
				compatible = "starfive,jhb100-spi";
				reg = <0x0 0x17f20000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <110>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SPI0>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SPI0>;
				reset-names = "spi";
				num-cs = <2>;
				dmas = <&dma_spi0 0>, <&dma_spi0 1>;
				dma-names = "tx", "rx";
				starfive,syscon = <&per1_syscon>;
				frf = <0>;
				status = "disabled";
			};

			sfc0: spi@18000000 {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x18000000 0x0 0x8000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <111>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC0>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC0>;
				reset-names = "spi";
				num-cs = <2>;
				dmas = <&dma_sfc0 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			dc0_clk: dc0@dc8000 {
				compatible = "verisilicon,dc8000-clk";
				reg = <0x0 0x11135000 0x0 0x200>,
					<0x0 0x11135400 0x0 0x100>;
				interrupts-extended = <&plic 237>, <&intc 53>, <&intc 54>, <&intc 57>;
				interrupt-names = "h2b", "perst_pe", "perst_ne", "espi_rst";
				clocks = <&voutcrg JHB100_VOUTCLK_MAIN_ICG_EN_U0_DC8000>,
					<&voutcrg JHB100_VOUTCLK_U0_DC8000_PIXELCLK0>,
					<&syspll JHB100_SYSPLL_PLL4_OUT>;
				clock-names = "main_icg", "pix_clk", "vout_pix";
				resets = <&voutcrg JHB100_VOUTRST_MAIN_RSTN_U0_DC8000>;
				dc-syscon = <&dcsyscon>;
				starfive,syscon = <&sys_syscon 48 4>;
				memory-region = <&pcie0_media_mem_uncache>;
				host-type = <0>;
				status = "disabled";
			};

			dc1_clk: dc1@dc8000 {
				compatible = "verisilicon,dc8000-clk";
				reg = <0x0 0x11135200 0x0 0x200>,
					<0x0 0x11135500 0x0 0x100>;
				interrupts-extended = <&plic 238>, <&intc 55>, <&intc 56>, <&intc 58>;
				interrupt-names = "h2b", "perst_pe", "perst_ne", "espi_rst";
				clocks = <&voutcrg JHB100_VOUTCLK_MAIN_ICG_EN_U1_DC8000>,
					<&voutcrg JHB100_VOUTCLK_U1_DC8000_PIXELCLK0>,
					<&syspll JHB100_SYSPLL_PLL5_OUT>;
				clock-names = "main_icg", "pix_clk", "vout_pix";
				resets = <&voutcrg JHB100_VOUTRST_MAIN_RSTN_U1_DC8000>;
				dc-syscon = <&dcsyscon>;
				starfive,syscon = <&sys_syscon 48 5>;
				memory-region = <&pcie1_media_mem_uncache>;
				host-type = <1>;
				status = "disabled";
			};
		};

		bus_ioc: bus_ioc {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-coherent;
			ranges;

			stmmac_axi_setup0: stmmac-axi-config0 {
				snps,wr_osr_lmt = <7>;
				snps,rd_osr_lmt = <7>;
				snps,blen = <256 128 64 32 16 8 4>;
			};

			stmmac_axi_setup1: stmmac-axi-config1 {
				snps,wr_osr_lmt = <15>;
				snps,rd_osr_lmt = <15>;
				snps,blen = <256 128 64 32 16 8 4>;
			};

			gmac2: ethernet@11b80000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11b80000 0x0 0x4000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_ACLK_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_CSR_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_PTP_REF_I>,
					<&per2crg JHB100_PER2CLK_GMAC2_RMII_DIV>,
					<&per2crg JHB100_PER2CLK_MAIN_ICG_EN_GMAC2>;
				clock-names = "stmmaceth", "pclk", "ptp_ref", "tx", "gtx";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_GMAC2>;
				reset-names = "stmmaceth";
				interrupts = <140>;
				interrupt-names = "macirq";
				starfive,syscon = <&syscon_bmcperiph2 0x0 0x8>;
				dma-coherent;
				rx-fifo-depth = <8192>;
				tx-fifo-depth = <8192>;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,axi-config = <&stmmac_axi_setup1>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				status = "disabled";
			};

			gmac3: ethernet@11b84000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11b84000 0x0 0x4000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER1_SGMII_ACLK_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_CSR_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_PTP_REF_I>,
					<&per2crg JHB100_PER2CLK_GMAC3_TX_DIV>,
					<&per2crg JHB100_PER2CLK_MAIN_ICG_EN_GMAC3>,
					<&per2crg JHB100_PER2CLK_GMAC3_RX_DIV>;
				clock-names = "stmmaceth", "pclk", "ptp_ref", "tx", "gtx", "rx";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_GMAC3>;
				reset-names = "stmmaceth";
				interrupts = <141>;
				interrupt-names = "macirq";
				dma-coherent;
				rx-fifo-depth = <8192>;
				tx-fifo-depth = <8192>;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,axi-config = <&stmmac_axi_setup1>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				phy-mode = "sgmii";
				phys = <&sgmii_phy0>;
				phy-names = "serdes";
				status = "disabled";
			};

			sgmii_phy0: phy@11b90000 {
				compatible = "starfive,dwmac-inno-sgmii-phy";
				reg = <0x0 0x11b90000 0x0 0x10000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER1_SGMII_PHY_PCLK_I>,
					 <&per2crg JHB100_PER2CLK_ETHER1_SGMII_REF_25_I>;
				clock-names = "pclk", "ref_25m";
				starfive,syscon = <&syscon_bmcperiph2 0x2a>;
				#phy-cells = <0>;
				status = "disabled";
			};

			dma_system: dma-controller@11bc3000 {
				compatible = "starfive,jhb100-axi-dma-system";
				reg = <0x0 0x11bc3000 0x0 0x1000>;
				clocks = <&per2crg JHB100_PER2CLK_MAIN_ICG_EN_DMAC_1CH>;
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_DMAC_8CH>;
				interrupts = <127>;
				#dma-cells = <1>;
				dma-channels = <8>;
				snps,dma-masters = <1>;
				snps,data-width = <3>;
				snps,block-size = <65536 65536 65536 65536 65536
						65536 65536 65536>;
				snps,priority = <0 1 2 3 4 5 6 7>;
				snps,axi-max-burst-len = <16>;
				status = "disabled";
			};

			gmac0: ethernet@11c00000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11c00000 0x0 0x4000>;
				clocks = <&per3crg JHB100_PER3CLK_ETHER0_RMII_ACLK_I>,
					<&per3crg JHB100_PER3CLK_ETHER0_RMII_CLK_CSR_I>,
					<&per3crg JHB100_PER3CLK_ETHER0_RMII_CLK_PTP_REF_I>,
					<&per3crg JHB100_PER3CLK_GMAC0_RMII_MUX_DIV2>,
					<&per3crg JHB100_PER3CLK_MAIN_ICG_EN_GMAC0>;
				clock-names = "stmmaceth", "pclk", "ptp_ref", "tx", "gtx";
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_GMAC0>;
				reset-names = "stmmaceth";
				interrupts = <224>;
				interrupt-names = "macirq";
				starfive,syscon = <&syscon_bmcperiph3 0x100 0x8>;
				dma-coherent;
				rx-fifo-depth = <8192>;
				tx-fifo-depth = <8192>;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,axi-config = <&stmmac_axi_setup0>;
				snps,tso;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				status = "disabled";
			};

			gmac1: ethernet@11c04000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11c04000 0x0 0x4000>;
				clocks = <&per3crg JHB100_PER3CLK_ETHER0_SGMII_ACLK_I>,
					<&per3crg JHB100_PER3CLK_ETHER0_SGMII_CLK_CSR_I>,
					<&per3crg JHB100_PER3CLK_ETHER0_SGMII_CLK_PTP_REF_I>,
					<&per3crg JHB100_PER3CLK_GMAC1_TX>,
					<&per3crg JHB100_PER3CLK_MAIN_ICG_EN_GMAC1>,
					<&per3crg JHB100_PER3CLK_GMAC1_RX>;
				clock-names = "stmmaceth", "pclk", "ptp_ref", "tx", "gtx", "rx";
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_GMAC1>;
				reset-names = "stmmaceth";
				interrupts = <225>;
				interrupt-names = "macirq";
				dma-coherent;
				rx-fifo-depth = <8192>;
				tx-fifo-depth = <8192>;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,axi-config = <&stmmac_axi_setup1>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				phy-mode = "sgmii";
				phys = <&sgmii_phy1>;
				phy-names = "serdes";
				status = "disabled";
			};

			sgmii_phy1: phy@11c10000 {
				compatible = "starfive,dwmac-inno-sgmii-phy";
				reg = <0x0 0x11c10000 0x0 0x10000>;
				clocks = <&per3crg JHB100_PER3CLK_ETHER0_SGMII_PHY_PCLK_I>,
					 <&per3crg JHB100_PER3CLK_ETHER0_SGMII_CLK_REF_25_I>;
				clock-names = "pclk", "ref_25m";
				starfive,syscon = <&syscon_bmcperiph3 0x24>;
				#phy-cells = <0>;
				status = "disabled";
			};
		};

		bus_nioc_4g: bus_nioc_4g {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-noncoherent;
			ranges;
			dma-ranges = <0x0 0x40000000 0x0 0x40000000 0x1 0x0>,
				     <0x4 0x00000000 0x4 0x00000000 0x1 0x0>;

			emmc0: mmc@11b00000 {
				compatible = "starfive,jhb100-dwcmshc";
				reg = <0x0 0x11b00000 0x0 0x10000>;
				interrupts = <118>;
				clocks = <&per1crg JHB100_PER1CLK_EMMC0_BCLK>,
					 <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_EMMC0>,
					 <&per1crg JHB100_PER1CLK_EMMC0_CCLK>;
				clock-names = "core", "bus", "cclk";
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_EMMC0>;
				bus-width = <8>;
				hwlocks = <&hwspinlock 0>;
				supports-cqe;
				status = "disabled";
			};
		};

	};
};
