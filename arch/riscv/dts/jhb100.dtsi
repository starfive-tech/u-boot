			pcie: pcie@11200000 {
				compatible = "starfive,jhb100-pcie-host";
				reg = <0x3 0x11200000 0x0 0x00500000>,
				<0x0 0x28000000 0x0 0x00100000>;
				reg-names = "dbi", "config";
				device_type = "pci";
				#address-cells = <3>;
				#size-cells = <2>;
				ranges = <0x02000000 0x0 0x28100000 0x0 0x28100000 0x0 0x4000000>,
					<0x03000000 0xc 0x00000000 0xc 0x00000000 0x1 0x00000000>;
				bus-range = <0x0 0xf>;
				clocks = <&pcierpcrg JHB100_PCIERPCLK_MAIN_ICG_EN_PCIERP>;
				interrupts = <86>, <87>, <88>, <89>;
				interrupt-names = "pm_link", "legacy", "msi", "err";
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &pcie_intc0 0>,
						<0 0 0 2 &pcie_intc0 1>,
						<0 0 0 3 &pcie_intc0 2>,
						<0 0 0 4 &pcie_intc0 3>;
				max-link-speed = <2>;
				num-lanes = <1>;
				resets = <&pcierpcrg JHB100_PCIERPRST_MAIN_RSTN_DW_PCIE_RP>;
				reset-names = "main";
				ecsr-syscon = <&pcie_rp_ecsr>;

				status = "disabled";

				pcie_intc0: legacy-interrupt-controller {
					#address-cells = <0>;
					#interrupt-cells = <1>;
					interrupt-controller;
					interrupts = <87>;
				};
			};

			pcierp_mctp: mctp@11710000 {
				compatible = "starfive,jhb100-mctp";
				reg = <0x0 0x11710000 0x0 0x1000>;
				/*interrupts = <90>, <91>;*/
				/*interrupt-names = "mctp", "pcie";*/
				/*clocks = <&pcierpcrg JHB100_PCIERPCLK_MAIN_ICG_EN_MCTP>;*/
				resets = <&pcierpcrg JHB100_PCIERPRST_MAIN_RSTN_MCTP_PCIERP>;
				starfive,pcie-ecsr = <&pcie_rp_ecsr>;
				starfive,rx-packet-count = <64>;
				starfive,rx-ring-count = <64>;
				starfive,tx-ring-count = <64>;
				pcie_rc;
				status = "disabled";
			};

			pcie_rp_ecsr: syscon@11711000 {
				compatible = "starfive,jhb100-pcie-ecsr-syscon", "syscon";
				reg = <0x0 0x11711000 0x0 0x1000>;
			};

			usb0: usb@11800000 {
				compatible = "starfive,jhb100-dwc3-otg";
				#address-cells = <2>;
				#size-cells = <2>;
				resets = <&usbcrg JHB100_USBRST_MAIN_RSTN_HOST>;
				interrupts = <106>;
				interrupt-names = "err";
				status = "disabled";
				ranges;

				usb0core: usb@11800000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x11800000 0x0 0x10000>;
					clocks = <&usbcrg JHB100_USBCLK_USB_HOST_USB3_BUS_CLK_EARLY>,
						<&usbcrg JHB100_USBCLK_USB_HOST_USB3_REF_CLK>;
					clock-name = "bus_early", "ref";
					interrupts = <107>;
					dr_mode = "host";
				};
			};

			usb1: usb@11810000 {
				compatible = "starfive,jhb100-dwc3-otg";
				#address-cells = <2>;
				#size-cells = <2>;
				resets = <&usbcrg JHB100_USBRST_MAIN_RSTN_DRD>;
				interrupts = <104>;
				interrupt-names = "err";
				status = "disabled";
				ranges;

				usb1core: usb@11810000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x11800000 0x0 0x10000>;
					clocks = <&usbcrg JHB100_USBCLK_USB_DRD_USB3_BUS_CLK_EARLY>,
						<&usbcrg JHB100_USBCLK_USB_DRD_USB3_REF_CLK>;
					clock-name = "bus_early", "ref";
					interrupts = <105>;
					dr_mode = "otg";
				};
			};

