				snps,data-width = <3>;
				snps,block-size = <65536 65536 65536 65536 65536
						 65536 65536 65536 65536 65536
						 65536 65536 65536 65536 65536 65536>;
				snps,priority = <0 1 2 3 4 5 6 7 8
