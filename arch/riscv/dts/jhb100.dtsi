				compatible = "starfive,jhb100-starlink-pmu", "starfive,jh8100-starlink-pmu";
				reg = <0x0 0x13216000 0x0 0x1000>;
				interrupts = <11>, <10>, <12>;
				interrupt-names = "pmu", "llc_irq", "ecc_irq";
			};

			intc: interrupt-controller@13220000 {
				compatible = "starfive,jhb100-intc";
				reg = <0x0 0x13220000 0x0 0x80>;
				interrupts = <1>;
				interrupt-controller;
				#interrupt-cells = <1>;
			};

			ddrc_edac: ddr_controller_edac@16100000 {
				compatible = "starfive,jhb100-ddrc";
				reg = <0x0 0x16100000 0x0 0x100000>;
				interrupts = <70>;
				status = "disabled";
			};

			sfc1: spi@17f00000  {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x17f00000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <112>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC1>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC1>;
				reset-names = "spi";
				num-cs = <3>;
				dmas = <&dma_sfc1 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			sfc2: spi@17f10000  {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x17f10000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <113>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC2>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC2>;
				reset-names = "spi";
				num-cs = <3>;
				dmas = <&dma_sfc2 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			spi0: spi@17f20000 {
				compatible = "starfive,jhb100-spi";
				reg = <0x0 0x17f20000 0x0 0x10000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <110>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SPI0>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SPI0>;
				reset-names = "spi";
				num-cs = <2>;
				dmas = <&dma_spi0 0>, <&dma_spi0 1>;
				dma-names = "tx", "rx";
				status = "disabled";
			};

			sfc0: spi@18000000 {
				compatible = "starfive,jhb100-sfc";
				reg = <0x0 0x18000000 0x0 0x8000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <111>;
				clocks = <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_SFC0>;
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_SFC0>;
				reset-names = "spi";
				num-cs = <2>;
				dmas = <&dma_sfc0 0 1 0>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			dc0_clk: dc0@dc8000 {
				compatible = "verisilicon,dc8000-clk";
				reg = <0x0 0x11135000 0x0 0x200>,
					<0x0 0x11135400 0x0 0x100>,
					<0x0 0x11135800 0x0 0x100>;
				interrupts-extended = <&plic 237>, <&intc 53>, <&intc 54>, <&intc 57>;
				interrupt-names = "h2b", "perst_pe", "perst_ne", "espi_rst";
				clocks = <&voutcrg JHB100_VOUTCLK_MAIN_ICG_EN_U0_DC8000>,
					<&voutcrg JHB100_VOUTCLK_U0_DC8000_PIXELCLK0>;
				clock-names = "main_icg", "pix_clk";
				resets = <&voutcrg JHB100_VOUTRST_MAIN_RSTN_U0_DC8000>;
				status = "disabled";
			};
		};

		bus_ioc: bus_ioc {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-coherent;
			ranges;

			stmmac_axi_setup0: stmmac-axi-config0 {
				snps,wr_osr_lmt = <7>;
				snps,rd_osr_lmt = <7>;
				snps,blen = <256 128 64 32 16 8 4>;
			};

			stmmac_axi_setup1: stmmac-axi-config1 {
				snps,wr_osr_lmt = <15>;
				snps,rd_osr_lmt = <15>;
				snps,blen = <256 128 64 32 16 8 4>;
			};

			gmac2: ethernet@11b80000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11b80000 0x0 0x4000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_ACLK_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_CSR_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_PTP_REF_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_TX_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_TX_180_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_RX_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_RX_180_I>,
					<&per2crg JHB100_PER2CLK_ETHER0_RMIIANDRGMII_RMII_I>;
				clock-names = "stmmaceth", "pclk", "ptp_ref",
					"tx", "gtx", "rx", "grx", "rmii";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_GMAC2>;
				interrupts = <140>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup1>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				status = "disabled";
			};

			gmac3: ethernet@11b84000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11b84000 0x0 0x4000>;
				clocks = <&per2crg JHB100_PER2CLK_ETHER1_SGMII_ACLK_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_CSR_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_PTP_REF_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_TX_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_TX_125_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_RX_I>,
					<&per2crg JHB100_PER2CLK_ETHER1_SGMII_RX_125_I>;
				clock-names = "stmmaceth", "pclk", "ptp_ref",
					"tx", "gtx", "rx", "grx";
				resets = <&per2crg JHB100_PER2RST_MAIN_RSTN_GMAC3>;
				interrupts = <141>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup1>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				status = "disabled";
			};

			gmac0: ethernet@11c00000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11c00000 0x0 0x4000>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_GMAC0>;
				clock-names = "pclk";
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_GMAC0>;
				interrupts = <224>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup0>;
				snps,tso;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				status = "disabled";
			};

			gmac1: ethernet@11c04000 {
				compatible = "starfive,jhb100-dwmac", "snps,dwmac-5.20";
				reg = <0x0 0x11c04000 0x0 0x4000>;
				clocks = <&per3crg JHB100_PER3CLK_MAIN_ICG_EN_GMAC1>;
				clock-names = "pclk";
				resets = <&per3crg JHB100_PER3RST_MAIN_RSTN_GMAC1>;
				interrupts = <225>;
				interrupt-names = "macirq";
				dma-coherent;
				snps,multicast-filter-bins = <256>;
				snps,perfect-filter-entries = <8>;
				snps,fixed-burst;
				snps,no-pbl-x8;
				snps,force_thresh_dma_mode;
				snps,axi-config = <&stmmac_axi_setup1>;
				snps,tso;
				snps,en-tx-lpi-clockgating;
				snps,txpbl = <16>;
				snps,rxpbl = <16>;
				status = "disabled";
			};
		};

		bus_nioc_4g: bus_nioc_4g {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-noncoherent;
			ranges;
			dma-ranges = <0x0 0x40000000 0x0 0x40000000 0x1 0x0>,
				     <0x4 0x00000000 0x4 0x00000000 0x1 0x0>;

			emmc0: mmc@11b00000 {
				compatible = "starfive,jhb100-dwcmshc";
				reg = <0x0 0x11b00000 0x0 0x10000>;
				interrupts = <118>;
				clocks = <&per1crg JHB100_PER1CLK_EMMC0_BCLK>,
					 <&per1crg JHB100_PER1CLK_MAIN_ICG_EN_EMMC0>;
				clock-names = "core", "bus";
				resets = <&per1crg JHB100_PER1RST_MAIN_RSTN_EMMC0>;
				bus-width = <8>;
				hwlocks = <&hwspinlock 0>;
				supports-cqe;
				status = "disabled";
			};
		};

	};
};
