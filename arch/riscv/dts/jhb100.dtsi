				<0x0 0x10900000 0x0 0x100000>,
				<0x0 0x10b00000 0x0 0x1ff24>,
				<0x0 0x10b80000 0x0 0x10000>,
				<0x0 0x10680000 0x0 0x8000>,
				<0x0 0x11120000 0x0 0x8000>,
				<0x0 0x11135000 0x0 0x1000>,
				<0x0 0x24000000 0x0 0x4000000>;
				reg-names = "dbi", "dbi2", "atu", "hdma", "usb", "dc", "vout",
					"addr_space";
				interrupts-extended = <&intc 55>, <&intc 56>,
					<&plic 308>, <&plic 309>, <&plic 311>, <&plic 313>;
				interrupt-names = "perst_pe", "perst_ne", "pm_link", "flr",
					"err", "h2b";
				clocks = <&host1crg JHB100_HOST1CLK_MAIN_ICG_EN_PCIE1_EP>,
					<&host1crg JHB100_HOST1CLK_PCIE1_EP_MSTR_ACLK>,
					<&host1crg JHB100_HOST1CLK_PCIE1_EP_SLV_ACLK>,
					<&host1crg JHB100_HOST1CLK_PCIE1_EP_DBI_ACLK>,
					<&host1crg JHB100_HOST1CLK_MAIN_ICG_EN_PCIE1_ECSR>,
					<&host1crg JHB100_HOST1CLK_PCIE1_EP_PHY_APB_CLK>;
				resets = <&host1crg JHB100_HOST1RST_PCIE1_EP_SW_CORE_RST_N>,
					<&host1crg JHB100_HOST1RST_MAIN_RSTN_DW_PCIE1_EP>,
					<&host1crg JHB100_HOST1RST_PCIE1_EP_SW_PHY_RST_N>,
					<&host1crg JHB100_HOST1RST_PCIE1_EP_SW_PHY_PERST_N>,
					<&host1crg JHB100_HOST1RST_MAIN_RSTN_PCIEEP1_ECSR>,
					<&host1crg JHB100_HOST1RST_PCIE1_EP_PERST_N>,
					<&host1crg JHB100_HOST1RST_PCIE1_EP_PHY_APB_RST_N>;
				reset-names = "core", "main", "phy", "phy_pe", "ecsr",
					"dw_pe", "apb";
				max-functions = <7>;
				max-link-speed = <4>;
				num-lanes = <1>;
				ecsr-syscon = <&pcie_ep1_ecsr>;
				starfive,ep-id = <1>;
