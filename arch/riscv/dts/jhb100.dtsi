			pcie: pcie@11200000 {
				compatible = "starfive,jhb100-pcie-host";
				reg = <0x3 0x11200000 0x0 0x00500000>,
				<0x0 0x28000000 0x0 0x00100000>;
				reg-names = "dbi", "config";
				device_type = "pci";
				#address-cells = <3>;
				#size-cells = <2>;
				ranges = <0x02000000 0x0 0x28100000 0x0 0x28100000 0x0 0x4000000>,
					<0x03000000 0xc 0x00000000 0xc 0x00000000 0x1 0x00000000>;
				bus-range = <0x0 0xf>;
				clocks = <&pcierpcrg JHB100_PCIERPCLK_MAIN_ICG_EN_PCIERP>;
				interrupts = <86>, <87>, <88>, <89>;
				interrupt-names = "pm_link", "legacy", "msi", "err";
				#interrupt-cells = <1>;
				interrupt-map-mask = <0 0 0 7>;
				interrupt-map = <0 0 0 1 &pcie_intc0 0>,
						<0 0 0 2 &pcie_intc0 1>,
						<0 0 0 3 &pcie_intc0 2>,
						<0 0 0 4 &pcie_intc0 3>;
				max-link-speed = <2>;
				num-lanes = <1>;
				resets = <&pcierpcrg JHB100_PCIERPRST_MAIN_RSTN_DW_PCIE_RP>;
				reset-names = "main";
				ecsr-syscon = <&pcie_rp_ecsr>;

				status = "disabled";

				pcie_intc0: legacy-interrupt-controller {
					#address-cells = <0>;
					#interrupt-cells = <1>;
					interrupt-controller;
					interrupts = <87>;
				};
			};

			pcierp_mctp: mctp@11710000 {
