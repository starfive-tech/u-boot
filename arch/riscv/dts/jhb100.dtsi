/dts-v1/;
#include <dt-bindings/power/starfive,jhb100-power.h>
#include "jhb100-crg.dtsi"
#include "jhb100-pinfunc.h"

/ {
	compatible = "starfive,jhb100";
	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c0>;
			reg = <0x0>;
			tlb-split;

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu1: cpu@1 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c1>;
			reg = <0x1>;
			tlb-split;

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu2: cpu@2 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c2>;
			reg = <0x2>;
			tlb-split;

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu3: cpu@3 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c3>;
			reg = <0x3>;
			tlb-split;

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu1>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu2>;
				};
			};

			cluster3 {
				core0 {
					cpu = <&cpu3>;
				};
			};
		};

		l2c0: cache-controller-0 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l2c1: cache-controller-1 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l2c2: cache-controller-2 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l2c3: cache-controller-3 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l3_cache: cache-controller-4 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <3>;
			cache-sets = <1024>;
			cache-size = <0x20000>;
			cache-unified;
		};
	};

	pmu {
		compatible = "riscv,pmu";
		interrupts-extended = <&cpu0_intc 13>, <&cpu1_intc 13>,
				      <&cpu2_intc 13>, <&cpu3_intc 13>;

		riscv,event-to-mhpmevent = <0x00005 0x0000 0xA>,
					   <0x00006 0x0000 0xB>,
					   <0x00008 0x0000 0x10>,
					   <0x00009 0x0000 0xF>,
					   <0x10000 0x0000 0x19>,
					   <0x10001 0x0000 0x1A>,
					   <0x10002 0x0000 0x1B>,
					   <0x10003 0x0000 0x1C>,
					   <0x10008 0x0000 0x8>,
					   <0x10009 0x0000 0x9>,
					   <0x1000C 0x0000 0x9E>,
					   <0x1000D 0x0000 0x9F>,
					   <0x10010 0x0000 0x1D>,
					   <0x10011 0x0000 0x1E>,
					   <0x10012 0x0000 0x1F>,
					   <0x10013 0x0000 0x20>,
					   <0x10014 0x0000 0x21>,
					   <0x10018 0x0000 0x17>,
					   <0x10019 0x0000 0x18>,
					   <0x10020 0x0000 0x8>,
					   <0x10021 0x0000 0x7>;

		riscv,event-to-mhpmcounters = <0x00005 0x00006 0x00007FF8>,
					      <0x00008 0x00009 0x00007FF8>,
					      <0x10000 0x10003 0x00007FF8>,
					      <0x10008 0x10009 0x00007FF8>,
					      <0x1000C 0x1000D 0x00007FF8>,
					      <0x10010 0x10014 0x00007FF8>,
					      <0x10018 0x10019 0x00007FF8>,
					      <0x10020 0x10021 0x00007FF8>;

		riscv,raw-event-to-mhpmcounters =
			<0x00 0x00 0xFFFFFFFF 0xFFFFFFE0 0x00007FF8>,	/* Event ID 1-31 */
			<0x00 0x20 0xFFFFFFFF 0xFFFFFFFE 0x00007FF8>,	/* Event ID 32-33 */
			<0x00 0x22 0xFFFFFFFF 0xFFFFFF22 0x00007FF8>;	/* Event ID 34 */
	};

	dubhe_edac: dubhe-edac {
		compatible = "starfive,dubhe-core-edac";
	};

	sbi_mpxy_mbox: sbi-mpxy-mbox {
		compatible = "riscv,sbi-mpxy-mbox";
		#mbox-cells = <0x01>;
	};

	rpmi_pmdomain: rpmi-pmdomain {
		compatible = "riscv,rpmi-device-power";
		mboxes = <&sbi_mpxy_mbox 0x1002>;
		#power-domain-cells = <1>;
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <&plic>;
		#address-cells = <2>;
		#size-cells = <2>;
		dma-ranges;
		ranges;

		clint: clint@2000000 {
			compatible = "starfive,jhb100-clint", "sifive,clint0";
			reg = <0x0 0x02000000 0x0 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>,
					      <&cpu1_intc 3>, <&cpu1_intc 7>,
					      <&cpu2_intc 3>, <&cpu2_intc 7>,
					      <&cpu3_intc 3>, <&cpu3_intc 7>;
		};

		plic: interrupt-controller@c000000 {
			#interrupt-cells = <1>;
			compatible = "starfive,jhb100-plic", "sifive,plic-1.0.0";
			reg = <0x0 0x0c000000 0x0 0x4000000>;
			riscv,ndev = <400>;
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>,
					      <&cpu1_intc 11>, <&cpu1_intc 9>,
					      <&cpu2_intc 11>, <&cpu2_intc 9>,
					      <&cpu3_intc 11>, <&cpu3_intc 9>;
		};

		bus_nioc: bus_nioc {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-noncoherent;
			dma-ranges = <0x4 0x00000000 0x0 0x40000000 0x2 0x0>,
				     <0x4 0x00000000 0x4 0x00000000 0x2 0x0>;
			ranges;

			pcie_ep0: pcie-ep@10000000 {
				compatible = "starfive,jhb100-pcie-ep";
				reg = <0x0 0x10000000 0x0 0x100000>,
				<0x0 0x10100000 0x0 0x100000>,
				<0x0 0x10300000 0x0 0x1ff24>,
				<0x0 0x10380000 0x0 0x10000>,
				<0x0 0x10680000 0x0 0x8000>,
				<0x0 0x11120000 0x0 0x8000>,
				<0x0 0x11135000 0x0 0x1000>,
				<0x0 0x20000000 0x0 0x4000000>;
				reg-names = "dbi", "dbi2", "atu", "hdma", "usb", "dc", "vout",
					"addr_space";
				interrupts-extended = <&intc 53>, <&intc 54>,
					<&plic 263>, <&plic 264>, <&plic 266>, <&plic 268>;
				interrupt-names = "perst_pe", "perst_ne", "pm_link", "flr",
					"err", "h2b";
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_PCIE0_EP>,
					<&host0crg JHB100_HOST0CLK_PCIE0_EP_MSTR_ACLK>,
					<&host0crg JHB100_HOST0CLK_PCIE0_EP_SLV_ACLK>,
					<&host0crg JHB100_HOST0CLK_PCIE0_EP_DBI_ACLK>,
					<&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_PCIE0_ECSR>,
					<&host0crg JHB100_HOST0CLK_PCIE0_EP_PHY_APB_CLK>;
				resets = <&host0crg JHB100_HOST0RST_PCIE0_EP_SW_CORE_RST_N>,
					<&host0crg JHB100_HOST0RST_MAIN_RSTN_DW_PCIE0_EP>,
					<&host0crg JHB100_HOST0RST_PCIE0_EP_SW_PHY_RST_N>,
					<&host0crg JHB100_HOST0RST_PCIE0_EP_SW_PHY_PERST_N>,
					<&host0crg JHB100_HOST0RST_MAIN_RSTN_PCIEEP0_ECSR>,
					<&host0crg JHB100_HOST0RST_PCIE0_EP_PERST_N>,
					<&host0crg JHB100_HOST0RST_PCIE0_EP_PHY_APB_RST_N>;
				reset-names = "core", "main", "phy", "phy_pe", "ecsr",
					"dw_pe", "apb";
				max-functions = <7>;
				max-link-speed = <1>;
				num-lanes = <1>;
				ecsr-syscon = <&pcie_ep0_ecsr>;
				starfive,ep-id = <0>;
				status = "disabled";
			};

			pcie0_mctp: mctp@10510000 {
				compatible = "starfive,jhb100-mctp";
				reg = <0x0 0x10510000 0x0 0x1000>;
				interrupts-extended = <&plic 299>, <&plic 300>, <&plic 301>,
					<&plic 302>, <&plic 303>, <&plic 304>, <&plic 305>,
					<&plic 306>, <&intc 53>, <&intc 54>;
				interrupt-names = "tx_cmpl", "rx_cmpl", "rx_rdy", "tx_vdm_full",
					"rx_vdm_full", "rx_cmd_full", "tx_err", "rx_err",
					"pcie_deassert", "pcie_assert";
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MCTP0_EP>,
					<&host0crg JHB100_HOST0CLK_PCIE0_MCTP_ACLK_M>,
					<&host0crg JHB100_HOST0CLK_PCIE0_MCTP_ACLK_S>,
					<&host0crg JHB100_HOST0CLK_PCIE0_MCTP_PCLK>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_MCTP0_EP>;
				starfive,pcie-ecsr = <&pcie_ep0_ecsr>;
				starfive,rx-cmd-full-th = <60>;
				starfive,rx-cmd-empty-th = <0>;
				starfive,rx-ring-count = <64>;
				starfive,tx-cmd-full-th = <15>;
				starfive,tx-cmd-empty-th = <0>;
				starfive,tx-ring-count = <64>;
				status = "disabled";
			};

			pcie_ep0_ecsr: syscon@10511000 {
				compatible = "starfive,jhb100-pcie-ecsr-syscon", "syscon";
				reg = <0x0 0x10511000 0x0 0x1000>;
			};

			pcie0_mmbi: mmbi@10512000 {
				compatible = "starfive,jhb100-mmbi-pcie";
				reg = <0x0 0x10512000 0x0 0x800>;
				interrupts-extended = <&plic 289>, <&plic 290>, <&plic 291>, <&plic 292>,
						      <&plic 293>, <&plic 294>, <&plic 295>, <&plic 296>,
						      <&intc 53>;
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MMBI_PCIE0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_MMBI_PCIE0>;
				mmbi-id = <0>;
				status = "disabled";
			};

			pvt_cpu: pvt@10514000 {
				compatible = "moortec,mr75203";
				reg = <0x0 0x10514000 0x0 0x80>,
				      <0x0 0x10514080 0x0 0x80>,
				      <0x0 0x10514100 0x0 0x80>,
				      <0x0 0x10514400 0x0 0x800>;
				reg-names = "common", "ts", "pd", "vm";
				intel,vm-map = [00 ff];
				clocks = <&cpucrg JHB100_CPUCLK_MAIN_ICG_EN_CPUSS_SENSORS>;
				resets = <&cpucrg JHB100_CPURST_MAIN_RSTN_CPUSS_SENSORS>;
				moortec,vm-active-channels = <16>;
				moortec,vm-pre-scaler-x2 = <1 1 1 1 2 1 1 1 1 1 1 1 3 1 1 1>;
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			espi0_mmbi: mmbi@10580000 {
				compatible = "starfive,jhb100-mmbi-espi";
				reg = <0x0 0x10580000 0x0 0x800>;
				interrupts-extended = <&plic 272>, <&plic 273>, <&plic 274>, <&plic 275>,
						      <&plic 276>, <&plic 277>, <&plic 278>, <&plic 279>,
						      <&intc 57>;
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MMBI_ESPI0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_MMBI_ESPI0>;
				mmbi-id = <0>;
				status = "disabled";
			};

			sio0: superio@10582000 {
				compatible = "starfive,jhb100-sio", "simple-mfd", "syscon";
				reg = <0x0 0x10582000 0x0 0x1000>;
				#address-cells = <2>;
				#size-cells = <2>;
				starfive,sio-id = <0>;
				status = "disabled";
				ranges = <0x0 0x0 0x0 0x10582000 0x0 0x1000>;

				sio0_bt0: bt@0 {
					compatible = "starfive,jhb100-bt-bmc";
					reg = <0x0 0x0 0x0 0x100>;
					interrupts-extended = <&plic 280>, <&intc 57>;
					interrupt-names = "bt", "espi_rst";
					status = "disabled";
				};

				sio0_bt1: bt@100 {
					compatible = "starfive,jhb100-bt-bmc";
					reg = <0x0 0x100 0x0 0x100>;
					interrupts-extended = <&plic 281>, <&intc 57>;
					interrupt-names = "bt", "espi_rst";
					status = "disabled";
				};

				sio0_kcs0: kcs@200 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x200 0x0 0x100>;
					interrupts-extended = <&plic 282>, <&intc 57>;
					interrupt-names = "kcs", "espi_rst";
					status = "disabled";
				};

				sio0_kcs1: kcs@300 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x300 0x0 0x100>;
					interrupts-extended = <&plic 283>, <&intc 57>;
					interrupt-names = "kcs", "espi_rst";
					status = "disabled";
				};

				sio0_kcs2: kcs@400 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x400 0x0 0x100>;
					interrupts-extended = <&plic 284>, <&intc 57>;
					interrupt-names = "kcs", "espi_rst";
					status = "disabled";
				};

				sio0_kcs3: kcs@500 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x500 0x0 0x100>;
					interrupts-extended = <&plic 285>, <&intc 57>;
					interrupt-names = "kcs", "espi_rst";
					status = "disabled";
				};

				sio0_mbox: mbox@600 {
					compatible = "starfive,jhb100-sio-mbox";
					reg = <0x0 0x600 0x0 0x100>;
					interrupts-extended = <&plic 286>, <&intc 57>;
					interrupt-names = "mbox", "espi_rst";
					status = "disabled";
				};

				sio0_pcc: pcc@800 {
					compatible = "starfive,jhb100-sio-pcc";
					reg = <0x0 0x800 0x0 0x100>;
					interrupts-extended = <&plic 287>, <&intc 57>;
					interrupt-names = "pcc", "espi_rst";
					status = "disabled";
				};

				sio0_wdi: wdi@900 {
					compatible = "starfive,jhb100-sio-wdi";
					reg = <0x0 0x900 0x0 0x100>;
					interrupts-extended = <&plic 288>, <&intc 57>;
					interrupt-names = "wdi", "espi_rst";
					status = "disabled";
				};
			};

			espi0: espi-slave@10584000 {
				compatible = "starfive,jhb100-espi-slave";
				reg = <0x0 0x10584000 0x0 0x2000>;
				starfive,espi-id = <0>;
				espi-dma-mode = <0x01>;
				starfive,vw-hw-enable;
				espi-wait-state = <4>;
				perif-memcyc-enable;
				flash-safs-mode = <1>;
				interrupts = <297>, <298>;
				interrupt-names = "espi", "safs";
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_ESPI0_EDAF>,
					 <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_SUPERIO0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_ESPI0_SLAVE_POK>,
					 <&host0crg JHB100_HOST0RST_MAIN_RSTN_SUPERIO0_ESPI>;
				reset-names = "espi", "sio";
				starfive,syscon = <&sys_syscon 52>;

				status = "disabled";
			};

			sol0: sol@105c0800 {
				compatible = "starfive,jhb100-sol";
				reg = <0x0 0x105c0800 0x0 0x400>;
				interrupt-parent = <&intc>;
				interrupts = <6>;
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_SOL0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_SOL0>;
				status = "disabled";
			};

			sol1: sol@105c0c00 {
				compatible = "starfive,jhb100-sol";
				reg = <0x0 0x105c0c00 0x0 0x400>;
