				compatible = "starfive,jhb100-axi-dma-uart";
				reg = <0x0 0x11924000 0x0 0x4000>;
				clocks = <&per0crg JHB100_PER0CLK_CORE_DMAC0>,
					<&per0crg JHB100_PER0CLK_MAIN_ICG_EN_DMAC_UART>;
				clock-names = "core-clk",  "cfgr-clk";
