/dts-v1/;
#include "jhb100-crg.dtsi"
#include "jhb100-pinfunc.h"

/ {
	compatible = "starfive,jhb100";
	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c0>;
			reg = <0x0>;
			tlb-split;

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu1: cpu@1 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c1>;
			reg = <0x1>;
			tlb-split;

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu2: cpu@2 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c2>;
			reg = <0x2>;
			tlb-split;

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu3: cpu@3 {
			compatible = "starfive,dubhe-70", "riscv";
			riscv,isa = "rv64imafdcbh";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "zba", "zbb",
					       "zbc", "zbs", "zicbom", "zicbop", "zicboz", "zicntr",
					       "zicond", "zicsr", "zifencei", "zihintpause",
					       "zihpm", "svinval", "svnapot", "sscofpmf";
			riscv,cbom-block-size = <64>;
			riscv,cboz-block-size = <64>;
			d-cache-block-size = <64>;
			d-cache-sets = <512>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <16>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <512>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <24>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&l2c3>;
			reg = <0x3>;
			tlb-split;

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu1>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu2>;
				};
			};

			cluster3 {
				core0 {
					cpu = <&cpu3>;
				};
			};
		};

		l2c0: cache-controller-0 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l2c1: cache-controller-1 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l2c2: cache-controller-2 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l2c3: cache-controller-3 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <2048>;
			cache-size = <0x20000>;
			cache-unified;
			next-level-cache = <&l3_cache>;
		};

		l3_cache: cache-controller-4 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <3>;
			cache-sets = <1024>;
			cache-size = <0x20000>;
			cache-unified;
		};
	};

	pmu {
		compatible = "riscv,pmu";
		interrupts-extended = <&cpu0_intc 13>, <&cpu1_intc 13>,
				      <&cpu2_intc 13>, <&cpu3_intc 13>;

		riscv,event-to-mhpmevent = <0x00005 0x0000 0xA>,
					   <0x00006 0x0000 0xB>,
					   <0x00008 0x0000 0x10>,
					   <0x00009 0x0000 0xF>,
					   <0x10000 0x0000 0x19>,
					   <0x10001 0x0000 0x1A>,
					   <0x10002 0x0000 0x1B>,
					   <0x10003 0x0000 0x1C>,
					   <0x10008 0x0000 0x8>,
					   <0x10009 0x0000 0x9>,
					   <0x1000C 0x0000 0x9E>,
					   <0x1000D 0x0000 0x9F>,
					   <0x10010 0x0000 0x1D>,
					   <0x10011 0x0000 0x1E>,
					   <0x10012 0x0000 0x1F>,
					   <0x10013 0x0000 0x20>,
					   <0x10014 0x0000 0x21>,
					   <0x10018 0x0000 0x17>,
					   <0x10019 0x0000 0x18>,
					   <0x10020 0x0000 0x8>,
					   <0x10021 0x0000 0x7>;

		riscv,event-to-mhpmcounters = <0x00005 0x00006 0x00007FF8>,
					      <0x00008 0x00009 0x00007FF8>,
					      <0x10000 0x10003 0x00007FF8>,
					      <0x10008 0x10009 0x00007FF8>,
					      <0x1000C 0x1000D 0x00007FF8>,
					      <0x10010 0x10014 0x00007FF8>,
					      <0x10018 0x10019 0x00007FF8>,
					      <0x10020 0x10021 0x00007FF8>;

		riscv,raw-event-to-mhpmcounters =
			<0x00 0x00 0xFFFFFFFF 0xFFFFFFE0 0x00007FF8>,	/* Event ID 1-31 */
			<0x00 0x20 0xFFFFFFFF 0xFFFFFFFE 0x00007FF8>,	/* Event ID 32-33 */
			<0x00 0x22 0xFFFFFFFF 0xFFFFFF22 0x00007FF8>;	/* Event ID 34 */
	};

	dubhe_edac: dubhe-edac {
		compatible = "starfive,dubhe-core-edac";
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <&plic>;
		#address-cells = <2>;
		#size-cells = <2>;
		dma-ranges;
		ranges;

		clint: clint@2000000 {
			compatible = "starfive,jhb100-clint", "sifive,clint0";
			reg = <0x0 0x02000000 0x0 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>,
					      <&cpu1_intc 3>, <&cpu1_intc 7>,
					      <&cpu2_intc 3>, <&cpu2_intc 7>,
					      <&cpu3_intc 3>, <&cpu3_intc 7>;
		};

		plic: interrupt-controller@c000000 {
			#interrupt-cells = <1>;
			compatible = "starfive,jhb100-plic", "sifive,plic-1.0.0";
			reg = <0x0 0x0c000000 0x0 0x4000000>;
			riscv,ndev = <400>;
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>,
					      <&cpu1_intc 11>, <&cpu1_intc 9>,
					      <&cpu2_intc 11>, <&cpu2_intc 9>,
					      <&cpu3_intc 11>, <&cpu3_intc 9>;
		};

		bus_nioc: bus_nioc {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-noncoherent;
			dma-ranges = <0x4 0x00000000 0x0 0x40000000 0x2 0x0>,
				     <0x4 0x00000000 0x4 0x00000000 0x2 0x0>;
			ranges;

			pcie_ep0: pcie-ep@10000000 {
				compatible = "starfive,jhb100-pcie-ep";
				reg = <0x0 0x10000000 0x0 0x100000>,
				<0x0 0x10100000 0x0 0x100000>;
				reg-names = "dbi", "dbi2";
				interrupts = <264>, <265>, <266>, <267>;
				interrupt-names = "pm_link", "flr", "err", "edma_local";
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_PCIE0_EP>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_DW_PCIE0_EP>;
				reset-names = "dbi_intf";
				max-link-speed = <4>;
				num-lanes = <1>;
				ecsr-syscon = <&pcie_ep0_ecsr>;

				status = "disabled";
			};

			pcie0_mctp: mctp@10510000 {
				compatible = "starfive,jhb100-mctp";
				reg = <0x0 0x10510000 0x0 0x1000>;
				/*interrupts = <309>, <&sysgpio 28 GPIO_ACTIVE_LOW>;*/
				/*interrupt-names = "mctp", "pcie"*/
				/*clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MCTP0>;*/
				resets = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MCTP0_EP>;
				starfive,pcie-ecsr = <&pcie_ep0_ecsr>;
				starfive,rx-packet-count = <64>;
				starfive,rx-ring-count = <64>;
				starfive,tx-ring-count = <64>;
				status = "disabled";
			};

			pcie_ep0_ecsr: syscon@10511000 {
				compatible = "starfive,jhb100-pcie-ecsr-syscon", "syscon";
				reg = <0x0 0x10511000 0x0 0x1000>;
			};

			pcie0_mmbi: mmbi@10512000 {
				compatible = "starfive,jhb100-mmbi";
				reg = <0x0 0x10512000 0x0 0x400>;
				interrupts = <289>, <290>, <291>, <292>,
					     <293>, <294>, <295>, <296>, <354>;
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MMBI_PCIE0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_MMBI_PCIE0>;
				status = "disabled";
			};

			pvt_cpu: pvt@10514000 {
				compatible = "moortec,mr75203";
				reg = <0x0 0x10514000 0x0 0x80>,
				      <0x0 0x10514080 0x0 0x80>,
				      <0x0 0x10514100 0x0 0x80>,
				      <0x0 0x10514400 0x0 0x800>;
				reg-names = "common", "ts", "pd", "vm";
				intel,vm-map = [00 ff];
				clocks = <&cpucrg JHB100_CPUCLK_MAIN_ICG_EN_CPUSS_SENSORS0>;
				resets = <&cpucrg JHB100_CPURST_MAIN_RSTN_SENSORS0>;
				moortec,vm-active-channels = <16>;
				moortec,vm-pre-scaler-x2 = <1 1 1 1 2 1 1 1 1 1 1 1 3 1 1 1>;
				moortec,ts-coeff-g = <61400>;
				moortec,ts-coeff-h = <253700>;
				#thermal-sensor-cells = <1>;
				status = "disabled";
			};

			espi0_mmbi: mmbi@10580000 {
				compatible = "starfive,jhb100-mmbi";
				reg = <0x0 0x10580000 0x0 0x400>;
				interrupts = <272>, <273>, <274>, <275>,
					     <276>, <277>, <278>, <279>, <352>;
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_MMBI_ESPI0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_MMBI_ESPI0>;
				status = "disabled";
			};

			sio0: superio@10582000 {
				compatible = "starfive,jhb100-sio", "simple-mfd", "syscon";
				reg = <0x0 0x10582000 0x0 0x1000>;
				#address-cells = <2>;
				#size-cells = <2>;
				status = "disabled";
				ranges = <0x0 0x0 0x0 0x10582000 0x0 0x1000>;

				sio0_bt0: bt@0 {
					compatible = "starfive,jhb100-bt-bmc";
					reg = <0x0 0x0 0x0 0x100>;
					interrupts = <280>;
					status = "disabled";
				};

				sio0_bt1: bt@100 {
					compatible = "starfive,jhb100-bt-bmc";
					reg = <0x0 0x100 0x0 0x100>;
					interrupts = <281>;
					status = "disabled";
				};

				sio0_kcs0: kcs@200 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x200 0x0 0x100>;
					interrupts = <282>;
					status = "disabled";
				};

				sio0_kcs1: kcs@300 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x300 0x0 0x100>;
					interrupts = <283>;
					status = "disabled";
				};

				sio0_kcs2: kcs@400 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x400 0x0 0x100>;
					interrupts = <284>;
					status = "disabled";
				};

				sio0_kcs3: kcs@500 {
					compatible = "starfive,jhb100-kcs-bmc";
					reg = <0x0 0x500 0x0 0x100>;
					interrupts = <285>;
					status = "disabled";
				};

				sio0_mbox: mbox@600 {
					compatible = "starfive,jhb100-sio-mbox";
					reg = <0x0 0x600 0x0 0x100>;
					interrupts = <286>;
					status = "disabled";
				};

				sio0_pcc: pcc@800 {
					compatible = "starfive,jhb100-sio-pcc";
					reg = <0x0 0x800 0x0 0x100>;
					interrupts = <287>;
					status = "disabled";
				};

				sio0_wdi: wdi@900 {
					compatible = "starfive,jhb100-sio-wdi";
					reg = <0x0 0x900 0x0 0x100>;
					interrupts = <288>;
					status = "disabled";
				};
			};

			espi0: espi-slave@10584000 {
				compatible = "starfive,jhb100-espi-slave";
				reg = <0x0 0x10584000 0x0 0x2000>;
				espi-dma-mode = <0xff>;
				espi-wait-state = <15>;
				perif-memcyc-enable;
				flash-safs-mode = <1>;
				interrupts = <297>, <298>;
				clocks = <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_ESPI0_EDAF>,
					 <&host0crg JHB100_HOST0CLK_MAIN_ICG_EN_SUPERIO0>;
				resets = <&host0crg JHB100_HOST0RST_MAIN_RSTN_ESPI0_SLAVE_POK>,
					 <&host0crg JHB100_HOST0RST_MAIN_RSTN_SUPERIO0_ESPI>;
				reset-names = "espi", "sio";
				status = "disabled";
			};

			husb0d0: usb@10600000 {
				compatible = "starfive,jhb100-dwc3-device";
				#address-cells = <2>;
				#size-cells = <2>;
				clocks = <&husb0crg JHB100_HUSB0CLK_PORT0_UTMI_CLK>;
				clock-name = "utmi";
				resets = <&husbd0crg JHB100_HUSBD0RST_MAIN_RSTN_DEVICE0>;
				ranges;
				status = "disabled";

				husb0dcore0: usb@10600000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x10600000 0x0 0x10000>;
					interrupts = <243>;
					clocks = <&husbd0crg JHB100_HUSBD0CLK_USB2_DEV0_BUSCLK>;
					clock-name = "bus_early";
					dr_mode = "peripheral";
				};
			};

			husb0d1: usb@10610000 {
				compatible = "starfive,jhb100-dwc3-device";
				#address-cells = <2>;
				#size-cells = <2>;
				clocks = <&husb0crg JHB100_HUSB0CLK_PORT1_UTMI_CLK>;
				clock-name = "utmi";
				resets = <&husbd0crg JHB100_HUSBD0RST_MAIN_RSTN_DEVICE1>;
				ranges;
				status = "disabled";

				husb0dcore1: usb@10610000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x10610000 0x0 0x10000>;
					clocks = <&husbd0crg JHB100_HUSBD0CLK_USB2_DEV1_BUSCLK>;
					clock-name = "bus_early";
					interrupts = <244>;
					dr_mode = "peripheral";
				};
			};

			husb0d2: usb@10620000 {
				compatible = "starfive,jhb100-dwc3-device";
				#address-cells = <2>;
				#size-cells = <2>;
				clocks = <&husb0crg JHB100_HUSB0CLK_PORT2_UTMI_CLK>,
					<&husb0crg JHB100_HUSB1CLK_PORT2_PIPE3_PCLK>;
				clock-name = "utmi", "pipe";
				resets = <&husbd0crg JHB100_HUSBD0RST_MAIN_RSTN_DEVICE2>;
				ranges;
				status = "disabled";

				husb0dcore2: usb@10620000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x10620000 0x0 0x10000>;
					clocks = <&husbd0crg JHB100_HUSBD0CLK_USB3_DEV0_BUSCLK>,
						<&husbd0crg JHB100_HUSBD0CLK_USB3_DEV0_SUSPENDCLK>;
					clock-name = "bus_early", "suspend";
					interrupts = <245>;
					dr_mode = "peripheral";
				};
			};

			husb0d3: usb@10630000 {
				compatible = "starfive,jhb100-dwc3-device";
				#address-cells = <2>;
				#size-cells = <2>;
				clocks = <&husb0crg JHB100_HUSB1CLK_PORT3_UTMI_CLK>,
					<&husb0crg JHB100_HUSB1CLK_PORT3_PIPE3_PCLK>;
				clock-name = "utmi", "pipe";
				resets = <&husbd0crg JHB100_HUSBD0RST_MAIN_RSTN_DEVICE3>;
				ranges;
				status = "disabled";

				husb0dcore3: usb@10630000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x10630000 0x0 0x10000>;
					clocks = <&husbd0crg JHB100_HUSBD0CLK_USB3_DEV1_BUSCLK>,
						<&husbd0crg JHB100_HUSBD0CLK_USB3_DEV1_SUSPENDCLK>;
					clock-name = "bus_early", "suspend";
					interrupts = <246>;
					dr_mode = "peripheral";
				};
			};

			husb0d4: usb@10640000 {
				compatible = "starfive,jhb100-dwc3-device";
				#address-cells = <2>;
				#size-cells = <2>;
				clocks = <&husb0crg JHB100_HUSB1CLK_PORT4_UTMI_CLK>,
					<&husb0crg JHB100_HUSB1CLK_PORT4_PIPE3_PCLK>;
				clock-name = "utmi", "pipe";
				resets = <&husbd0crg JHB100_HUSBD0RST_MAIN_RSTN_DEVICE4>;
				ranges;
				status = "disabled";

				husb0dcore4: usb@10640000 {
					compatible = "snps,dwc3";
					reg = <0x0 0x10640000 0x0 0x10000>;
					clocks = <&husbd0crg JHB100_HUSBD0CLK_USB3_DEV2_BUSCLK>,
						<&husbd0crg JHB100_HUSBD0CLK_USB3_DEV2_SUSPENDCLK>;
					clock-name = "bus_early", "suspend";
					interrupts = <247>;
					dr_mode = "peripheral";
				};
			};

