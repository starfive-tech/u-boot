config STARFIVE_JHB100
	bool
	select SUPPORT_SPL
	select RAM
	select SPL_RAM if SPL
	select SYS_CACHE_SHIFT_6
	imply CPU
	imply CPU_RISCV
	imply RISCV_TIMER if (RISCV_SMODE || SPL_RISCV_SMODE)
	imply SPL_RISCV_ACLINT
	imply CMD_CPU
	imply SPL_CPU
	imply SPL_OPENSBI
	imply SPL_LOAD_FIT
	imply SMP
	imply DM_SERIAL
	imply ZYNQ_SERIAL
	imply MII
	imply MMC
	imply MMC_SPI
	imply MMC_BROKEN_CD
	imply CMD_MMC
	imply DM_GPIO
	imply STARFIVE_GPIO
	imply CMD_GPIO
	imply MISC
	imply STARFIVE_OTP
	imply DM_PWM
	imply PWM_SIFIVE
	imply DM_I2C
	imply SYS_I2C_OCORES

if ENV_IS_IN_SPI_FLASH

config ENV_OFFSET
	default 0x505000

config ENV_SIZE
	default 0x20000

config ENV_SECT_SIZE
	default 0x10000

endif # ENV_IS_IN_SPI_FLASH

config STARFIVE_JHB100_FIT_VERIFICATION
	bool "Enable FIT verification with Starfive JHB100"
	depends on TARGET_STARFIVE_JHB100
	select FIT_IMAGE_POST_PROCESS
	select SPL_FIT_IMAGE_POST_PROCESS
	help
	  All images loaded from FIT will be verified

config STARFIVE_SECURE_SERVICES_TOOL
	bool "StarFive Secure Services Tool"
	depends on TARGET_STARFIVE_JHB100
	select SPL_DRIVERS_MISC
	select SPL_DM_MAILBOX
	select SPL_DM_RPMI_SRV_GRP
	select RPMI_SHMEM_MBOX
	select RPMI_STARFIVE_SEC_SERVICE_RUNTIME_GRP
	select CMD_STARFIVE_SEC
	select SPL_CMD_STARFIVE_SEC
	select CMD_STARFIVE
	select STARFIVE_JHB100_MPXY_SEC
	help
	  This is a configuration to enable StarFive Secure Service Tools

config SPL_FS_LOAD_RECOVERY_PAYLOAD_NAME
	string "MMC recovery image for u-boot.itb"
	depends on TARGET_STARFIVE_JHB100
	default "u-boot-recovery.itb"
	help
	  This is a customised string configuration for StarFive JHB100

config STARFIVE_JHB100_MPXY_SEC
	bool "StarFive JHB100 MPXY Sec IOCTL driver"
	depends on TARGET_STARFIVE_JHB100 && RISCV_SMODE
	select MISC
    select SBI_MPXY
	help
	  Enable support for MPXY Secure Runtime Services to communicate with
	  L1 Firmware of the SoC. This driver allows one to request for secure
	  services required to perform authentications and firmware updates.

config JHB100_ENABLE_LOAD_TEMP_IMG_FOR_EMMC
	bool "Load EMMC Temp image from GPP partition"
	depends on TARGET_STARFIVE_JHB100
	help
	 Enable loading of Temp image from GPP

config JHB100_UPD_RCV_TEST_TRACE
	bool "Starfive JHB100 Update and Recovery Test Trace"
	depends on TARGET_STARFIVE_JHB100
	help
	 Enable update and recovery test trace

config RANDOMIZED_TEST_PATTERN
	bool "Update and Recovery Test Pattern Randomizer"
	depends on TARGET_STARFIVE_JHB100
	help
	 Enable update and recovery test pattern randomizer

config STARFIVE_JHB100_WDT_ADV_CFG
	bool "Advanced configuration of Starfive JHB100 WDT operation mode"
	depends on TARGET_STARFIVE_JHB100
	help
	 Enable configuration such as operating in two stage timeout or pulse mode

config STARFIVE_JHB100_QUERY_DDR_INFO
	bool "Query DDR info (size) from SCP and update device tree"
	depends on TARGET_STARFIVE_JHB100
	help
	 Enable runtime modification of U-boot and Linux device tree memory node

choice
	prompt "StarFive JHB100 SFC partition mechanism"
	depends on TARGET_STARFIVE_JHB100

config STARFIVE_JHB100_SFC_NONE
	bool "None selected (build error)"
	help
	 Placeholder so an unset choice does not silently fall back to
	 AGT or AB. Selecting this (or leaving a defconfig without an
	 explicit choice) fails the build with a clear error instead.

config STARFIVE_JHB100_SFC_AGT
	bool "AGT (active/golden/temp) partition layout"
	help
	 StarFive JHB100 SFC boot flow using AGT partitions.

config STARFIVE_JHB100_SFC_AB
	bool "AB (active/backup) partition layout"
	help
	 StarFive JHB100 SFC boot flow using AB partitions.

endchoice
