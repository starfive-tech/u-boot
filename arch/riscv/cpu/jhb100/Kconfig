config STARFIVE_JHB100
	bool
	select SUPPORT_SPL
	select RAM
	select SPL_RAM if SPL
	select SYS_CACHE_SHIFT_6
	imply CPU
	imply CPU_RISCV
	imply RISCV_TIMER if (RISCV_SMODE || SPL_RISCV_SMODE)
	imply SPL_RISCV_ACLINT
	imply CMD_CPU
	imply SPL_CPU
	imply SPL_OPENSBI
	imply SPL_LOAD_FIT
	imply SMP
	imply DM_SERIAL
	imply ZYNQ_SERIAL
	imply MII
	imply MMC
	imply MMC_SPI
	imply MMC_BROKEN_CD
	imply CMD_MMC
	imply DM_GPIO
	imply STARFIVE_GPIO
	imply CMD_GPIO
	imply MISC
	imply STARFIVE_OTP
	imply DM_PWM
	imply PWM_SIFIVE
	imply DM_I2C
	imply SYS_I2C_OCORES

if ENV_IS_IN_SPI_FLASH

config ENV_OFFSET
	default 0x505000

config ENV_SIZE
	default 0x20000

config ENV_SECT_SIZE
	default 0x10000

endif # ENV_IS_IN_SPI_FLASH

config STARFIVE_JHB100_FIT_VERIFICATION
	bool "Enable FIT verification with Starfive JHB100"
	depends on TARGET_STARFIVE_JHB100
	select FIT_IMAGE_POST_PROCESS
	select SPL_FIT_IMAGE_POST_PROCESS
	help
	  All images loaded from FIT will be verified

config STARFIVE_SECURE_SERVICES_TOOL
	bool "StarFive Secure Services Tool"
	depends on TARGET_STARFIVE_JHB100
	select SPL_DRIVERS_MISC
	select SPL_DM_MAILBOX
	select SPL_DM_RPMI_SRV_GRP
	select RPMI_SHMEM_MBOX
	select RPMI_STARFIVE_SEC_SERVICE_RUNTIME_GRP
	select CMD_STARFIVE_SEC
	select SPL_CMD_STARFIVE_SEC
	select CMD_STARFIVE
	select STARFIVE_JHB100_MPXY_SEC
	help
	  This is a configuration to enable StarFive Secure Service Tools

config STARFIVE_JHB100_SECURE_VAB_AUTH
	bool "Enable boot image authentication with Starfive JHB100 VAB"
	depends on TARGET_STARFIVE_JHB100
	select FIT_IMAGE_POST_PROCESS
	select SPL_FIT_IMAGE_POST_PROCESS
	select CRC32
	select STARFIVE_SECURE_SERVICES_TOOL
	help
	 All images loaded from FIT will be authenticated by Starfive JHB100 VAB

config SPL_FS_LOAD_RECOVERY_PAYLOAD_NAME
	string "MMC recovery image for u-boot.itb"
	depends on TARGET_STARFIVE_JHB100
	default "u-boot-recovery.itb"
	help
	  This is a customised string configuration for StarFive JHB100

config STARFIVE_JHB100_MPXY_SEC
	bool "StarFive JHB100 MPXY Sec IOCTL driver"
	depends on TARGET_STARFIVE_JHB100 && RISCV_SMODE
	select MISC
    select SBI_MPXY
	help
	  Enable support for MPXY Secure Runtime Services to communicate with
	  L1 Firmware of the SoC. This driver allows one to request for secure
	  services required to perform authentications and firmware updates.
