if TARGET_STARFIVE_JHB100

config SYS_CPU
	default "jhb100"

config SYS_BOARD
	default "jhb100"

config SYS_VENDOR
	default "starfive"

config SYS_SOC
	default "jhb100"

config SYS_CONFIG_NAME
	default "starfive-jhb100"

config ENV_SIZE
	default 0x2000 if ENV_IS_IN_SPI_FLASH

config ENV_OFFSET
	default 0x140000 if ENV_IS_IN_SPI_FLASH

config TEXT_BASE
	default 0x40200000 if SPL
	default 0x40100000 if !RISCV_SMODE
	default 0x40200000 if RISCV_SMODE

config SPL_TEXT_BASE
	default 0x40000000

config SPL_OPENSBI_LOAD_ADDR
	default 0x40100000

config BOARD_SPECIFIC_OPTIONS # dummy
	def_bool y
	select STARFIVE_JHB100
#	select ENV_IS_IN_SPI_FLASH
	select BINMAN
	imply CMD_DHCP
	imply CMD_EXT2
	imply CMD_EXT4
	imply CMD_FAT
	imply CMD_FS_GENERIC
	imply CMD_GPT
	imply PARTITION_TYPE_GUID
	imply CMD_NET
	imply CMD_PING
#	imply CMD_SF
	imply DOS_PARTITION
	imply EFI_PARTITION
	imply IP_DYN
	imply ISO_PARTITION
	imply PHY_LIB
	imply PHY_MSCC
#	imply SPI_FLASH
#	imply SPI_FLASH_ISSI
	imply SYSRESET
	imply SYSRESET_GPIO

config STARFIVE_JHB100_ENV_CS_DYNAMIC
	bool "Dynamically detect the SPI flash chip-select for the environment"
	depends on ENV_IS_IN_SPI_FLASH
	default n
	help
	  On dual-flash (CS0/CS1) boards the active u-boot-proper image, and
	  therefore the environment, can live on either chip select. Enable
	  this to query the active chip select at runtime via
	  starfive_get_sfc_cs() instead of always using the compiled-in
	  CONFIG_ENV_SPI_CS.

config STARFIVE_JHB100_FDTMODIFY_DEFAULT
	bool "Enable device tree fixups by default (fdtmodify=yes)"
	depends on TARGET_STARFIVE_JHB100
	default n
	help
	 Set the compiled-in default of the "fdtmodify" environment variable
	 to "yes" instead of "no", so the SFC device tree fixups run in
	 ft_board_setup() without the user having to set the variable first.
	 The variable can still be flipped at runtime with
	 "setenv fdtmodify yes|no".

config STARFIVE_JHB100_SAFE_MTEST
	bool "Run safe memtest from board_late_init()"
	depends on CMD_MEMTEST
	default n
	help
	  Run a board-local memory test during board_late_init(). The test
	  dynamically computes testable ranges from the LMB memory map and
	  skips all reserved regions before writing test patterns.

endif
